@page "/vehicles"
@rendermode InteractiveServer
@implements IDisposable

@using MyWebApp.Models.Enums
@using MyWebApp.Helpers
@using MyWebApp.Components.Dialogs

@inject VehicleService vehicleService
@inject DialogService dialog
@inject AuthService authService
@inject IJSRuntime js

<PageTitle>Quản lý phương tiện</PageTitle>

@if (!authService.CanManageVehicles)
{
    <div class="alert alert-warning">
        Trang này dành cho cán bộ quản lý đội xe và quản trị viên.
    </div>
}
else
{
    <div class="page-header-box">
        <div>
            <h1 class="page-header-title">
                <RadzenIcon Icon="directions_car" Style="color: var(--brand-navy);" />
                Quản lý danh mục phương tiện
            </h1>
            <p class="page-header-desc">Hồ sơ kỹ thuật, thông số đăng ký và trạng thái sẵn sàng của phương tiện</p>
        </div>
        <div>
            <button class="btn btn-primary-action" @onclick="Add">
                <RadzenIcon Icon="add" Class="me-1 align-middle" />
                Thêm phương tiện
            </button>
        </div>
    </div>

    @if (message != "")
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success") alert-dismissible fade show shadow-sm">
            <RadzenIcon Icon="@(isError ? "error" : "check_circle")" Class="me-2" />
            @message
            <button type="button" class="btn-close" @onclick="() => message = string.Empty"></button>
        </div>
    }

    <div class="card">
        <div class="card-body">
            <h2 class="h5">Danh sách phương tiện</h2>

            <div class="row mb-3">
                <div class="col-md-4 mb-2">
                    <RadzenLabel Text="Tìm kiếm theo biển số, nhãn hiệu, model" />
                    <RadzenTextBox @bind-Value="searchText" Style="width:100%" placeholder="Nhập từ khóa tìm kiếm..." />
                </div>

                <div class="col-md-4 mb-2">
                    <label class="form-label">Loại xe</label>
                    <select class="form-select" @bind="typeFilter">
                        <option value="-1">Tất cả loại xe</option>
                        <option value="@((int)VehicleType.OTo)">Ô tô</option>
                        <option value="@((int)VehicleType.XeMay)">Xe máy</option>
                        <option value="@((int)VehicleType.XeTai)">Xe tải</option>
                        <option value="@((int)VehicleType.XeChuyenDung)">Xe chuyên dụng</option>
                    </select>
                </div>

                <div class="col-md-4 mb-2">
                    <label class="form-label">Trạng thái</label>
                    <select class="form-select" @bind="statusFilter">
                        <option value="-1">Tất cả trạng thái</option>
                        <option value="@((int)VehicleStatus.SanSang)">Sẵn sàng</option>
                        <option value="@((int)VehicleStatus.DangDuocDieuDong)">Đang được điều động</option>
                        <option value="@((int)VehicleStatus.DangBaoDuong)">Đang bảo dưỡng</option>
                        <option value="@((int)VehicleStatus.NgungHoatDong)">Ngừng hoạt động</option>
                    </select>
                </div>

                <div class="col-12 mt-2">
                    <button class="btn btn-secondary" @onclick="ResetFilters">
                        <RadzenIcon Icon="refresh" Class="me-1" />
                        Đặt lại bộ lọc
                    </button>
                </div>
            </div>

            <RadzenDataGrid Data="@FilteredVehicles"
                            TItem="Vehicle"
                            AllowPaging="true"
                            PageSize="8"
                            AllowSorting="true"
                            EmptyText="Không có phương tiện nào phù hợp.">
                <Columns>
                    <RadzenDataGridColumn Property="VehicleCode" Title="Mã xe" Width="100px" />
                    <RadzenDataGridColumn Property="LicensePlate" Title="Biển số" Width="130px" />
                    <RadzenDataGridColumn Property="Brand" Title="Nhãn hiệu / Model" Width="200px">
                        <Template Context="item">
                            @item.Brand @item.Model (@item.ManufactureYear)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="VehicleType" Title="Loại xe" Width="110px">
                        <Template Context="item">
                            @EnumHelper.TenVehicleType(item.VehicleType)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="Seats" Title="Số chỗ" Width="80px" />
                    <RadzenDataGridColumn Property="CurrentKm" Title="Số Km" Width="110px">
                        <Template Context="item">
                            @item.CurrentKm.ToString("N0") km
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="Status" Title="Trạng thái" Width="160px">
                        <Template Context="item">
                            <span class="badge @LayMauTrangThai(item.Status)">
                                @EnumHelper.TenVehicleStatus(item.Status)
                            </span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Title="Thao tác" Width="160px" Sortable="false">
                        <Template Context="item">
                            <div class="d-flex gap-1">
                                <RadzenButton Icon="visibility"
                                              ButtonStyle="ButtonStyle.Light"
                                              Size="ButtonSize.Small"
                                              Title="Xem chi tiết"
                                              Click="@(() => ViewDetails(item))" />

                                <RadzenButton Icon="edit"
                                              ButtonStyle="ButtonStyle.Info"
                                              Size="ButtonSize.Small"
                                              Title="Sửa thông tin"
                                              Click="@(() => Edit(item))" />

                                <RadzenButton Icon="delete"
                                              ButtonStyle="ButtonStyle.Danger"
                                              Size="ButtonSize.Small"
                                              Title="Xóa phương tiện"
                                              Click="@(() => Delete(item))" />
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </div>
    </div>
}

@code {
    private List<Vehicle> vehicles = new();

    private string searchText = "";
    private int typeFilter = -1;
    private int statusFilter = -1;

    private string message = "";
    private bool isError = false;

    private List<Vehicle> FilteredVehicles
    {
        get
        {
            var ketQua = vehicles.AsEnumerable();

            if (string.IsNullOrWhiteSpace(searchText) == false)
            {
                string tuKhoa = searchText.Trim().ToLower();
                ketQua = ketQua.Where(x =>
                    x.LicensePlate.ToLower().Contains(tuKhoa) ||
                    x.Brand.ToLower().Contains(tuKhoa) ||
                    x.Model.ToLower().Contains(tuKhoa) ||
                    x.VehicleCode.ToLower().Contains(tuKhoa));
            }

            if (typeFilter != -1)
            {
                ketQua = ketQua.Where(x => (int)x.VehicleType == typeFilter);
            }

            if (statusFilter != -1)
            {
                ketQua = ketQua.Where(x => (int)x.Status == statusFilter);
            }

            return ketQua.ToList();
        }
    }

    protected override void OnInitialized()
    {
        authService.UserChanged += UpdatePage;
        LoadData();
    }

    private void UpdatePage()
    {
        LoadData();
        _ = InvokeAsync(StateHasChanged);
    }

    private void LoadData()
    {
        vehicles = vehicleService.GetAll();
    }

    private async Task ViewDetails(Vehicle hv)
    {
        await dialog.OpenAsync<VehicleDetailDialog>(
            $"Hồ sơ phương tiện: {hv.LicensePlate} ({hv.Brand} {hv.Model})",
            new Dictionary<string, object?> { { "Vehicle", hv } },
            new DialogOptions { Width = "840px", CloseDialogOnOverlayClick = true, CloseDialogOnEsc = true });
    }

    private void ResetFilters()
    {
        searchText = "";
        typeFilter = -1;
        statusFilter = -1;
    }

    // --- POPUP THÊM PHƯƠNG TIỆN MỚI ---
    private async Task Add()
    {
        var newVehicle = new Vehicle
        {
            VehicleType = VehicleType.OTo,
            Status = VehicleStatus.SanSang,
            OperationalStatus = VehicleOperationalStatus.Ready,
            ReceiveDate = DateTime.Today,
            Seats = 5,
            ManufactureYear = DateTime.Today.Year,
            RegistrationExpiryDate = DateTime.Today.AddMonths(18),
            NextMaintenanceDate = DateTime.Today.AddMonths(6)
        };

        var res = await dialog.OpenAsync<VehicleEditDialog>(
            "Thêm phương tiện công tác mới",
            new Dictionary<string, object?> { { "Vehicle", newVehicle }, { "IsEditing", false } },
            new DialogOptions { Width = "900px", CloseDialogOnOverlayClick = true, CloseDialogOnEsc = true });

        if (res == true)
        {
            LoadData();
            message = "Đã thêm phương tiện mới thành công.";
            isError = false;
        }
    }

    // --- POPUP CẬP NHẬT PHƯƠNG TIỆN ---
    private async Task Edit(Vehicle hv)
    {
        var clone = new Vehicle
        {
            Id = hv.Id,
            VehicleCode = hv.VehicleCode,
            LicensePlate = hv.LicensePlate,
            VehicleType = hv.VehicleType,
            Brand = hv.Brand,
            Model = hv.Model,
            Seats = hv.Seats,
            ManufactureYear = hv.ManufactureYear,
            CurrentKm = hv.CurrentKm,
            Color = hv.Color,
            ChassisNumber = hv.ChassisNumber,
            EngineNumber = hv.EngineNumber,
            ReceiveDate = hv.ReceiveDate,
            OperationalStatus = hv.OperationalStatus,
            RegistrationExpiryDate = hv.RegistrationExpiryDate,
            NextMaintenanceDate = hv.NextMaintenanceDate,
            Note = hv.Note,
            CreatedAt = hv.CreatedAt,
            UpdatedAt = hv.UpdatedAt
        };

        var res = await dialog.OpenAsync<VehicleEditDialog>(
            $"Cập nhật phương tiện: {hv.LicensePlate} ({hv.Brand} {hv.Model})",
            new Dictionary<string, object?> { { "Vehicle", clone }, { "IsEditing", true } },
            new DialogOptions { Width = "900px", CloseDialogOnOverlayClick = true, CloseDialogOnEsc = true });

        if (res == true)
        {
            LoadData();
            message = $"Đã cập nhật phương tiện {hv.LicensePlate} thành công.";
            isError = false;
        }
    }

    private async Task Delete(Vehicle hv)
    {
        var xacNhan = await dialog.Confirm(
            $"Bạn có chắc muốn xóa phương tiện {hv.LicensePlate}?",
            "Xác nhận xóa");

        if (xacNhan != true)
        {
            return;
        }

        string loi;
        bool ketQua = vehicleService.Delete(hv.Id, out loi);

        if (ketQua == false)
        {
            message = loi;
            isError = true;
            return;
        }

        LoadData();
        message = "Đã xóa phương tiện thành công.";
        isError = false;
    }

    private string LayMauTrangThai(VehicleStatus status)
    {
        if (status == VehicleStatus.SanSang)
        {
            return "bg-success";
        }

        if (status == VehicleStatus.DangDuocDieuDong)
        {
            return "bg-primary";
        }

        if (status == VehicleStatus.DangBaoDuong)
        {
            return "bg-warning text-dark";
        }

        if (status == VehicleStatus.NgungHoatDong)
        {
            return "bg-danger";
        }

        return "bg-secondary";
    }

    public void Dispose()
    {
        authService.UserChanged -= UpdatePage;
    }
}
