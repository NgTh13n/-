@page "/dispatch"
@rendermode InteractiveServer
@implements IDisposable

@using MyWebApp.Models
@using MyWebApp.Models.Enums
@using MyWebApp.Helpers
@using MyWebApp.Data
@using MyWebApp.Components.Dialogs

@inject DispatchService dispatchService
@inject DialogService dialog
@inject AuthService authService
@inject MockDataService mockDataService
@inject IJSRuntime js

<PageTitle>Điều động phương tiện</PageTitle>

@if (!authService.CanDispatch)
{
    <div class="alert alert-warning shadow-sm">
        <RadzenIcon Icon="lock" Class="me-2" />
        Trang này dành riêng cho Cán bộ quản lý đội xe và Quản trị viên để phân công, điều phối phương tiện và lái xe.
    </div>
}
else
{
    <div class="page-header-box">
        <div>
            <h1 class="page-header-title">
                <RadzenIcon Icon="alt_route" Style="color: var(--brand-navy);" />
                Quản lý điều động phương tiện công tác
            </h1>
            <p class="page-header-desc">Tiếp nhận yêu cầu đã duyệt, kiểm tra điều kiện an toàn kỹ thuật và lập lệnh điều động</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(thongBao))
    {
        <div class="alert @(coLoi ? "alert-danger" : "alert-success") alert-dismissible fade show shadow-sm" role="alert">
            <RadzenIcon Icon="@(coLoi ? "error" : "check_circle")" Class="me-2" />
            @thongBao
            <button type="button" class="btn-close" @onclick="() => thongBao = string.Empty"></button>
        </div>
    }

    @* TABS ĐIỀU PHỐI: HÀNG CHỜ ĐIỀU ĐỘNG VS DANH SÁCH LỆNH *@
    <RadzenTabs @bind-SelectedIndex="tabHienTai" Class="shadow-sm">
        <Tabs>
            <RadzenTabsItem Text="@($"Yêu cầu chờ điều động ({danhSachChoDieuDong.Count})")" Icon="pending_actions">
                <RadzenDataGrid Data="@danhSachChoDieuDong" 
                                TItem="Booking" 
                                AllowPaging="true" 
                                PageSize="8" 
                                AllowSorting="true" 
                                EmptyText="Không có yêu cầu nào đang chờ điều động.">
                    <Columns>
                        <RadzenDataGridColumn Property="BookingCode" Title="Mã yêu cầu" Width="140px">
                            <Template Context="item">
                                <span class="fw-bold text-primary text-nowrap">@item.BookingCode</span>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Property="RequesterId" Title="Người đề nghị" Width="180px">
                            <Template Context="item">
                                <div><strong>@dispatchService.GetUser(item.RequesterId)?.FullName</strong></div>
                                <div class="text-muted small">@item.DepartmentSnapshot</div>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Property="Purpose" Title="Mục đích / Tuyến đến" Width="260px">
                            <Template Context="item">
                                <div class="fw-semibold">@item.Purpose</div>
                                <div class="text-muted small">Tới: @item.Destination</div>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Property="RequestedVehicleType" Title="Loại xe & Số người" Width="150px">
                            <Template Context="item">
                                <div>@item.RequestedVehicleType</div>
                                <div class="text-muted small">@item.PassengerCount người tham gia</div>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Property="PreferredDriverMode" Title="Phương án lái" Width="140px">
                            <Template Context="item">
                                @if (item.PreferredDriverMode == DriverMode.SelfDrive)
                                {
                                    <span class="badge bg-info text-dark">
                                        <RadzenIcon Icon="person" Class="me-1" /> Tự lái
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark border">
                                        <RadzenIcon Icon="drive_eta" Class="me-1" /> Lái xe ĐV
                                    </span>
                                }
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Property="DepartureTime" Title="Lịch trình" Width="160px">
                            <Template Context="item">
                                <div>@item.DepartureTime.ToString("dd/MM HH:mm")</div>
                                <div class="text-muted small">Đến @item.ReturnTime.ToString("dd/MM HH:mm")</div>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Title="Thao tác" Sortable="false" Filterable="false" Width="180px">
                            <Template Context="item">
                                <div class="d-flex gap-1">
                                    <RadzenButton Icon="visibility" 
                                                  ButtonStyle="ButtonStyle.Light" 
                                                  Size="ButtonSize.Small" 
                                                  Title="Xem chi tiết yêu cầu" 
                                                  Click="@(() => XemChiTietYeuCau(item))" />

                                    <RadzenButton Text="Xếp xe" 
                                                  Icon="directions_car" 
                                                  ButtonStyle="ButtonStyle.Primary" 
                                                  Size="ButtonSize.Small" 
                                                  Click="@(() => MoFormDieuDong(item))" />
                                </div>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </RadzenTabsItem>

            <RadzenTabsItem Text="@($"Lệnh điều động đã lập ({danhSachLenhDieuDong.Count})")" Icon="fact_check">
                <RadzenDataGrid Data="@danhSachLenhDieuDong" 
                                TItem="Trip" 
                                AllowPaging="true" 
                                PageSize="8" 
                                AllowSorting="true" 
                                EmptyText="Chưa có lệnh điều động nào được lập.">
                    <Columns>
                        <RadzenDataGridColumn Property="DispatchCode" Title="Mã lệnh" Width="155px">
                            <Template Context="item">
                                <span class="fw-bold text-primary text-nowrap">@item.DispatchCode</span>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Property="VehicleId" Title="Phương tiện" Width="160px">
                            <Template Context="item">
                                @{
                                    var xe = dispatchService.GetVehicle(item.VehicleId);
                                }
                                <div><strong>@item.VehiclePlateSnapshot</strong></div>
                                <div class="text-muted small">@(xe?.Brand) @(xe?.Model)</div>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Property="DriverNameSnapshot" Title="Người điều khiển" Width="220px">
                            <Template Context="item">
                                <div><strong>@item.DriverNameSnapshot</strong></div>
                                <div class="text-muted small">
                                    <span class="badge @(item.DriverMode == DriverMode.SelfDrive ? "bg-info text-dark" : "bg-light text-dark border")">
                                        @EnumHelper.TenDriverMode(item.DriverMode)
                                    </span>
                                </div>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Property="RequesterNameSnapshot" Title="Cán bộ đề nghị" Width="150px">
                            <Template Context="item">
                                @item.RequesterNameSnapshot
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Property="ScheduledStartAt" Title="Thời gian công tác" Width="170px">
                            <Template Context="item">
                                <div>@item.ScheduledStartAt.ToString("dd/MM HH:mm")</div>
                                <div class="text-muted small">Đến @item.ScheduledEndAt.ToString("dd/MM HH:mm")</div>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Property="Status" Title="Trạng thái" Width="140px">
                            <Template Context="item">
                                <span class="badge-status @item.Status.BadgeClass()">
                                    @item.Status.Ten()
                                </span>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Title="Thao tác" Sortable="false" Filterable="false" Width="130px">
                            <Template Context="item">
                                <div class="d-flex gap-1">
                                    <RadzenButton Icon="visibility" 
                                                  ButtonStyle="ButtonStyle.Light" 
                                                  Size="ButtonSize.Small" 
                                                  Title="Xem chi tiết lệnh" 
                                                  Click="@(() => XemChiTietLenh(item))" />

                                    @if (item.Status == TripStatus.WaitingDeparture || item.Status == TripStatus.Dispatched)
                                    {
                                        <RadzenButton Icon="delete" 
                                                      ButtonStyle="ButtonStyle.Danger" 
                                                      Size="ButtonSize.Small" 
                                                      Title="Hủy lệnh điều động" 
                                                      Click="@(() => HuyLenhDieuDong(item))" />
                                    }
                                </div>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
}

@code {
    List<Booking> danhSachChoDieuDong = new();
    List<Trip> danhSachLenhDieuDong = new();

    string thongBao = "";
    bool coLoi = false;

    int tabHienTai = 0;

    protected override void OnInitialized()
    {
        authService.UserChanged += CapNhatTrang;
        NapDuLieu();
    }

    private void CapNhatTrang()
    {
        NapDuLieu();
        _ = InvokeAsync(StateHasChanged);
    }

    private void NapDuLieu()
    {
        danhSachChoDieuDong = dispatchService.GetPendingDispatchBookings();
        danhSachLenhDieuDong = dispatchService.GetAllDispatchOrders();
    }

    private async Task MoFormDieuDong(Booking don)
    {
        var result = await dialog.OpenAsync<DispatchCreateDialog>(
            $"Lập lệnh điều động: {don.BookingCode}",
            new Dictionary<string, object?> { { "Booking", don } },
            new DialogOptions { Width = "820px", Resizable = true, Draggable = true }
        );

        if (result == true)
        {
            NapDuLieu();
            thongBao = $"Đã lập lệnh điều động thành công cho yêu cầu {don.BookingCode}!";
            coLoi = false;
            tabHienTai = 1; // Chuyển qua tab Lệnh điều động đã lập
        }
    }

    private async Task XemChiTietYeuCau(Booking don)
    {
        await dialog.OpenAsync<BookingDetailDialog>(
            $"Chi tiết yêu cầu sử dụng phương tiện: {don.BookingCode}",
            new Dictionary<string, object?> { { "Booking", don } },
            new DialogOptions { Width = "760px", Resizable = true, Draggable = true }
        );
    }

    private async Task XemChiTietLenh(Trip item)
    {
        await dialog.OpenAsync<TripDetailDialog>(
            $"Chi tiết Lệnh điều động: {item.DispatchCode}",
            new Dictionary<string, object?> { { "Trip", item } },
            new DialogOptions { Width = "780px", Resizable = true, Draggable = true }
        );
    }

    private async Task HuyLenhDieuDong(Trip item)
    {
        var xacNhan = await dialog.Confirm(
            $"Đồng chí có chắc chắn muốn hủy lệnh điều động {item.DispatchCode}? Yêu cầu sẽ được đưa về danh sách chờ điều động.",
            "Xác nhận hủy lệnh điều động",
            new ConfirmOptions { OkButtonText = "Hủy lệnh", CancelButtonText = "Bỏ qua" });

        if (xacNhan != true) return;

        string loi;
        bool thanhCong = dispatchService.CancelDispatchOrder(item.Id, out loi);

        if (!thanhCong)
        {
            thongBao = loi;
            coLoi = true;
            return;
        }

        NapDuLieu();
        thongBao = $"Đã hủy lệnh điều động {item.DispatchCode} thành công.";
        coLoi = false;
    }

    public void Dispose()
    {
        authService.UserChanged -= CapNhatTrang;
    }
}
