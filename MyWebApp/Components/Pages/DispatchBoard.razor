@page "/dispatch"
@rendermode InteractiveServer
@implements IDisposable

@using MyWebApp.Models.Enums
@using MyWebApp.Helpers

@inject DispatchService dispatchService
@inject DialogService dialog
@inject AuthService authService

<PageTitle>Điều động phương tiện</PageTitle>

@if (!authService.CanDispatch)
{
    <div class="alert alert-warning">
        Trang này dành riêng cho Cán bộ quản lý đội xe và Quản trị viên để phân công, điều động phương tiện và lái xe.
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1>Quản lý điều động phương tiện</h1>
            <p class="text-muted mb-0">Phân công phương tiện, lái xe và kiểm tra xung đột lịch trình</p>
        </div>
    </div>

    @if (thongBao != "")
    {
        <div class="alert @(coLoi ? "alert-danger" : "alert-success")">
            @thongBao
        </div>
    }

    @* FORM LẬP LỆNH ĐIỀU ĐỘNG *@
    @if (yeuCauDangDieuDong != null)
    {
        <div class="card mb-4 border-primary">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <strong>LẬP LỆNH ĐIỀU ĐỘNG CHO YÊU CẦU: @yeuCauDangDieuDong.BookingCode</strong>
                <button class="btn btn-sm btn-outline-light" @onclick="DongFormDieuDong">Đóng</button>
            </div>
            <div class="card-body">
                <div class="alert alert-info py-2 mb-3">
                    <div class="row">
                        <div class="col-md-4"><strong>Cán bộ:</strong> @dispatchService.GetUser(yeuCauDangDieuDong.RequesterId)?.FullName</div>
                        <div class="col-md-4"><strong>Điểm đến:</strong> @yeuCauDangDieuDong.Destination</div>
                        <div class="col-md-4"><strong>Mục đích:</strong> @yeuCauDangDieuDong.Purpose</div>
                        <div class="col-md-4 mt-1"><strong>Khởi hành:</strong> @yeuCauDangDieuDong.DepartureTime.ToString("dd/MM/yyyy HH:mm")</div>
                        <div class="col-md-4 mt-1"><strong>Dự kiến về:</strong> @yeuCauDangDieuDong.ReturnTime.ToString("dd/MM/yyyy HH:mm")</div>
                        <div class="col-md-4 mt-1">
                            <strong>Yêu cầu:</strong> 
                            <span class="badge bg-secondary">@yeuCauDangDieuDong.RequestedVehicleType (@yeuCauDangDieuDong.PassengerCount người)</span>
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label"><strong>1. Chọn phương tiện phân công <span class="text-danger">*</span>:</strong></label>
                        <select class="form-select" @bind="xeDuocChonId" @bind:after="KiemTraPhuongTienDaChon">
                            <option value="0">-- Chọn phương tiện phù hợp --</option>
                            @foreach (Vehicle xe in danhSachXeKhaDung)
                            {
                                bool biTrung = XeBiTrungLich(xe.Id);
                                <option value="@xe.Id" class="@(biTrung ? "text-danger" : "text-success fw-bold")">
                                    @(biTrung ? "⛔ [BẬN LỊCH]" : "✅ [SẴN SÀNG]") @xe.VehicleCode - @xe.LicensePlate (@xe.Brand @xe.Model | @EnumHelper.TenVehicleType(xe.VehicleType) - @xe.Seats chỗ)
                                </option>
                            }
                        </select>

                        @if (!string.IsNullOrEmpty(canhBaoXe))
                        {
                            <div class="alert alert-warning py-1 px-2 mt-2 small">
                                <strong>⚠️ Cảnh báo xung đột:</strong> @canhBaoXe
                            </div>
                        }
                    </div>

                    <div class="col-md-6">
                        <label class="form-label"><strong>2. Chọn lái xe phân công <span class="text-danger">*</span>:</strong></label>
                        <select class="form-select" @bind="laiXeDuocChonId" @bind:after="KiemTraLaiXeDaChon">
                            <option value="0">-- Chọn lái xe --</option>
                            @foreach (Driver lx in danhSachLaiXeKhaDung)
                            {
                                bool biTrungLx = LaiXeBiTrungLich(lx.Id);
                                <option value="@lx.Id" class="@(biTrungLx ? "text-danger" : "text-success fw-bold")">
                                    @(biTrungLx ? "⛔ [BẬN LỊCH]" : "✅ [SẴN SÀNG]") @lx.FullName (GPLX hạng @lx.LicenseType - SĐT: @(string.IsNullOrEmpty(lx.Phone) ? "Chưa có" : lx.Phone))
                                </option>
                            }
                        </select>

                        @if (!string.IsNullOrEmpty(canhBaoLaiXe))
                        {
                            <div class="alert alert-warning py-1 px-2 mt-2 small">
                                <strong>⚠️ Cảnh báo xung đột:</strong> @canhBaoLaiXe
                            </div>
                        }
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <RadzenButton Text="Xác nhận cấp Lệnh điều động" 
                                  Icon="assignment_turned_in" 
                                  ButtonStyle="ButtonStyle.Success" 
                                  Click="XacNhanDieuDong" />

                    <RadzenButton Text="Hủy bỏ" 
                                  Icon="close" 
                                  ButtonStyle="ButtonStyle.Light" 
                                  Click="DongFormDieuDong" />
                </div>
            </div>
        </div>
    }

    @* XEM CHI TIẾT LỆNH ĐIỀU ĐỘNG CHÍNH THỨC *@
    @if (lenhDangXem != null)
    {
        Booking? don = dispatchService.GetBooking(lenhDangXem.BookingId);
        Vehicle? xe = dispatchService.GetVehicle(lenhDangXem.VehicleId);
        Driver? lx = dispatchService.GetDriver(lenhDangXem.DriverId);
        User? nguoiKy = dispatchService.GetUser(lenhDangXem.DispatcherId);

        <div class="card mb-4 border-success shadow-sm">
            <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                <strong>CHI TIẾT LỆNH ĐIỀU ĐỘNG: @lenhDangXem.DispatchCode</strong>
                <button class="btn btn-sm btn-outline-light" @onclick="DongChiTietLenh">Đóng</button>
            </div>
            <div class="card-body p-4">
                <div class="text-center mb-4 border-bottom pb-3">
                    <p class="mb-0 fw-bold">CÔNG AN NHÂN DÂN VIỆT NAM</p>
                    <p class="text-muted small mb-2">ĐƠN VỊ CÔNG AN PHƯỜNG MINH KHAI</p>
                    <h3 class="h4 text-uppercase fw-bold text-success">LỆNH ĐIỀU ĐỘNG PHƯƠNG TIỆN CÔNG TÁC</h3>
                    <p class="mb-0">Số: <strong>@lenhDangXem.DispatchCode</strong> — Ngày lập: @lenhDangXem.DispatchedAt.ToString("dd/MM/yyyy HH:mm")</p>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded">
                            <h6 class="fw-bold border-bottom pb-2 text-primary">I. THÔNG TIN NHIỆM VỤ CÔNG TÁC</h6>
                            <p class="mb-1"><strong>Mã yêu cầu:</strong> @don?.BookingCode</p>
                            <p class="mb-1"><strong>Cán bộ đăng ký:</strong> @dispatchService.GetUser(don?.RequesterId ?? 0)?.FullName</p>
                            <p class="mb-1"><strong>Loại công việc:</strong> @don?.WorkType</p>
                            <p class="mb-1"><strong>Mục đích:</strong> @don?.Purpose</p>
                            <p class="mb-1"><strong>Lộ trình:</strong> @don?.Departure $\rightarrow$ @don?.Destination</p>
                            <p class="mb-1"><strong>Thời gian đi:</strong> @don?.DepartureTime.ToString("dd/MM/yyyy HH:mm")</p>
                            <p class="mb-0"><strong>Thời gian về dự kiến:</strong> @don?.ReturnTime.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded">
                            <h6 class="fw-bold border-bottom pb-2 text-primary">II. PHƯƠNG TIỆN & LÁI XE PHÂN CÔNG</h6>
                            <p class="mb-1"><strong>Biển kiểm soát:</strong> <span class="badge bg-primary">@xe?.LicensePlate</span></p>
                            <p class="mb-1"><strong>Phương tiện:</strong> @xe?.Brand @xe?.Model (@xe?.Seats chỗ ngồi)</p>
                            <p class="mb-1"><strong>Chỉ số Km ban đầu:</strong> @lenhDangXem.StartKm.ToString("N0") km</p>
                            <p class="mb-1"><strong>Lái xe phân công:</strong> @lx?.FullName</p>
                            <p class="mb-1"><strong>Hạng GPLX:</strong> @lx?.LicenseType | <strong>SĐT:</strong> @lx?.Phone</p>
                            <p class="mb-0"><strong>Người lập lệnh:</strong> @nguoiKy?.FullName</p>
                        </div>
                    </div>
                </div>

                <div class="mt-3 d-flex justify-content-between align-items-center">
                    <div>
                        <strong>Tình trạng chuyến đi:</strong> 
                        <span class="badge bg-info text-dark ms-1">@EnumHelper.TenTripStatus(lenhDangXem.Status)</span>
                    </div>
                    <RadzenButton Text="In lệnh điều động (mô phỏng)" Icon="print" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" />
                </div>
            </div>
        </div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <div class="d-flex gap-2 mb-3">
                <RadzenButton Text="@($"Yêu cầu chờ điều động ({danhSachChoDieuDong.Count})")" 
                              ButtonStyle="@(tabHienTai == 0 ? ButtonStyle.Primary : ButtonStyle.Light)" 
                              Click="@(() => tabHienTai = 0)" />

                <RadzenButton Text="@($"Lệnh điều động đã lập ({danhSachLenhDieuDong.Count})")" 
                              ButtonStyle="@(tabHienTai == 1 ? ButtonStyle.Primary : ButtonStyle.Light)" 
                              Click="@(() => tabHienTai = 1)" />
            </div>

            @if (tabHienTai == 0)
            {
                <h2 class="h5 mb-3">Danh sách yêu cầu đã duyệt — Cần phân công xe và lái xe</h2>

                @if (danhSachChoDieuDong.Count == 0)
                {
                    <div class="text-center text-muted py-4">
                        <RadzenIcon Icon="check_circle" Style="font-size: 2.5rem;" class="text-success mb-2" />
                        <p class="mb-0">Hiện tại không có yêu cầu nào đang chờ điều động phương tiện.</p>
                    </div>
                }
                else
                {
                    <RadzenDataGrid Data="@danhSachChoDieuDong" TItem="Booking" AllowPaging="true" PageSize="10" AllowSorting="true">
                        <Columns>
                            <RadzenDataGridColumn TItem="Booking" Property="BookingCode" Title="Mã yêu cầu" Width="130px" />
                            <RadzenDataGridColumn TItem="Booking" Title="Cán bộ đăng ký" Width="160px">
                                <Template Context="item">
                                    @dispatchService.GetUser(item.RequesterId)?.FullName
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="Booking" Property="Destination" Title="Điểm đến" />
                            <RadzenDataGridColumn TItem="Booking" Title="Thời gian công tác">
                                <Template Context="item">
                                    <div>@item.DepartureTime.ToString("dd/MM/yyyy HH:mm")</div>
                                    <small class="text-muted">đến @item.ReturnTime.ToString("dd/MM/yyyy HH:mm")</small>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="Booking" Title="Yêu cầu loại xe" Width="160px">
                                <Template Context="item">
                                    <span class="badge bg-secondary">@item.RequestedVehicleType</span>
                                    <span class="ms-1">(@item.PassengerCount người)</span>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="Booking" Title="Thao tác" Sortable="false" Filterable="false" Width="150px">
                                <Template Context="item">
                                    <RadzenButton Text="Điều động" 
                                                  Icon="assignment_turned_in" 
                                                  ButtonStyle="ButtonStyle.Success" 
                                                  Size="ButtonSize.Small" 
                                                  Click="@(() => MoFormDieuDong(item))" />
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                }
            }
            else
            {
                <h2 class="h5 mb-3">Lịch sử và danh sách lệnh điều động phương tiện</h2>

                <RadzenDataGrid Data="@danhSachLenhDieuDong" TItem="Trip" AllowPaging="true" PageSize="10" AllowSorting="true">
                    <Columns>
                        <RadzenDataGridColumn TItem="Trip" Property="DispatchCode" Title="Mã lệnh" Width="140px" />
                        <RadzenDataGridColumn TItem="Trip" Title="Mã yêu cầu" Width="130px">
                            <Template Context="item">
                                @(dispatchService.GetBooking(item.BookingId)?.BookingCode ?? $"YC-{item.BookingId}")
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="Trip" Title="Phương tiện">
                            <Template Context="item">
                                @{
                                    Vehicle? xe = dispatchService.GetVehicle(item.VehicleId);
                                    if (xe != null)
                                    {
                                        <strong>@xe.LicensePlate</strong> 
                                        <small class="text-muted ms-1">(@xe.Brand @xe.Model)</small>
                                    }
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="Trip" Title="Lái xe" Width="160px">
                            <Template Context="item">
                                @(dispatchService.GetDriver(item.DriverId)?.FullName ?? "Chưa phân công")
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="Trip" Title="Thời gian điều động">
                            <Template Context="item">
                                @{
                                    Booking? don = dispatchService.GetBooking(item.BookingId);
                                    if (don != null)
                                    {
                                        <div>@don.DepartureTime.ToString("dd/MM/yyyy HH:mm")</div>
                                        <small class="text-muted">đến @don.ReturnTime.ToString("dd/MM/yyyy HH:mm")</small>
                                    }
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="Trip" Title="Trạng thái" Width="140px">
                            <Template Context="item">
                                <span class="badge @LayMauTrangThaiChuyen(item.Status)">
                                    @EnumHelper.TenTripStatus(item.Status)
                                </span>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="Trip" Title="Thao tác" Sortable="false" Filterable="false" Width="180px">
                            <Template Context="item">
                                <RadzenButton Icon="visibility" 
                                              ButtonStyle="ButtonStyle.Light" 
                                              Size="ButtonSize.Small" 
                                              Title="Xem chi tiết lệnh" 
                                              Click="@(() => XemChiTietLenh(item))" />

                                @if (item.Status == TripStatus.WaitingDeparture)
                                {
                                    <RadzenButton Text="Hủy lệnh" 
                                                  Icon="cancel" 
                                                  ButtonStyle="ButtonStyle.Danger" 
                                                  Size="ButtonSize.Small" 
                                                  Click="@(() => HuyLenhDieuDong(item))" />
                                }
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            }
        </div>
    </div>
}

@code {
    int tabHienTai = 0; // 0: Chờ điều động, 1: Lệnh đã lập

    List<Booking> danhSachChoDieuDong = new List<Booking>();
    List<Trip> danhSachLenhDieuDong = new List<Trip>();

    Booking? yeuCauDangDieuDong = null;
    Trip? lenhDangXem = null;

    List<Vehicle> danhSachXeKhaDung = new List<Vehicle>();
    List<Driver> danhSachLaiXeKhaDung = new List<Driver>();

    int xeDuocChonId = 0;
    int laiXeDuocChonId = 0;

    string canhBaoXe = "";
    string canhBaoLaiXe = "";
    string thongBao = "";
    bool coLoi = false;

    protected override void OnInitialized()
    {
        authService.UserChanged += CapNhatTrang;
        NapDuLieu();
    }

    private void CapNhatTrang()
    {
        NapDuLieu();
        _ = InvokeAsync(StateHasChanged);
    }

    private void NapDuLieu()
    {
        danhSachChoDieuDong = dispatchService.GetPendingDispatchBookings();
        danhSachLenhDieuDong = dispatchService.GetAllDispatchOrders();
    }

    private void MoFormDieuDong(Booking don)
    {
        yeuCauDangDieuDong = don;
        xeDuocChonId = 0;
        laiXeDuocChonId = 0;
        canhBaoXe = "";
        canhBaoLaiXe = "";
        thongBao = "";

        // Lấy danh sách xe và tài xế khả dụng
        danhSachXeKhaDung = dispatchService.GetEligibleVehicles(don);
        danhSachLaiXeKhaDung = dispatchService.GetEligibleDrivers();
    }

    private void DongFormDieuDong()
    {
        yeuCauDangDieuDong = null;
        xeDuocChonId = 0;
        laiXeDuocChonId = 0;
        canhBaoXe = "";
        canhBaoLaiXe = "";
    }

    private void KiemTraPhuongTienDaChon()
    {
        canhBaoXe = "";

        if (xeDuocChonId <= 0 || yeuCauDangDieuDong == null)
        {
            return;
        }

        // Kiểm tra xung đột lịch
        if (!dispatchService.KiemTraTrungLichXe(xeDuocChonId, yeuCauDangDieuDong.DepartureTime, yeuCauDangDieuDong.ReturnTime, null, out string loi))
        {
            canhBaoXe = loi;
        }
    }

    private bool XeBiTrungLich(int xeId)
    {
        if (yeuCauDangDieuDong == null) return false;
        return !dispatchService.KiemTraTrungLichXe(xeId, yeuCauDangDieuDong.DepartureTime, yeuCauDangDieuDong.ReturnTime, null, out _);
    }

    private bool LaiXeBiTrungLich(int laiXeId)
    {
        if (yeuCauDangDieuDong == null) return false;
        return !dispatchService.KiemTraTrungLichLaiXe(laiXeId, yeuCauDangDieuDong.DepartureTime, yeuCauDangDieuDong.ReturnTime, null, out _);
    }

    private void KiemTraLaiXeDaChon()
    {
        canhBaoLaiXe = "";

        if (laiXeDuocChonId <= 0 || yeuCauDangDieuDong == null)
        {
            return;
        }

        // Kiểm tra xung đột lịch
        if (!dispatchService.KiemTraTrungLichLaiXe(laiXeDuocChonId, yeuCauDangDieuDong.DepartureTime, yeuCauDangDieuDong.ReturnTime, null, out string loi))
        {
            canhBaoLaiXe = loi;
        }
    }

    private async Task XacNhanDieuDong()
    {
        if (yeuCauDangDieuDong == null)
        {
            return;
        }

        if (xeDuocChonId <= 0)
        {
            thongBao = "Vui lòng chọn một phương tiện phù hợp.";
            coLoi = true;
            return;
        }

        if (laiXeDuocChonId <= 0)
        {
            thongBao = "Vui lòng chọn một lái xe để phân công.";
            coLoi = true;
            return;
        }

        var xacNhan = await dialog.Confirm(
            $"Xác nhận lập lệnh điều động cho yêu cầu {yeuCauDangDieuDong.BookingCode}?",
            "Xác nhận điều động");

        if (xacNhan != true)
        {
            return;
        }

        string loi;
        bool thanhCong = dispatchService.CreateDispatchOrder(yeuCauDangDieuDong.Id, xeDuocChonId, laiXeDuocChonId, out loi);

        if (!thanhCong)
        {
            thongBao = loi;
            coLoi = true;
            return;
        }

        string maDon = yeuCauDangDieuDong.BookingCode;
        DongFormDieuDong();
        NapDuLieu();

        thongBao = $"Đã lập lệnh điều động thành công cho yêu cầu {maDon}.";
        coLoi = false;
        tabHienTai = 1; // Chuyển sang tab xem danh sách lệnh
    }

    private void XemChiTietLenh(Trip item)
    {
        lenhDangXem = item;
    }

    private void DongChiTietLenh()
    {
        lenhDangXem = null;
    }

    private async Task HuyLenhDieuDong(Trip item)
    {
        var xacNhan = await dialog.Confirm(
            $"Bạn có chắc chắn muốn hủy lệnh điều động {item.DispatchCode}? Yêu cầu sẽ được đưa về danh sách chờ điều động.",
            "Xác nhận hủy lệnh");

        if (xacNhan != true)
        {
            return;
        }

        string loi;
        bool thanhCong = dispatchService.CancelDispatchOrder(item.Id, out loi);

        if (!thanhCong)
        {
            thongBao = loi;
            coLoi = true;
            return;
        }

        NapDuLieu();
        thongBao = $"Đã hủy lệnh điều động {item.DispatchCode} thành công.";
        coLoi = false;

        if (lenhDangXem?.Id == item.Id)
        {
            DongChiTietLenh();
        }
    }

    private string LayMauTrangThaiChuyen(TripStatus status)
    {
        if (status == TripStatus.WaitingDeparture)
        {
            return "bg-warning text-dark";
        }

        if (status == TripStatus.InTransit)
        {
            return "bg-primary";
        }

        if (status == TripStatus.NeedSupport)
        {
            return "bg-danger";
        }

        if (status == TripStatus.Returned)
        {
            return "bg-success";
        }

        return "bg-secondary";
    }

    public void Dispose()
    {
        authService.UserChanged -= CapNhatTrang;
    }
}
