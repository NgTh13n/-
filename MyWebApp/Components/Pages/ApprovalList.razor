@page "/approvals"
@rendermode InteractiveServer
@implements IDisposable

@using MyWebApp.Models
@using MyWebApp.Models.Enums
@using MyWebApp.Helpers
@using MyWebApp.Data
@using MyWebApp.Components.Dialogs

@inject BookingService bookingService
@inject DialogService dialog
@inject AuthService authService
@inject MockDataService mockDataService
@inject IJSRuntime js

<PageTitle>Phê duyệt yêu cầu phương tiện</PageTitle>

@if (!authService.CanViewApprovals)
{
    <div class="alert alert-warning shadow-sm">
        <RadzenIcon Icon="lock" Class="me-2" />
        Trang này dành riêng cho Lãnh đạo đơn vị (và Quản trị viên theo dõi tiến độ kỹ thuật).
    </div>
}
else
{
    <div class="page-header-box">
        <div>
            <h1 class="page-header-title">
                <RadzenIcon Icon="verified" Style="color: var(--brand-navy);" />
                Phê duyệt yêu cầu sử dụng phương tiện
                @if (authService.CurrentUser?.Role == UserRole.Administrator)
                {
                    <span class="badge bg-secondary ms-2 align-middle" style="font-size: 0.72rem; font-weight: 500;">Chế độ Giám sát kỹ thuật</span>
                }
            </h1>
            <p class="page-header-desc">
                @(authService.CurrentUser?.Role == UserRole.Administrator 
                    ? "Quản trị viên theo dõi tiến độ phê duyệt hồ sơ. Quyền ra quyết định thuộc về Lãnh đạo đơn vị." 
                    : "Hàng chờ thẩm định, ra quyết định phê duyệt, yêu cầu bổ sung hoặc từ chối kế hoạch công tác")
            </p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-secondary-action" @onclick="@(() => hienThiLichSu = !hienThiLichSu)">
                <RadzenIcon Icon="@(hienThiLichSu ? "pending_actions" : "history")" Class="me-1 align-middle" />
                @(hienThiLichSu ? "Xem hàng chờ duyệt" : "Xem lịch sử quyết định")
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(thongBao))
    {
        <div class="alert @(coLoi ? "alert-danger" : "alert-success") alert-dismissible fade show shadow-sm" role="alert">
            <RadzenIcon Icon="@(coLoi ? "error" : "check_circle")" Class="me-2" />
            @thongBao
            <button type="button" class="btn-close" @onclick="() => thongBao = string.Empty"></button>
        </div>
    }

    @* DANH SÁCH YÊU CẦU: HÀNG CHỜ DUYỆT HOẶC LỊCH SỬ *@
    <div class="gov-card">
        <div class="gov-card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h2 class="gov-card-header-title">
                <RadzenIcon Icon="@(hienThiLichSu ? "history" : "hourglass_top")" Style="color: var(--brand-navy);" />
                @(hienThiLichSu ? "Lịch sử các yêu cầu đã xem xét" : "Hàng chờ phê duyệt")
            </h2>
            <span class="badge-status @(hienThiLichSu ? "badge-status-neutral" : "badge-status-warning")">
                @(hienThiLichSu ? $"{danhSachLichSu.Count} hồ sơ" : $"{danhSachChoDuyet.Count} yêu cầu đang chờ")
            </span>
        </div>

        <div class="gov-card-body p-0">
            @if (!hienThiLichSu)
            {
                <RadzenDataGrid Data="@danhSachChoDuyet" 
                                TItem="Booking" 
                                AllowPaging="true" 
                                PageSize="8" 
                                AllowSorting="true" 
                                EmptyText="Hiện không có yêu cầu nào đang chờ phê duyệt.">
                    <Columns>
                        <RadzenDataGridColumn Property="BookingCode" Title="Mã yêu cầu" Width="130px">
                            <Template Context="item">
                                <span class="fw-bold text-primary text-nowrap">@item.BookingCode</span>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Property="RequesterId" Title="Người đề nghị" Width="170px">
                            <Template Context="item">
                                <div><strong>@bookingService.GetRequesterName(item.RequesterId)</strong></div>
                                <div class="text-muted small">@item.DepartmentSnapshot</div>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Property="Purpose" Title="Mục đích công tác" Width="240px">
                            <Template Context="item">
                                <div class="fw-semibold">@item.Purpose</div>
                                <div class="text-muted small">Tới: @item.Destination</div>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Property="PreferredDriverMode" Title="Phương án lái" Width="140px" TextAlign="TextAlign.Center">
                            <Template Context="item">
                                @if (item.PreferredDriverMode == DriverMode.SelfDrive)
                                {
                                    <span class="badge bg-info text-dark">
                                        <RadzenIcon Icon="person" Class="me-1" /> Tự lái
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark border">
                                        <RadzenIcon Icon="drive_eta" Class="me-1" /> Lái xe ĐV
                                    </span>
                                }
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Property="DepartureTime" Title="Thời gian" Width="150px">
                            <Template Context="item">
                                <div>@item.DepartureTime.ToString("dd/MM HH:mm")</div>
                                <div class="text-muted small">Đến @item.ReturnTime.ToString("dd/MM HH:mm")</div>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Title="@(authService.CanApproveBookings ? "Thao tác quyết định" : "Thao tác")" 
                                              Sortable="false" 
                                              Filterable="false" 
                                              TextAlign="TextAlign.Center"
                                              Width="@(authService.CanApproveBookings ? "340px" : "90px")">
                            <Template Context="item">
                                <div class="approval-action-group">
                                    <RadzenButton Icon="visibility" 
                                                  ButtonStyle="ButtonStyle.Light" 
                                                  Size="ButtonSize.Small" 
                                                  Title="Xem chi tiết" 
                                                  Click="@(() => XemChiTiet(item))" />

                                    @if (authService.CanApproveBookings)
                                    {
                                        <RadzenButton Icon="check_circle" 
                                                      Text="Duyệt" 
                                                      ButtonStyle="ButtonStyle.Success" 
                                                      Size="ButtonSize.Small" 
                                                      Title="Phê duyệt yêu cầu" 
                                                      Click="@(() => MoHopThoaiPheDuyet(item))" />

                                        <RadzenButton Icon="edit_note" 
                                                      Text="Bổ sung" 
                                                      ButtonStyle="ButtonStyle.Warning" 
                                                      Size="ButtonSize.Small" 
                                                      Title="Yêu cầu bổ sung thông tin" 
                                                      Click="@(() => MoHopThoaiBoSung(item))" />

                                        <RadzenButton Icon="cancel" 
                                                      Text="Từ chối" 
                                                      ButtonStyle="ButtonStyle.Danger" 
                                                      Size="ButtonSize.Small" 
                                                      Title="Từ chối yêu cầu" 
                                                      Click="@(() => MoHopThoaiTuChoi(item))" />
                                    }
                                </div>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            }
            else
            {
                <RadzenDataGrid Data="@danhSachLichSu" 
                                TItem="Booking" 
                                AllowPaging="true" 
                                PageSize="8" 
                                AllowSorting="true" 
                                EmptyText="Chưa có lịch sử yêu cầu được xử lý.">
                    <Columns>
                        <RadzenDataGridColumn Property="BookingCode" Title="Mã yêu cầu" Width="140px" />

                        <RadzenDataGridColumn Property="RequesterId" Title="Người đề nghị" Width="180px">
                            <Template Context="item">
                                @bookingService.GetRequesterName(item.RequesterId)
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Property="Purpose" Title="Mục đích" Width="260px">
                            <Template Context="item">
                                <div>@item.Purpose</div>
                                <div class="text-muted small">@item.Destination</div>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Property="PreferredDriverMode" Title="Phương án lái" Width="130px">
                            <Template Context="item">
                                @EnumHelper.TenDriverMode(item.PreferredDriverMode)
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Property="DepartureTime" Title="Thời gian khởi hành" Width="150px">
                            <Template Context="item">
                                @item.DepartureTime.ToString("dd/MM/yyyy HH:mm")
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Property="Status" Title="Kết quả / Trạng thái" Width="160px">
                            <Template Context="item">
                                <span class="badge-status @item.Status.BadgeClass()">
                                    @item.Status.Ten()
                                </span>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Title="Thao tác" Sortable="false" Filterable="false" TextAlign="TextAlign.Center" Width="90px">
                            <Template Context="item">
                                <RadzenButton Icon="visibility" 
                                              ButtonStyle="ButtonStyle.Light" 
                                              Size="ButtonSize.Small" 
                                              Title="Xem chi tiết" 
                                              Click="@(() => XemChiTiet(item))" />
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            }
        </div>
    </div>
}

@code {
    List<Booking> danhSachChoDuyet = new();
    List<Booking> danhSachLichSu = new();

    bool hienThiLichSu = false;
    string thongBao = "";
    bool coLoi = false;

    protected override void OnInitialized()
    {
        authService.UserChanged += CapNhatTrang;
        NapDuLieu();
    }

    private void CapNhatTrang()
    {
        NapDuLieu();
        _ = InvokeAsync(StateHasChanged);
    }

    private void NapDuLieu()
    {
        danhSachChoDuyet = bookingService.GetPendingApprovals();
        danhSachLichSu = bookingService.GetApprovalHistory();
    }

    private async Task XemChiTiet(Booking item)
    {
        await dialog.OpenAsync<BookingDetailDialog>(
            $"Hồ sơ yêu cầu: {item.BookingCode}",
            new Dictionary<string, object?> { { "Booking", item } },
            new DialogOptions { Width = "840px", CloseDialogOnOverlayClick = true, CloseDialogOnEsc = true });
    }

    // --- POPUP PHÊ DUYỆT ---
    private async Task MoHopThoaiPheDuyet(Booking item)
    {
        if (!authService.CanApproveBookings) return;

        var res = await dialog.OpenAsync<ApprovalActionDialog>(
            $"Phê duyệt yêu cầu sử dụng phương tiện: {item.BookingCode}",
            new Dictionary<string, object?> { { "Booking", item }, { "ActionType", "Approve" } },
            new DialogOptions { Width = "760px", CloseDialogOnOverlayClick = true, CloseDialogOnEsc = true });

        if (res == true)
        {
            NapDuLieu();
            thongBao = $"Đã phê duyệt yêu cầu {item.BookingCode}. Hồ sơ đã được chuyển tiếp sang Đội xe để điều động.";
            coLoi = false;
        }
    }

    // --- POPUP YÊU CẦU BỔ SUNG ---
    private async Task MoHopThoaiBoSung(Booking item)
    {
        if (!authService.CanApproveBookings) return;

        var res = await dialog.OpenAsync<ApprovalActionDialog>(
            $"Yêu cầu bổ sung thông tin: {item.BookingCode}",
            new Dictionary<string, object?> { { "Booking", item }, { "ActionType", "Adjustment" } },
            new DialogOptions { Width = "760px", CloseDialogOnOverlayClick = true, CloseDialogOnEsc = true });

        if (res == true)
        {
            NapDuLieu();
            thongBao = $"Đã gửi yêu cầu bổ sung thông tin cho hồ sơ {item.BookingCode}.";
            coLoi = false;
        }
    }

    // --- POPUP TỪ CHỐI ---
    private async Task MoHopThoaiTuChoi(Booking item)
    {
        if (!authService.CanApproveBookings) return;

        var res = await dialog.OpenAsync<ApprovalActionDialog>(
            $"Từ chối yêu cầu sử dụng phương tiện: {item.BookingCode}",
            new Dictionary<string, object?> { { "Booking", item }, { "ActionType", "Reject" } },
            new DialogOptions { Width = "760px", CloseDialogOnOverlayClick = true, CloseDialogOnEsc = true });

        if (res == true)
        {
            NapDuLieu();
            thongBao = $"Đã từ chối yêu cầu {item.BookingCode} và lưu lý do từ chối vào lịch sử.";
            coLoi = false;
        }
    }

    public void Dispose()
    {
        authService.UserChanged -= CapNhatTrang;
    }
}
