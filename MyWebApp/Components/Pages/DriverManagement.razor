@page "/drivers"
@rendermode InteractiveServer
@implements IDisposable

@using MyWebApp.Models.Enums
@using MyWebApp.Helpers
@using MyWebApp.Components.Dialogs

@inject DriverService driverService
@inject DialogService dialog
@inject AuthService authService
@inject IJSRuntime js

<PageTitle>Quản lý lái xe</PageTitle>

@if (!authService.CanManageVehicles)
{
    <div class="alert alert-warning">
        Trang này dành cho cán bộ quản lý đội xe và quản trị viên.
    </div>
}
else
{
    <div class="page-header-box">
        <div>
            <h1 class="page-header-title">
                <RadzenIcon Icon="badge" Style="color: var(--brand-navy);" />
                Quản lý đội ngũ lái xe
            </h1>
            <p class="page-header-desc">Danh sách cán bộ lái xe, phân hạng bằng lái và trạng thái công tác</p>
        </div>
        <div>
            <button class="btn btn-primary-action" @onclick="Them">
                <RadzenIcon Icon="person_add" Class="me-1 align-middle" />
                Thêm lái xe
            </button>
        </div>
    </div>

    @if (thongBao != "")
    {
        <div class="alert @(coLoi ? "alert-danger" : "alert-success") alert-dismissible fade show shadow-sm">
            <RadzenIcon Icon="@(coLoi ? "error" : "check_circle")" Class="me-2" />
            @thongBao
            <button type="button" class="btn-close" @onclick="() => thongBao = string.Empty"></button>
        </div>
    }

    <div class="card">
        <div class="card-body">
            <h2 class="h5">Danh sách lái xe</h2>

            <div class="row mb-3">
                <div class="col-md-6 mb-2">
                    <RadzenLabel Text="Tìm theo tên hoặc số điện thoại" />
                    <RadzenTextBox @bind-Value="tuKhoaTimKiem" Style="width:100%" placeholder="Nhập tên hoặc số điện thoại..." />
                </div>

                <div class="col-md-6 mb-2">
                    <label class="form-label">Tình trạng làm việc</label>
                    <select class="form-select" @bind="locTinhTrang">
                        <option value="-1">Tất cả tình trạng</option>
                        <option value="@((int)DriverStatus.Active)">Đang làm việc</option>
                        <option value="@((int)DriverStatus.OnLeave)">Đang nghỉ phép</option>
                        <option value="@((int)DriverStatus.Inactive)">Không còn làm việc</option>
                    </select>
                </div>

                <div class="col-12 mt-2">
                    <button class="btn btn-secondary" @onclick="DatLaiBoLoc">
                        <RadzenIcon Icon="refresh" Class="me-1" />
                        Đặt lại bộ lọc
                    </button>
                </div>
            </div>

            <RadzenDataGrid Data="@DanhSachHienThi"
                            TItem="Driver"
                            AllowPaging="true"
                            PageSize="8"
                            AllowSorting="true"
                            EmptyText="Không có cán bộ lái xe nào phù hợp.">
                <Columns>
                    <RadzenDataGridColumn Property="OfficerId" Title="Mã lái xe" Width="120px" />
                    <RadzenDataGridColumn Property="FullName" Title="Họ và tên" Width="200px" />
                    <RadzenDataGridColumn Property="Phone" Title="Số điện thoại" Width="140px" />
                    <RadzenDataGridColumn Property="LicenseType" Title="Hạng GPLX" Width="100px" />
                    <RadzenDataGridColumn Property="LicenseExpiryDate" Title="Hạn GPLX" Width="150px">
                        <Template Context="item">
                            @{
                                bool sapHetHan = item.LicenseExpiryDate <= DateTime.Today.AddDays(30);
                                bool daHetHan = item.LicenseExpiryDate < DateTime.Today;
                            }
                            <span class="@(daHetHan ? "badge bg-danger" : (sapHetHan ? "badge bg-warning text-dark" : ""))">
                                @item.LicenseExpiryDate.ToString("dd/MM/yyyy")
                                @(daHetHan ? " (Hết hạn)" : (sapHetHan ? " (Sắp hết hạn)" : ""))
                            </span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="Status" Title="Tình trạng" Width="140px">
                        <Template Context="item">
                            <span class="badge @LayMauTinhTrang(item.Status)">
                                @EnumHelper.TenDriverStatus(item.Status)
                            </span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Title="Thao tác" Width="160px" Sortable="false">
                        <Template Context="item">
                            <div class="d-flex gap-1">
                                <RadzenButton Icon="visibility"
                                              ButtonStyle="ButtonStyle.Light"
                                              Size="ButtonSize.Small"
                                              Title="Xem chi tiết"
                                              Click="@(() => XemChiTiet(item))" />

                                <RadzenButton Icon="edit"
                                              ButtonStyle="ButtonStyle.Info"
                                              Size="ButtonSize.Small"
                                              Title="Sửa thông tin"
                                              Click="@(() => Sua(item))" />

                                <RadzenButton Icon="delete"
                                              ButtonStyle="ButtonStyle.Danger"
                                              Size="ButtonSize.Small"
                                              Title="Xóa lái xe"
                                              Click="@(() => Xoa(item))" />
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </div>
    </div>
}

@code {
    private List<Driver> danhSachLaiXe = new();

    private string tuKhoaTimKiem = "";
    private int locTinhTrang = -1;

    private string thongBao = "";
    private bool coLoi = false;

    private List<Driver> DanhSachHienThi
    {
        get
        {
            var ketQua = danhSachLaiXe.AsEnumerable();

            if (string.IsNullOrWhiteSpace(tuKhoaTimKiem) == false)
            {
                string tuKhoa = tuKhoaTimKiem.Trim().ToLower();
                ketQua = ketQua.Where(x =>
                    x.FullName.ToLower().Contains(tuKhoa) ||
                    x.Phone.ToLower().Contains(tuKhoa));
            }

            if (locTinhTrang != -1)
            {
                ketQua = ketQua.Where(x => (int)x.Status == locTinhTrang);
            }

            return ketQua.ToList();
        }
    }

    protected override void OnInitialized()
    {
        authService.UserChanged += CapNhatTrang;
        NapDuLieu();
    }

    private void CapNhatTrang()
    {
        NapDuLieu();
        _ = InvokeAsync(StateHasChanged);
    }

    private void NapDuLieu()
    {
        danhSachLaiXe = driverService.GetAll();
    }

    private async Task XemChiTiet(Driver item)
    {
        await dialog.OpenAsync<DriverDetailDialog>(
            $"Hồ sơ lái xe: {item.FullName} ({item.OfficerId})",
            new Dictionary<string, object?> { { "Driver", item } },
            new DialogOptions { Width = "760px", CloseDialogOnOverlayClick = true, CloseDialogOnEsc = true });
    }

    private void DatLaiBoLoc()
    {
        tuKhoaTimKiem = "";
        locTinhTrang = -1;
    }

    // --- POPUP THÊM LÁI XE MỚI ---
    private async Task Them()
    {
        var laiXeMoi = new Driver
        {
            LicenseType = "B2",
            Status = DriverStatus.Active,
            LicenseExpiryDate = DateTime.Today.AddYears(3)
        };

        var res = await dialog.OpenAsync<DriverEditDialog>(
            "Thêm cán bộ lái xe mới",
            new Dictionary<string, object?> { { "Driver", laiXeMoi }, { "IsEditing", false } },
            new DialogOptions { Width = "760px", CloseDialogOnOverlayClick = true, CloseDialogOnEsc = true });

        if (res == true)
        {
            NapDuLieu();
            thongBao = "Đã thêm lái xe mới thành công.";
            coLoi = false;
        }
    }

    // --- POPUP CẬP NHẬT LÁI XE ---
    private async Task Sua(Driver item)
    {
        var clone = new Driver
        {
            Id = item.Id,
            OfficerId = item.OfficerId,
            FullName = item.FullName,
            Phone = item.Phone,
            LicenseType = item.LicenseType,
            LicenseNumberDemo = item.LicenseNumberDemo,
            LicenseExpiryDate = item.LicenseExpiryDate,
            IsActive = item.IsActive,
            Status = item.Status,
            Notes = item.Notes
        };

        var res = await dialog.OpenAsync<DriverEditDialog>(
            $"Cập nhật thông tin lái xe: {item.FullName}",
            new Dictionary<string, object?> { { "Driver", clone }, { "IsEditing", true } },
            new DialogOptions { Width = "760px", CloseDialogOnOverlayClick = true, CloseDialogOnEsc = true });

        if (res == true)
        {
            NapDuLieu();
            thongBao = $"Đã cập nhật thông tin lái xe {item.FullName} thành công.";
            coLoi = false;
        }
    }

    private async Task Xoa(Driver item)
    {
        var xacNhan = await dialog.Confirm(
            $"Bạn có chắc chắn muốn xóa lái xe {item.FullName} khỏi hệ thống?",
            "Xác nhận xóa");

        if (xacNhan != true)
        {
            return;
        }

        string loi;
        bool daXoa = driverService.Delete(item.Id, out loi);

        if (daXoa == false)
        {
            thongBao = loi;
            coLoi = true;
            return;
        }

        NapDuLieu();
        thongBao = "Đã xóa lái xe thành công.";
        coLoi = false;
    }

    private string LayMauTinhTrang(DriverStatus status)
    {
        if (status == DriverStatus.Active)
        {
            return "bg-success";
        }

        if (status == DriverStatus.OnLeave)
        {
            return "bg-warning text-dark";
        }

        if (status == DriverStatus.Inactive)
        {
            return "bg-secondary";
        }

        return "bg-info";
    }

    public void Dispose()
    {
        authService.UserChanged -= CapNhatTrang;
    }
}
