@page "/"
@rendermode InteractiveServer

@using MyWebApp.Models
@using MyWebApp.Models.Enums
@using MyWebApp.Helpers

@inject MockDataService mockDataService
@inject AuthService authService
@inject NavigationManager nav

<PageTitle>Tổng quan điều hành phương tiện</PageTitle>

@* TIÊU ĐỀ TRANG CHÍNH QUY *@
<div class="page-header-box">
    <div>
        <h1 class="page-header-title">
            <RadzenIcon Icon="dashboard" Style="color: var(--brand-navy);" />
            Tổng quan điều hành phương tiện công vụ
        </h1>
        <p class="page-header-desc">
            Theo dõi trạng thái sẵn sàng chiến đấu, điều động công tác và an toàn kỹ thuật phương tiện Học viện
        </p>
    </div>
    <div class="d-flex align-items-center gap-2">
        @if (authService.CanManageVehicles)
        {
            <a href="/bookings" class="btn btn-primary-action text-decoration-none">
                <RadzenIcon Icon="add_circle" Class="me-1 align-middle" />
                Lập yêu cầu mới
            </a>
        }
    </div>
</div>

@* 4 THẺ CHỈ SỐ CỐT LÕI (THIẾT KẾ PHẲNG, TINH TẾ, KHÔNG RỐI MẮT) *@
<div class="row g-3 mb-4">
    <div class="col-md-3 col-sm-6">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Tổng xe biên chế</div>
                <div class="kpi-value">@tongSoXe</div>
                <div class="kpi-subtext">Đầy đủ 8 xe theo định mức</div>
            </div>
            <div class="kpi-icon-wrapper">
                <RadzenIcon Icon="directions_car" Style="font-size: 1.5rem;" />
            </div>
        </div>
    </div>

    <div class="col-md-3 col-sm-6">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Sẵn sàng xuất kích</div>
                <div class="kpi-value text-success">@soXeSanSang</div>
                <div class="kpi-subtext">Đạt chuẩn kỹ thuật vận hành</div>
            </div>
            <div class="kpi-icon-wrapper kpi-icon-success">
                <RadzenIcon Icon="check_circle" Style="font-size: 1.5rem;" />
            </div>
        </div>
    </div>

    <div class="col-md-3 col-sm-6">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Đang làm nhiệm vụ</div>
                <div class="kpi-value text-primary">@soXeDangCongTac</div>
                <div class="kpi-subtext">Hoạt động ngoài địa bàn</div>
            </div>
            <div class="kpi-icon-wrapper kpi-icon-primary">
                <RadzenIcon Icon="near_me" Style="font-size: 1.5rem;" />
            </div>
        </div>
    </div>

    <div class="col-md-3 col-sm-6">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Chờ phê duyệt</div>
                <div class="kpi-value text-warning">@soDonChoDuyet</div>
                <div class="kpi-subtext">Yêu cầu cần lãnh đạo ký</div>
            </div>
            <div class="kpi-icon-wrapper kpi-icon-warning">
                <RadzenIcon Icon="schedule" Style="font-size: 1.5rem;" />
            </div>
        </div>
    </div>
</div>

@* NỘI DUNG TÁC CHIẾN 2 CỘT *@
<div class="row g-4">
    @* CỘT TRÁI: PHƯƠNG TIỆN ĐANG HOẠT ĐỘNG TRÊN TUYẾN *@
    <div class="col-lg-8">
        <div class="gov-card h-100">
            <div class="gov-card-header">
                <div class="gov-card-header-title">
                    <RadzenIcon Icon="alt_route" Style="font-size: 1.2rem; color: var(--brand-navy);" />
                    Phương tiện đang thực hiện nhiệm vụ công tác
                </div>
                <a href="/trips" class="btn btn-sm btn-outline-secondary" style="font-size: 0.75rem;">
                    Xem chi tiết nhật trình
                </a>
            </div>
            <div class="gov-card-body p-0">
                @if (danhSachChuyenDangChay.Count == 0)
                {
                    <div class="p-4 text-center text-muted">
                        <RadzenIcon Icon="local_parking" Style="font-size: 2.2rem; opacity: 0.3;" class="d-block mb-1" />
                        Hiện không có phương tiện nào đang di chuyển ngoài đơn vị. Tất cả xe đều tập kết tại bãi đỗ.
                    </div>
                }
                else
                {
                    <div class="gov-table-container border-0">
                        <table class="gov-table">
                            <thead>
                                <tr>
                                    <th>Mã lệnh</th>
                                    <th>Phương tiện</th>
                                    <th>Người lái xe</th>
                                    <th>Tuyến công tác</th>
                                    <th>Thời gian dự kiến</th>
                                    <th class="text-center">Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (Trip t in danhSachChuyenDangChay)
                                {
                                    Vehicle? xe = mockDataService.Vehicles.FirstOrDefault(v => v.Id == t.VehicleId);
                                    Driver? lx = mockDataService.Drivers.FirstOrDefault(d => d.Id == t.DriverId);
                                    Booking? don = mockDataService.Bookings.FirstOrDefault(b => b.Id == t.BookingId);
                                    bool isOverdue = DateTime.Now > t.ScheduledEndAt;

                                    <tr>
                                        <td class="fw-bold text-secondary">@t.DispatchCode</td>
                                        <td>
                                            <div class="fw-semibold">@(xe?.LicensePlate ?? t.VehiclePlateSnapshot)</div>
                                            <div class="small text-muted">@xe?.Brand @xe?.Model</div>
                                        </td>
                                        <td>
                                            @if (t.DriverMode == DriverMode.SelfDrive)
                                            {
                                                <span class="badge-status badge-status-info mb-1">Cán bộ tự lái</span>
                                                <div class="small">@(string.IsNullOrEmpty(t.DriverNameSnapshot) ? "Cán bộ" : t.DriverNameSnapshot)</div>
                                            }
                                            else
                                            {
                                                <span class="badge-status badge-status-neutral mb-1">Lái xe đơn vị</span>
                                                <div class="small">@(lx?.FullName ?? (string.IsNullOrEmpty(t.DriverNameSnapshot) ? "Tài xế" : t.DriverNameSnapshot))</div>
                                            }
                                        </td>
                                        <td>
                                            <div class="fw-medium">@don?.Destination</div>
                                            <div class="small text-muted">@don?.WorkType</div>
                                        </td>
                                        <td class="small">
                                            <div>Xuất phát: @(t.ActualDeparture?.ToString("HH:mm dd/MM") ?? t.ScheduledStartAt.ToString("HH:mm dd/MM"))</div>
                                            <div class="@(isOverdue ? "text-danger fw-bold" : "text-muted")">
                                                Hẹn trả: @t.ScheduledEndAt.ToString("HH:mm dd/MM")
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            @if (isOverdue)
                                            {
                                                <span class="badge-status badge-status-danger">Quá hạn trả xe</span>
                                            }
                                            else if (t.Status == TripStatus.NeedSupport)
                                            {
                                                <span class="badge-status badge-status-danger">Sự cố kỹ thuật</span>
                                            }
                                            else
                                            {
                                                <span class="badge-status badge-status-info">Đang công tác</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    @* CỘT PHẢI: YÊU CẦU MỚI & THÔNG BÁO KỸ THUẬT *@
    <div class="col-lg-4">
        @* 1. DANH SÁCH YÊU CẦU MỚI *@
        <div class="gov-card mb-4">
            <div class="gov-card-header">
                <div class="gov-card-header-title">
                    <RadzenIcon Icon="assignment" Style="font-size: 1.15rem; color: var(--brand-navy);" />
                    Yêu cầu đăng ký mới
                </div>
                <a href="/bookings" class="small text-decoration-none text-muted">Xem tất cả</a>
            </div>
            <div class="gov-card-body p-0">
                <div class="list-group list-group-flush border-0">
                    @foreach (Booking b in danhSachYeuCauMoi)
                    {
                        Officer? officer = mockDataService.Officers.FirstOrDefault(o => o.Id == b.RequesterId);
                        <div class="list-group-item px-3 py-2 border-bottom">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <strong class="small text-primary">@b.BookingCode</strong>
                                <span class="badge-status @b.Status.BadgeClass()">
                                    @b.Status.Ten()
                                </span>
                            </div>
                            <div class="small fw-medium">@(officer?.FullName ?? "Cán bộ") — @(officer?.Department ?? b.DepartmentSnapshot)</div>
                            <div class="small text-muted">Tuyến: @b.Destination (@b.DepartureTime.ToString("dd/MM HH:mm"))</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* 2. GIÁM SÁT AN TOÀN KỸ THUẬT (TIÊU CHÍ 5) *@
        <div class="gov-card">
            <div class="gov-card-header">
                <div class="gov-card-header-title text-danger">
                    <RadzenIcon Icon="gshield" Style="font-size: 1.15rem;" />
                    Kiểm soát an toàn & Điều kiện xe
                </div>
            </div>
            <div class="gov-card-body p-3">
                @if (danhSachCanhBao.Count == 0)
                {
                    <div class="text-center text-success py-2">
                        <RadzenIcon Icon="verified" Style="font-size: 1.8rem;" class="mb-1" />
                        <div class="small fw-medium">Toàn bộ xe và lái xe đạt chuẩn an toàn</div>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var cb in danhSachCanhBao)
                        {
                            <div class="p-2 rounded bg-light border-start border-3 border-danger" style="background-color: #fef2f2 !important;">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong class="small text-danger">@cb.TieuDe</strong>
                                    <span class="badge-status badge-status-danger" style="font-size: 0.68rem;">@cb.LoaiCanhBao</span>
                                </div>
                                <div class="small text-secondary" style="font-size: 0.78rem;">@cb.NoiDung</div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    int tongSoXe = 0;
    int soXeSanSang = 0;
    int soXeDangCongTac = 0;
    int soDonChoDuyet = 0;

    List<Booking> danhSachYeuCauMoi = new();
    List<Trip> danhSachChuyenDangChay = new();

    class CanhBaoItem
    {
        public string TieuDe { get; set; } = "";
        public string NoiDung { get; set; } = "";
        public string LoaiCanhBao { get; set; } = "";
    }

    List<CanhBaoItem> danhSachCanhBao = new();

    protected override void OnInitialized()
    {
        NapDuLieu();
    }

    private void NapDuLieu()
    {
        tongSoXe = mockDataService.Vehicles.Count;
        soXeSanSang = mockDataService.Vehicles.Count(x => x.Status == VehicleStatus.SanSang);
        soXeDangCongTac = mockDataService.Vehicles.Count(x => x.Status == VehicleStatus.DangDuocDieuDong);
        soDonChoDuyet = mockDataService.Bookings.Count(b => b.Status == BookingStatus.PendingApproval);

        danhSachChuyenDangChay = mockDataService.Trips
            .Where(t => t.Status == TripStatus.InTransit || t.Status == TripStatus.NeedSupport)
            .ToList();

        danhSachYeuCauMoi = mockDataService.Bookings
            .OrderByDescending(b => b.Id)
            .Take(4)
            .ToList();

        // Cảnh báo an ninh & an toàn tác chiến
        danhSachCanhBao.Clear();

        var taiXeHetHan = mockDataService.Drivers.Where(d => d.LicenseExpiryDate < DateTime.Today).ToList();
        foreach (var tx in taiXeHetHan)
        {
            danhSachCanhBao.Add(new CanhBaoItem
            {
                TieuDe = $"GPLX hết hạn: {tx.FullName}",
                NoiDung = $"GPLX hạng {tx.LicenseCategory} đã hết hạn ({tx.LicenseExpiryDate:dd/MM/yyyy}). Đã khóa điều phối.",
                LoaiCanhBao = "Khóa điều phối"
            });
        }

        var xeDangSua = mockDataService.Vehicles.Where(v => v.Status == VehicleStatus.DangBaoDuong).ToList();
        foreach (var x in xeDangSua)
        {
            danhSachCanhBao.Add(new CanhBaoItem
            {
                TieuDe = $"Bảo dưỡng: {x.LicensePlate}",
                NoiDung = $"{x.Brand} {x.Model} đang bảo dưỡng xưởng kỹ thuật. Khóa xếp lịch.",
                LoaiCanhBao = "Bảo dưỡng"
            });
        }
    }
}
