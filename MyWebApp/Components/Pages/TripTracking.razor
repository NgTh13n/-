@page "/trips"
@rendermode InteractiveServer
@implements IDisposable

@using MyWebApp.Models
@using MyWebApp.Models.Enums
@using MyWebApp.Helpers
@using MyWebApp.Data
@using MyWebApp.Components.Dialogs

@inject TripService tripService
@inject DialogService dialog
@inject AuthService authService
@inject MockDataService mockDataService
@inject IJSRuntime js

<PageTitle>Theo dõi & Bàn giao xe công tác</PageTitle>

@if (!authService.DaDangNhap)
{
    <div class="alert alert-warning shadow-sm">
        <RadzenIcon Icon="lock" Class="me-2" />
        Vui lòng đăng nhập để theo dõi và thực hiện quy trình bàn giao, hoàn trả phương tiện công tác.
    </div>
}
else
{
    <div class="page-header-box">
        <div>
            <h1 class="page-header-title">
                <RadzenIcon Icon="near_me" Style="color: var(--brand-navy);" />
                Theo dõi hành trình & Bàn giao xe công tác
            </h1>
            <p class="page-header-desc">Biên bản bàn giao xe trước xuất phát, giám sát hành trình và nghiệm thu hoàn trả phương tiện</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(thongBao))
    {
        <div class="alert @(coLoi ? "alert-danger" : "alert-success") alert-dismissible fade show shadow-sm" role="alert">
            <RadzenIcon Icon="@(coLoi ? "error" : "check_circle")" Class="me-2" />
            @thongBao
            <button type="button" class="btn-close" @onclick="() => thongBao = string.Empty"></button>
        </div>
    }

    @* DANH SÁCH CÁC CHUYẾN ĐI (TABS PHÂN LOẠI) *@
    <RadzenTabs @bind-SelectedIndex="tabHienTai" Class="shadow-sm">
        <Tabs>
            @* TAB 1: CHỜ BÀN GIAO XUẤT PHÁT *@
            <RadzenTabsItem Text="@($"Chờ bàn giao xe ({danhSachChoBanGiao.Count})")" Icon="key">
                <RadzenDataGrid Data="@danhSachChoBanGiao" 
                                TItem="Trip" 
                                AllowPaging="true" 
                                PageSize="8" 
                                AllowSorting="true" 
                                EmptyText="Không có chuyến nào đang chờ bàn giao xe.">
                    <Columns>
                        <RadzenDataGridColumn Property="DispatchCode" Title="Mã lệnh" Width="155px">
                            <Template Context="item">
                                <span class="fw-bold text-primary text-nowrap">@item.DispatchCode</span>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Property="VehiclePlateSnapshot" Title="Phương tiện" Width="140px">
                            <Template Context="item">
                                <span class="badge bg-dark">@item.VehiclePlateSnapshot</span>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Property="DriverNameSnapshot" Title="Người điều khiển" Width="220px">
                            <Template Context="item">
                                <div><strong>@item.DriverNameSnapshot</strong></div>
                                <div class="text-muted small">@EnumHelper.TenDriverMode(item.DriverMode)</div>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Property="ScheduledStartAt" Title="Lịch xuất phát" Width="160px">
                            <Template Context="item">
                                @item.ScheduledStartAt.ToString("dd/MM/yyyy HH:mm")
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Title="Thao tác" Sortable="false" Filterable="false" Width="180px">
                            <Template Context="item">
                                <div class="d-flex gap-1">
                                    <RadzenButton Icon="visibility" 
                                                  ButtonStyle="ButtonStyle.Light" 
                                                  Size="ButtonSize.Small" 
                                                  Title="Xem chi tiết" 
                                                  Click="@(() => XemChiTiet(item))" />

                                    <RadzenButton Text="Bàn giao xe" 
                                                  Icon="key" 
                                                  ButtonStyle="ButtonStyle.Primary" 
                                                  Size="ButtonSize.Small" 
                                                  Click="@(() => MoFormBanGiao(item))" />
                                </div>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </RadzenTabsItem>

            @* TAB 2: ĐANG THỰC HIỆN NHIỆM VỤ *@
            <RadzenTabsItem Text="@($"Đang công tác / Sử dụng ({danhSachDangSuDung.Count})")" Icon="directions_car">
                <RadzenDataGrid Data="@danhSachDangSuDung" 
                                TItem="Trip" 
                                AllowPaging="true" 
                                PageSize="8" 
                                AllowSorting="true" 
                                EmptyText="Hiện không có phương tiện nào đang lưu thông trên đường.">
                    <Columns>
                        <RadzenDataGridColumn Property="DispatchCode" Title="Mã lệnh" Width="155px">
                            <Template Context="item">
                                <span class="fw-bold text-primary text-nowrap">@item.DispatchCode</span>
                                @if (item.IsOverdue)
                                {
                                    <div class="badge bg-danger small">QUÁ HẠN TRẢ</div>
                                }
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Property="VehiclePlateSnapshot" Title="Phương tiện" Width="140px">
                            <Template Context="item">
                                <span class="badge bg-dark">@item.VehiclePlateSnapshot</span>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Property="DriverNameSnapshot" Title="Người điều khiển" Width="220px">
                            <Template Context="item">
                                <div><strong>@item.DriverNameSnapshot</strong></div>
                                <div class="text-muted small">@EnumHelper.TenDriverMode(item.DriverMode)</div>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Property="HandoverAt" Title="Bắt đầu lúc" Width="150px">
                            <Template Context="item">
                                @item.HandoverAt?.ToString("dd/MM/yyyy HH:mm")
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Property="ScheduledEndAt" Title="Hạn trả dự kiến" Width="150px">
                            <Template Context="item">
                                <span class="@(item.IsOverdue ? "text-danger fw-bold" : "")">
                                    @item.ScheduledEndAt.ToString("dd/MM/yyyy HH:mm")
                                </span>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Property="Status" Title="Tình trạng" Width="140px">
                            <Template Context="item">
                                <span class="badge-status @item.Status.BadgeClass()">
                                    @item.Status.Ten()
                                </span>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Title="Thao tác" Sortable="false" Filterable="false" Width="220px">
                            <Template Context="item">
                                <div class="d-flex gap-1">
                                    <RadzenButton Icon="visibility" 
                                                  ButtonStyle="ButtonStyle.Light" 
                                                  Size="ButtonSize.Small" 
                                                  Title="Xem chi tiết" 
                                                  Click="@(() => XemChiTiet(item))" />

                                    <RadzenButton Text="Hoàn trả" 
                                                  Icon="check_circle" 
                                                  ButtonStyle="ButtonStyle.Success" 
                                                  Size="ButtonSize.Small" 
                                                  Title="Lập biên bản hoàn trả xe" 
                                                  Click="@(() => MoFormHoanTra(item))" />

                                    @if (item.Status == TripStatus.NeedSupport)
                                    {
                                        <RadzenButton Text="Khắc phục xong" 
                                                      Icon="build" 
                                                      ButtonStyle="ButtonStyle.Info" 
                                                      Size="ButtonSize.Small" 
                                                      Click="@(() => KhacPhucSuCo(item))" />
                                    }
                                    else
                                    {
                                        <RadzenButton Icon="warning" 
                                                      ButtonStyle="ButtonStyle.Danger" 
                                                      Size="ButtonSize.Small" 
                                                      Title="Báo sự cố khẩn cấp" 
                                                      Click="@(() => MoFormBaoSuCo(item))" />
                                    }
                                </div>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </RadzenTabsItem>

            @* TAB 3: TẤT CẢ / LỊCH SỬ HOÀN THÀNH *@
            <RadzenTabsItem Text="@($"Lịch sử / Tất cả ({danhSachTatCa.Count})")" Icon="history">
                <RadzenDataGrid Data="@danhSachTatCa" 
                                TItem="Trip" 
                                AllowPaging="true" 
                                PageSize="8" 
                                AllowSorting="true" 
                                EmptyText="Chưa có chuyến công tác nào trong lịch sử.">
                    <Columns>
                        <RadzenDataGridColumn Property="DispatchCode" Title="Mã lệnh" Width="155px" />
                        <RadzenDataGridColumn Property="VehiclePlateSnapshot" Title="Phương tiện" Width="140px" />
                        <RadzenDataGridColumn Property="DriverNameSnapshot" Title="Người điều khiển" Width="220px" />
                        <RadzenDataGridColumn Property="StartKm" Title="Hành trình Km" Width="170px">
                            <Template Context="item">
                                <div>@item.StartKm.ToString("N0") → @(item.EndKm > 0 ? $"{item.EndKm:N0}" : "---")</div>
                                @if (item.EndKm > item.StartKm)
                                {
                                    <div class="text-success small fw-bold">(@((item.EndKm - item.StartKm).ToString("N0")) km)</div>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Property="FuelUsed" Title="Nhiên liệu" Width="120px">
                            <Template Context="item">
                                @(item.FuelUsed > 0 ? $"{item.FuelUsed:N1} L" : "---")
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Property="Status" Title="Trạng thái" Width="140px">
                            <Template Context="item">
                                <span class="badge-status @item.Status.BadgeClass()">
                                    @item.Status.Ten()
                                </span>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="Thao tác" Sortable="false" Filterable="false" Width="80px">
                            <Template Context="item">
                                <RadzenButton Icon="visibility" 
                                              ButtonStyle="ButtonStyle.Light" 
                                              Size="ButtonSize.Small" 
                                              Title="Xem chi tiết" 
                                              Click="@(() => XemChiTiet(item))" />
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
}

@code {
    int tabHienTai = 1; // Mặc định mở Tab Đang sử dụng

    List<Trip> danhSachChoBanGiao = new();
    List<Trip> danhSachDangSuDung = new();
    List<Trip> danhSachTatCa = new();

    string thongBao = "";
    bool coLoi = false;

    protected override void OnInitialized()
    {
        authService.UserChanged += CapNhatTrang;
        NapDuLieu();
    }

    private void CapNhatTrang()
    {
        NapDuLieu();
        _ = InvokeAsync(StateHasChanged);
    }

    private void NapDuLieu()
    {
        danhSachChoBanGiao = tripService.GetPendingHandoverTrips();
        danhSachDangSuDung = tripService.GetInUseTrips();
        danhSachTatCa = tripService.GetAllTrips();
    }

    private async Task XemChiTiet(Trip item)
    {
        await dialog.OpenAsync<TripDetailDialog>(
            $"Hồ sơ chuyến công tác: {item.DispatchCode}",
            new Dictionary<string, object?> { { "Trip", item } },
            new DialogOptions { Width = "840px", CloseDialogOnOverlayClick = true, CloseDialogOnEsc = true });
    }

    // --- POPUP BÀN GIAO XE ---
    private async Task MoFormBanGiao(Trip item)
    {
        var res = await dialog.OpenAsync<TripHandoverDialog>(
            $"Biên bản bàn giao xe xuất phát: {item.DispatchCode}",
            new Dictionary<string, object?> { { "Trip", item } },
            new DialogOptions { Width = "800px", CloseDialogOnOverlayClick = true, CloseDialogOnEsc = true });

        if (res == true)
        {
            NapDuLieu();
            thongBao = $"Đã bàn giao xe cho chuyến {item.DispatchCode} thành công. Chuyến đi đã chuyển sang trạng thái Đang sử dụng.";
            coLoi = false;
            tabHienTai = 1; // Mở Tab Đang sử dụng
        }
    }

    // --- POPUP HOÀN TRẢ & NGHIỆM THU XE ---
    private async Task MoFormHoanTra(Trip item)
    {
        var res = await dialog.OpenAsync<TripReturnDialog>(
            $"Biên bản nghiệm thu hoàn trả phương tiện: {item.DispatchCode}",
            new Dictionary<string, object?> { { "Trip", item } },
            new DialogOptions { Width = "820px", CloseDialogOnOverlayClick = true, CloseDialogOnEsc = true });

        if (res == true)
        {
            NapDuLieu();
            thongBao = $"Đã hoàn tất nghiệm thu hoàn trả xe cho chuyến {item.DispatchCode}. Phương tiện đã được giải phóng về trạng thái Sẵn sàng!";
            coLoi = false;
            tabHienTai = 2; // Chuyển sang Tab Lịch sử
        }
    }

    // --- POPUP BÁO SỰ CỐ KHẨN CẤP ---
    private async Task MoFormBaoSuCo(Trip item)
    {
        var res = await dialog.OpenAsync<TripIncidentDialog>(
            $"Phát tín hiệu cần hỗ trợ khẩn cấp: {item.DispatchCode}",
            new Dictionary<string, object?> { { "Trip", item } },
            new DialogOptions { Width = "680px", CloseDialogOnOverlayClick = true, CloseDialogOnEsc = true });

        if (res == true)
        {
            NapDuLieu();
            thongBao = $"Đã phát tín hiệu cảnh báo sự cố khẩn cấp cho chuyến {item.DispatchCode}.";
            coLoi = false;
        }
    }

    // --- XÁC NHẬN KHẮC PHỤC SỰ CỐ ---
    private async Task KhacPhucSuCo(Trip item)
    {
        var xacNhan = await dialog.Confirm(
            $"Xác nhận chuyến đi {item.DispatchCode} đã khắc phục xong sự cố và tiếp tục hành trình an toàn?",
            "Xác nhận khắc phục sự cố",
            new ConfirmOptions { OkButtonText = "Xác nhận tiếp tục", CancelButtonText = "Bỏ qua" });

        if (xacNhan == true)
        {
            string loi;
            bool thanhCong = tripService.ResumeTrip(item.Id, "Đã khắc phục sự cố, tiếp tục hành trình an toàn.", out loi);
            if (!thanhCong)
            {
                thongBao = loi;
                coLoi = true;
                return;
            }

            NapDuLieu();
            thongBao = $"Chuyến đi {item.DispatchCode} đã tiếp tục hành trình bình thường.";
            coLoi = false;
        }
    }

    public void Dispose()
    {
        authService.UserChanged -= CapNhatTrang;
    }
}
