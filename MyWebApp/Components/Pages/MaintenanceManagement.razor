@page "/maintenance"
@rendermode InteractiveServer
@implements IDisposable

@using MyWebApp.Models
@using MyWebApp.Models.Enums
@using MyWebApp.Helpers
@using MyWebApp.Services
@using MyWebApp.Data

@inject MaintenanceService maintenanceService
@inject VehicleService vehicleService
@inject DialogService dialog
@inject AuthService authService
@inject MockDataService mockDataService

<PageTitle>Bảo dưỡng kỹ thuật phương tiện</PageTitle>

@if (!authService.CanManageVehicles)
{
    <div class="alert alert-warning shadow-sm">
        <RadzenIcon Icon="lock" Class="me-2" />
        Trang này dành riêng cho Cán bộ quản lý phương tiện và Quản trị viên để theo dõi, lập lịch bảo dưỡng kỹ thuật phương tiện.
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h3 text-primary mb-1">
                <RadzenIcon Icon="build" Class="me-2" />
                Quản lý Bảo dưỡng & Kỹ thuật Phương tiện
            </h1>
            <p class="text-muted mb-0">Theo dõi bảo dưỡng định kỳ, sửa chữa đột xuất, kiểm định an toàn và nghiệm thu xuất xưởng</p>
        </div>
        <div class="d-flex gap-2">
            <RadzenButton Text="Lập phiếu bảo dưỡng mới" Icon="add_circle" Click="MoFormLapPhieu" ButtonStyle="ButtonStyle.Success" />
        </div>
    </div>

    @if (!string.IsNullOrEmpty(thongBao))
    {
        <div class="alert @(coLoi ? "alert-danger" : "alert-success") alert-dismissible fade show shadow-sm" role="alert">
            <RadzenIcon Icon="@(coLoi ? "error" : "check_circle")" Class="me-2" />
            @thongBao
            <button type="button" class="btn-close" @onclick="() => thongBao = string.Empty"></button>
        </div>
    }

    @* THỐNG KÊ NHANH *@
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white shadow-sm border-0">
                <div class="card-body py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small text-white-50">TỔNG HỒ SƠ BẢO DƯỠNG</div>
                        <div class="fs-3 fw-bold">@danhSachBaoDuong.Count</div>
                    </div>
                    <RadzenIcon Icon="history_edu" Style="font-size: 2.5rem; opacity: 0.8;" />
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-warning text-dark shadow-sm border-0">
                <div class="card-body py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small text-muted">XE ĐANG NẰM XƯỞNG</div>
                        <div class="fs-3 fw-bold">@danhSachBaoDuong.Count(x => x.Status == MaintenanceStatus.InProgress)</div>
                    </div>
                    <RadzenIcon Icon="car_repair" Style="font-size: 2.5rem; opacity: 0.8;" />
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-info text-dark shadow-sm border-0">
                <div class="card-body py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small text-muted">LÊN KẾ HOẠCH BẢO DƯỠNG</div>
                        <div class="fs-3 fw-bold">@danhSachBaoDuong.Count(x => x.Status == MaintenanceStatus.Planned)</div>
                    </div>
                    <RadzenIcon Icon="event_upcoming" Style="font-size: 2.5rem; opacity: 0.8;" />
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-success text-white shadow-sm border-0">
                <div class="card-body py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small text-white-50">ĐÃ NGHIỆM THU XUẤT XƯỞNG</div>
                        <div class="fs-3 fw-bold">@danhSachBaoDuong.Count(x => x.Status == MaintenanceStatus.Completed)</div>
                    </div>
                    <RadzenIcon Icon="verified" Style="font-size: 2.5rem; opacity: 0.8;" />
                </div>
            </div>
        </div>
    </div>

    @* FORM LẬP PHIẾU BẢO DƯỠNG MỚI *@
    @if (dangLapPhieu)
    {
        <div class="card mb-4 border-primary shadow-sm">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-2">
                <strong class="fs-6"><RadzenIcon Icon="note_add" Class="me-1" /> LẬP PHIẾU BẢO DƯỠNG / SỬA CHỮA KỸ THUẬT PHƯƠNG TIỆN</strong>
                <button class="btn btn-sm btn-outline-light" @onclick="() => dangLapPhieu = false">Đóng</button>
            </div>
            <div class="card-body">
                <EditForm Model="phieuMoi" OnValidSubmit="XuLyLuuPhieu">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger mb-3" />

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Phương tiện công tác <span class="text-danger">*</span>:</label>
                            <select class="form-select" @bind="phieuMoi.VehicleId" @bind:after="CapNhatThongTinXe">
                                <option value="0">-- Chọn phương tiện --</option>
                                @foreach (Vehicle xe in danhSachXe)
                                {
                                    <option value="@xe.Id">
                                        @xe.VehicleCode - @xe.LicensePlate (@xe.Brand @xe.Model | Odo: @xe.CurrentKm.ToString("N0") km)
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold">Loại hình bảo dưỡng <span class="text-danger">*</span>:</label>
                            <InputSelect class="form-select" @bind-Value="phieuMoi.MaintenanceType">
                                <option value="@MaintenanceType.Periodic">Bảo dưỡng định kỳ theo số Km</option>
                                <option value="@MaintenanceType.Repair">Sửa chữa đột xuất / Khắc phục hư hỏng</option>
                                <option value="@MaintenanceType.Inspection">Kiểm định kỹ thuật / Đăng kiểm lưu hành</option>
                            </InputSelect>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold">Xưởng / Gara thực hiện:</label>
                            <InputText class="form-control" @bind-Value="phieuMoi.GarageName" placeholder="Xưởng Sửa chữa Kỹ thuật Ô tô CAND..." />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold">Ngày dự kiến / Ngày bắt đầu:</label>
                            <RadzenDatePicker @bind-Value="phieuMoi.PlannedAt" DateFormat="dd/MM/yyyy" Class="w-100" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold">Chỉ số Odometer hiện tại (Km):</label>
                            <InputNumber class="form-control" @bind-Value="phieuMoi.OdometerKm" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold">Chi phí dự toán (VNĐ):</label>
                            <InputNumber class="form-control" @bind-Value="phieuMoi.Cost" />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold">Nội dung chi tiết bảo dưỡng / sửa chữa <span class="text-danger">*</span>:</label>
                            <InputTextArea class="form-control" rows="2" @bind-Value="phieuMoi.Description" placeholder="Mô tả cụ thể các hạng mục: thay dầu, lọc dầu, bảo dưỡng phanh, kiểm tra gầm lốp, sửa chữa hệ thống điện còi ưu tiên..."></InputTextArea>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="switchBaoDuong" @bind="chuyenTrangThaiXeNgay" />
                                <label class="form-check-label fw-bold text-danger" for="switchBaoDuong">
                                    Đưa phương tiện vào trạng thái "Đang bảo dưỡng" (Maintenance) ngay lập tức (Phương tiện sẽ bị khóa điều động ở màn hình Điều phối)
                                </label>
                            </div>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2 border-top pt-2">
                            <RadzenButton ButtonType="ButtonType.Submit" 
                                          Text="Lưu phiếu bảo dưỡng" 
                                          Icon="save" 
                                          ButtonStyle="ButtonStyle.Success" />
                            <RadzenButton Text="Hủy bỏ" 
                                          Icon="close" 
                                          ButtonStyle="ButtonStyle.Light" 
                                          Click="() => dangLapPhieu = false" />
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    @* HỘP THOẠI NGHIỆM THU HOÀN TẤT BẢO DƯỠNG *@
    @if (phieuDangNghiemThu != null)
    {
        var xe = vehicleService.GetAll().FirstOrDefault(v => v.Id == phieuDangNghiemThu.VehicleId);

        <div class="card mb-4 border-success shadow-sm">
            <div class="card-header bg-success text-white d-flex justify-content-between align-items-center py-2">
                <strong><RadzenIcon Icon="verified" Class="me-1" /> NGHIỆM THU XUẤT XƯỞNG BẢO DƯỠNG — PHIẾU #@phieuDangNghiemThu.Id</strong>
                <button class="btn btn-sm btn-outline-light" @onclick="() => phieuDangNghiemThu = null">Đóng</button>
            </div>
            <div class="card-body">
                <p class="mb-2">
                    Phương tiện: <strong>@xe?.LicensePlate</strong> (@xe?.Brand @xe?.Model) 
                    | Nội dung: <strong>@phieuDangNghiemThu.Description</strong>
                </p>
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Ngày hoàn thành nghiệm thu:</label>
                        <RadzenDatePicker @bind-Value="ngayNghiemThu" DateFormat="dd/MM/yyyy" Class="w-100" />
                    </div>
                    <div class="col-md-8">
                        <label class="form-label fw-bold">Kết luận kỹ thuật & Ghi chú nghiệm thu:</label>
                        <input type="text" class="form-control" @bind="ghiChuNghiemThu" placeholder="Đã kiểm tra vận hành thử 20km, xe hoạt động ổn định, phanh và hệ thống lái đạt tiêu chuẩn xuất xưởng..." />
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <RadzenButton Text="Xác nhận Nghiệm thu & Đưa xe về Sẵn sàng" 
                                  Icon="check_circle" 
                                  ButtonStyle="ButtonStyle.Success" 
                                  Click="XacNhanNghiemThu" />
                    <RadzenButton Text="Bỏ qua" 
                                  Icon="close" 
                                  ButtonStyle="ButtonStyle.Light" 
                                  Click="() => phieuDangNghiemThu = null" />
                </div>
            </div>
        </div>
    }

    @* BẢNG DANH SÁCH HỒ SƠ BẢO DƯỠNG *@
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-4">
                    <RadzenTextBox @bind-Value="tuKhoaTimKiem" 
                                   Placeholder="Tìm biển số xe, nội dung, gara..." 
                                   Class="w-100" />
                </div>
                <div class="col-md-3">
                    <RadzenDropDown @bind-Value="locTrangThai" 
                                    Data="danhSachTrangThaiLoc" 
                                    TextProperty="Ten" 
                                    ValueProperty="GiaTri" 
                                    Class="w-100" />
                </div>
                <div class="col-md-2">
                    <RadzenButton Text="Đặt lại lọc" Icon="restart_alt" ButtonStyle="ButtonStyle.Light" Click="() => { tuKhoaTimKiem = string.Empty; locTrangThai = -1; }" />
                </div>
                <div class="col-md-3 text-end text-muted small">
                    Tổng số: <strong>@DanhSachHienThi.Count</strong> hồ sơ
                </div>
            </div>
        </div>

        <div class="card-body p-0">
            <RadzenDataGrid Data="@DanhSachHienThi" 
                            TItem="MaintenanceRecord" 
                            AllowPaging="true" 
                            PageSize="8" 
                            AllowSorting="true" 
                            EmptyText="Chưa có hồ sơ bảo dưỡng phương tiện nào.">
                <Columns>
                    <RadzenDataGridColumn Property="Id" Title="Mã phiếu" Width="90px">
                        <Template Context="item">
                            <span class="fw-bold text-primary">#@item.Id</span>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Property="VehicleId" Title="Phương tiện" Width="150px">
                        <Template Context="item">
                            @{
                                var xe = danhSachXe.FirstOrDefault(v => v.Id == item.VehicleId);
                            }
                            <div><strong class="text-dark">@(xe?.LicensePlate ?? "Chưa rõ")</strong></div>
                            <div class="text-muted small">@(xe?.Brand) @(xe?.Model)</div>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Property="MaintenanceType" Title="Loại hình" Width="150px">
                        <Template Context="item">
                            <span class="badge bg-light text-dark border">
                                @EnumHelper.TenMaintenanceType(item.MaintenanceType)
                            </span>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Property="Description" Title="Nội dung bảo dưỡng" Width="260px">
                        <Template Context="item">
                            <div class="fw-semibold">@item.Description</div>
                            <div class="text-muted small"><RadzenIcon Icon="home_repair_service" Class="me-1" />@item.GarageName</div>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Property="PlannedAt" Title="Thời gian" Width="160px">
                        <Template Context="item">
                            <div>Bắt đầu: @item.PlannedAt.ToString("dd/MM/yyyy")</div>
                            @if (item.CompletedAt.HasValue)
                            {
                                <div class="text-success small">Xong: @item.CompletedAt.Value.ToString("dd/MM/yyyy")</div>
                            }
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Property="Cost" Title="Chi phí" Width="120px">
                        <Template Context="item">
                            @(item.Cost.HasValue ? $"{item.Cost.Value:N0} đ" : "---")
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Property="Status" Title="Trạng thái" Width="140px">
                        <Template Context="item">
                            <span class="badge-status @item.Status.BadgeClass()">
                                @item.Status.Ten()
                            </span>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Title="Thao tác" Sortable="false" Filterable="false" Width="140px">
                        <Template Context="item">
                            @if (item.Status == MaintenanceStatus.Planned || item.Status == MaintenanceStatus.InProgress)
                            {
                                <RadzenButton Text="Nghiệm thu" 
                                              Icon="verified" 
                                              ButtonStyle="ButtonStyle.Success" 
                                              Size="ButtonSize.Small" 
                                              Title="Nghiệm thu đưa xe về sẵn sàng" 
                                              Click="@(() => MoNghiemThu(item))" />
                            }
                            else
                            {
                                <span class="text-success small fw-bold"><RadzenIcon Icon="done_all" Class="me-1" />Đã xong</span>
                            }
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </div>
    </div>
}

@code {
    List<MaintenanceRecord> danhSachBaoDuong = new();
    List<Vehicle> danhSachXe = new();

    MaintenanceRecord phieuMoi = new();
    MaintenanceRecord? phieuDangNghiemThu;

    bool dangLapPhieu = false;
    bool chuyenTrangThaiXeNgay = true;
    DateTime ngayNghiemThu = DateTime.Today;
    string ghiChuNghiemThu = "Đạt tiêu chuẩn kỹ thuật an toàn lưu hành.";

    string tuKhoaTimKiem = "";
    int locTrangThai = -1;

    string thongBao = "";
    bool coLoi = false;

    class ItemLoc
    {
        public int GiaTri { get; set; }
        public string Ten { get; set; } = "";
    }

    List<ItemLoc> danhSachTrangThaiLoc = new()
    {
        new ItemLoc { GiaTri = -1, Ten = "-- Tất cả trạng thái --" },
        new ItemLoc { GiaTri = (int)MaintenanceStatus.InProgress, Ten = "Đang bảo dưỡng" },
        new ItemLoc { GiaTri = (int)MaintenanceStatus.Planned, Ten = "Lên kế hoạch" },
        new ItemLoc { GiaTri = (int)MaintenanceStatus.Completed, Ten = "Đã hoàn thành" }
    };

    List<MaintenanceRecord> DanhSachHienThi
    {
        get
        {
            var ds = danhSachBaoDuong.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(tuKhoaTimKiem))
            {
                string tk = tuKhoaTimKiem.Trim().ToLower();
                ds = ds.Where(x => 
                    x.Description.ToLower().Contains(tk) ||
                    x.GarageName.ToLower().Contains(tk) ||
                    danhSachXe.Any(v => v.Id == x.VehicleId && v.LicensePlate.ToLower().Contains(tk)));
            }

            if (locTrangThai >= 0)
            {
                ds = ds.Where(x => (int)x.Status == locTrangThai);
            }

            return ds.OrderByDescending(x => x.PlannedAt).ToList();
        }
    }

    protected override void OnInitialized()
    {
        authService.UserChanged += CapNhatTrang;
        NapDuLieu();
    }

    private void CapNhatTrang()
    {
        NapDuLieu();
        _ = InvokeAsync(StateHasChanged);
    }

    private void NapDuLieu()
    {
        danhSachBaoDuong = maintenanceService.GetAll();
        danhSachXe = vehicleService.GetAll();
    }

    private void MoFormLapPhieu()
    {
        phieuMoi = new MaintenanceRecord
        {
            PlannedAt = DateTime.Today,
            GarageName = "Xưởng Sửa chữa Kỹ thuật Ô tô CAND - Cục Hậu cần",
            MaintenanceType = MaintenanceType.Periodic,
            Status = MaintenanceStatus.InProgress,
            Cost = 2500000
        };
        dangLapPhieu = true;
        phieuDangNghiemThu = null;
        chuyenTrangThaiXeNgay = true;
        thongBao = "";
    }

    private void CapNhatThongTinXe()
    {
        var xe = danhSachXe.FirstOrDefault(v => v.Id == phieuMoi.VehicleId);
        if (xe != null)
        {
            phieuMoi.OdometerKm = xe.CurrentKm;
        }
    }

    private void XuLyLuuPhieu()
    {
        if (phieuMoi.VehicleId <= 0)
        {
            thongBao = "Vui lòng chọn phương tiện cần lập phiếu bảo dưỡng.";
            coLoi = true;
            return;
        }

        string loi;
        bool thanhCong = maintenanceService.Add(phieuMoi, chuyenTrangThaiXeNgay, out loi);

        if (!thanhCong)
        {
            thongBao = loi;
            coLoi = true;
            return;
        }

        dangLapPhieu = false;
        NapDuLieu();
        thongBao = $"Đã lập phiếu bảo dưỡng thành công cho xe. Phương tiện đã được chuyển sang chế độ bảo dưỡng an toàn.";
        coLoi = false;
    }

    private void MoNghiemThu(MaintenanceRecord item)
    {
        phieuDangNghiemThu = item;
        dangLapPhieu = false;
        ngayNghiemThu = DateTime.Today;
        ghiChuNghiemThu = "Đạt tiêu chuẩn an toàn kỹ thuật CAND, nghiệm thu xuất xưởng đưa về sẵn sàng.";
        thongBao = "";
    }

    private async Task XacNhanNghiemThu()
    {
        if (phieuDangNghiemThu == null) return;

        var xacNhan = await dialog.Confirm(
            $"Xác nhận nghiệm thu xuất xưởng cho phương tiện? Hệ thống sẽ đưa xe về trạng thái Sẵn sàng và gia hạn lần bảo dưỡng kế tiếp.",
            "Xác nhận nghiệm thu",
            new ConfirmOptions { OkButtonText = "Xác nhận nghiệm thu", CancelButtonText = "Bỏ qua" });

        if (xacNhan != true) return;

        string loi;
        bool thanhCong = maintenanceService.CompleteMaintenance(
            phieuDangNghiemThu.Id, 
            ngayNghiemThu, 
            ghiChuNghiemThu, 
            out loi);

        if (!thanhCong)
        {
            thongBao = loi;
            coLoi = true;
            return;
        }

        int maPhieu = phieuDangNghiemThu.Id;
        phieuDangNghiemThu = null;
        NapDuLieu();

        thongBao = $"Đã nghiệm thu xuất xưởng thành công phiếu #{maPhieu}. Xe đã sẵn sàng nhận lệnh điều động mới!";
        coLoi = false;
    }

    public void Dispose()
    {
        authService.UserChanged -= CapNhatTrang;
    }
}
