@page "/maintenance"
@rendermode InteractiveServer
@implements IDisposable

@using MyWebApp.Models
@using MyWebApp.Models.Enums
@using MyWebApp.Helpers
@using MyWebApp.Services
@using MyWebApp.Data
@using MyWebApp.Components.Dialogs

@inject MaintenanceService maintenanceService
@inject VehicleService vehicleService
@inject DialogService dialog
@inject AuthService authService
@inject MockDataService mockDataService
@inject IJSRuntime js

<PageTitle>Bảo dưỡng kỹ thuật phương tiện</PageTitle>

@if (!authService.CanManageVehicles)
{
    <div class="alert alert-warning shadow-sm">
        <RadzenIcon Icon="lock" Class="me-2" />
        Trang này dành riêng cho Cán bộ quản lý phương tiện và Quản trị viên để theo dõi, lập lịch bảo dưỡng kỹ thuật phương tiện.
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h3 text-primary mb-1">
                <RadzenIcon Icon="build" Class="me-2" />
                Quản lý Bảo dưỡng & Kỹ thuật Phương tiện
            </h1>
            <p class="text-muted mb-0">Theo dõi bảo dưỡng định kỳ, sửa chữa đột xuất, kiểm định an toàn và nghiệm thu xuất xưởng</p>
        </div>
        <div class="d-flex gap-2">
            <RadzenButton Text="Lập phiếu bảo dưỡng mới" Icon="add_circle" Click="MoFormLapPhieu" ButtonStyle="ButtonStyle.Success" />
        </div>
    </div>

    @if (!string.IsNullOrEmpty(thongBao))
    {
        <div class="alert @(coLoi ? "alert-danger" : "alert-success") alert-dismissible fade show shadow-sm" role="alert">
            <RadzenIcon Icon="@(coLoi ? "error" : "check_circle")" Class="me-2" />
            @thongBao
            <button type="button" class="btn-close" @onclick="() => thongBao = string.Empty"></button>
        </div>
    }

    @* THỐNG KÊ NHANH *@
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white shadow-sm border-0">
                <div class="card-body py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small text-white-50">TỔNG HỒ SƠ BẢO DƯỠNG</div>
                        <div class="fs-3 fw-bold">@danhSachBaoDuong.Count</div>
                    </div>
                    <RadzenIcon Icon="history_edu" Style="font-size: 2.5rem; opacity: 0.8;" />
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-warning text-dark shadow-sm border-0">
                <div class="card-body py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small text-muted">XE ĐANG NẰM XƯỞNG</div>
                        <div class="fs-3 fw-bold">@danhSachBaoDuong.Count(x => x.Status == MaintenanceStatus.InProgress)</div>
                    </div>
                    <RadzenIcon Icon="car_repair" Style="font-size: 2.5rem; opacity: 0.8;" />
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-info text-dark shadow-sm border-0">
                <div class="card-body py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small text-muted">LÊN KẾ HOẠCH BẢO DƯỠNG</div>
                        <div class="fs-3 fw-bold">@danhSachBaoDuong.Count(x => x.Status == MaintenanceStatus.Planned)</div>
                    </div>
                    <RadzenIcon Icon="event_upcoming" Style="font-size: 2.5rem; opacity: 0.8;" />
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-success text-white shadow-sm border-0">
                <div class="card-body py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small text-white-50">ĐÃ NGHIỆM THU XUẤT XƯỞNG</div>
                        <div class="fs-3 fw-bold">@danhSachBaoDuong.Count(x => x.Status == MaintenanceStatus.Completed)</div>
                    </div>
                    <RadzenIcon Icon="verified" Style="font-size: 2.5rem; opacity: 0.8;" />
                </div>
            </div>
        </div>
    </div>

    @* BẢNG DANH SÁCH HỒ SƠ BẢO DƯỠNG *@
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-4">
                    <RadzenTextBox @bind-Value="tuKhoaTimKiem" 
                                   Placeholder="Tìm biển số xe, nội dung, gara..." 
                                   Class="w-100" />
                </div>
                <div class="col-md-3">
                    <RadzenDropDown @bind-Value="locTrangThai" 
                                    Data="danhSachTrangThaiLoc" 
                                    TextProperty="Ten" 
                                    ValueProperty="GiaTri" 
                                    Class="w-100" />
                </div>
                <div class="col-md-2">
                    <RadzenButton Text="Đặt lại lọc" Icon="restart_alt" ButtonStyle="ButtonStyle.Light" Click="() => { tuKhoaTimKiem = string.Empty; locTrangThai = -1; }" />
                </div>
                <div class="col-md-3 text-end text-muted small">
                    Tổng số: <strong>@DanhSachHienThi.Count</strong> hồ sơ
                </div>
            </div>
        </div>

        <div class="card-body p-0">
            <RadzenDataGrid Data="@DanhSachHienThi" 
                            TItem="MaintenanceRecord" 
                            AllowPaging="true" 
                            PageSize="8" 
                            AllowSorting="true" 
                            EmptyText="Chưa có hồ sơ bảo dưỡng phương tiện nào.">
                <Columns>
                    <RadzenDataGridColumn Property="Id" Title="Mã phiếu" Width="90px">
                        <Template Context="item">
                            <span class="fw-bold text-primary">#@item.Id</span>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Property="VehicleId" Title="Phương tiện" Width="150px">
                        <Template Context="item">
                            @{
                                var xe = danhSachXe.FirstOrDefault(v => v.Id == item.VehicleId);
                            }
                            <div><strong class="text-dark">@(xe?.LicensePlate ?? "Chưa rõ")</strong></div>
                            <div class="text-muted small">@(xe?.Brand) @(xe?.Model)</div>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Property="MaintenanceType" Title="Loại hình" Width="150px">
                        <Template Context="item">
                            <span class="badge bg-light text-dark border">
                                @EnumHelper.TenMaintenanceType(item.MaintenanceType)
                            </span>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Property="Description" Title="Nội dung bảo dưỡng" Width="260px">
                        <Template Context="item">
                            <div class="fw-semibold">@item.Description</div>
                            <div class="text-muted small"><RadzenIcon Icon="home_repair_service" Class="me-1" />@item.GarageName</div>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Property="PlannedAt" Title="Thời gian" Width="160px">
                        <Template Context="item">
                            <div>Bắt đầu: @item.PlannedAt.ToString("dd/MM/yyyy")</div>
                            @if (item.CompletedAt.HasValue)
                            {
                                <div class="text-success small">Xong: @item.CompletedAt.Value.ToString("dd/MM/yyyy")</div>
                            }
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Property="Cost" Title="Chi phí" Width="120px">
                        <Template Context="item">
                            @(item.Cost.HasValue ? $"{item.Cost.Value:N0} đ" : "---")
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Property="Status" Title="Trạng thái" Width="140px">
                        <Template Context="item">
                            <span class="badge-status @item.Status.BadgeClass()">
                                @item.Status.Ten()
                            </span>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Title="Thao tác" Sortable="false" Filterable="false" Width="180px">
                        <Template Context="item">
                            <div class="d-flex gap-1 align-items-center">
                                <RadzenButton Icon="visibility" 
                                              ButtonStyle="ButtonStyle.Light" 
                                              Size="ButtonSize.Small" 
                                              Title="Xem chi tiết hồ sơ" 
                                              Click="@(() => XemChiTietBaoDuong(item))" />

                                @if (item.Status == MaintenanceStatus.Planned || item.Status == MaintenanceStatus.InProgress)
                                {
                                    <RadzenButton Text="Nghiệm thu" 
                                                  Icon="verified" 
                                                  ButtonStyle="ButtonStyle.Success" 
                                                  Size="ButtonSize.Small" 
                                                  Title="Nghiệm thu đưa xe về sẵn sàng" 
                                                  Click="@(() => MoNghiemThu(item))" />
                                }
                                else
                                {
                                    <span class="text-success small fw-bold ms-1"><RadzenIcon Icon="done_all" Class="me-1" />Đã xong</span>
                                }
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </div>
    </div>
}

@code {
    List<MaintenanceRecord> danhSachBaoDuong = new();
    List<Vehicle> danhSachXe = new();

    string tuKhoaTimKiem = "";
    int locTrangThai = -1;

    string thongBao = "";
    bool coLoi = false;

    class ItemLoc
    {
        public int GiaTri { get; set; }
        public string Ten { get; set; } = "";
    }

    List<ItemLoc> danhSachTrangThaiLoc = new()
    {
        new ItemLoc { GiaTri = -1, Ten = "-- Tất cả trạng thái --" },
        new ItemLoc { GiaTri = (int)MaintenanceStatus.InProgress, Ten = "Đang bảo dưỡng" },
        new ItemLoc { GiaTri = (int)MaintenanceStatus.Planned, Ten = "Lên kế hoạch" },
        new ItemLoc { GiaTri = (int)MaintenanceStatus.Completed, Ten = "Đã hoàn thành" }
    };

    List<MaintenanceRecord> DanhSachHienThi
    {
        get
        {
            var ds = danhSachBaoDuong.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(tuKhoaTimKiem))
            {
                string tk = tuKhoaTimKiem.Trim().ToLower();
                ds = ds.Where(x =>
                {
                    var xe = danhSachXe.FirstOrDefault(v => v.Id == x.VehicleId);
                    return (xe != null && xe.LicensePlate.ToLower().Contains(tk)) ||
                           (x.Description != null && x.Description.ToLower().Contains(tk)) ||
                           (x.GarageName != null && x.GarageName.ToLower().Contains(tk));
                });
            }

            if (locTrangThai >= 0)
            {
                ds = ds.Where(x => (int)x.Status == locTrangThai);
            }

            return ds.OrderByDescending(x => x.PlannedAt).ToList();
        }
    }

    protected override void OnInitialized()
    {
        authService.UserChanged += CapNhatTrang;
        NapDuLieu();
    }

    private void CapNhatTrang()
    {
        NapDuLieu();
        _ = InvokeAsync(StateHasChanged);
    }

    private void NapDuLieu()
    {
        danhSachBaoDuong = maintenanceService.GetAll();
        danhSachXe = vehicleService.GetAll();
    }

    private async Task MoFormLapPhieu()
    {
        var result = await dialog.OpenAsync<MaintenanceEditDialog>(
            "Lập phiếu bảo dưỡng / sửa chữa kỹ thuật",
            null,
            new DialogOptions { Width = "800px", Resizable = true, Draggable = true }
        );

        if (result == true)
        {
            NapDuLieu();
            thongBao = "Đã lập hồ sơ bảo dưỡng kỹ thuật phương tiện thành công!";
            coLoi = false;
        }
    }

    private async Task MoNghiemThu(MaintenanceRecord item)
    {
        var result = await dialog.OpenAsync<MaintenanceAcceptanceDialog>(
            $"Nghiệm thu xuất xưởng bảo dưỡng — Phiếu #{item.Id}",
            new Dictionary<string, object?> { { "Record", item } },
            new DialogOptions { Width = "720px", Resizable = true, Draggable = true }
        );

        if (result == true)
        {
            NapDuLieu();
            thongBao = $"Đã nghiệm thu hồ sơ bảo dưỡng #{item.Id} thành công. Phương tiện đã được đưa về trạng thái Sẵn sàng!";
            coLoi = false;
        }
    }

    private async Task XemChiTietBaoDuong(MaintenanceRecord item)
    {
        await dialog.OpenAsync<MaintenanceDetailDialog>(
            $"Chi tiết hồ sơ bảo dưỡng kỹ thuật: #{item.Id}",
            new Dictionary<string, object?> { { "Record", item } },
            new DialogOptions { Width = "760px", Resizable = true, Draggable = true }
        );
    }

    public void Dispose()
    {
        authService.UserChanged -= CapNhatTrang;
    }
}
