@page "/login"
@rendermode InteractiveServer
@layout MyWebApp.Components.Layout.EmptyLayout

@inject AuthService authService
@inject NavigationManager nav

<PageTitle>Đăng nhập - Học viện An ninh Nhân dân</PageTitle>

<div class="login-wrapper">
    <div class="login-box">
        <div class="login-header">
            <img src="/logo-hvannd.png" alt="Logo Học viện An ninh Nhân dân" class="login-logo" />
            <h1>HỌC VIỆN AN NINH NHÂN DÂN</h1>
            <p>HỆ THỐNG QUẢN LÝ PHƯƠNG TIỆN CÔNG VỤ</p>
        </div>

        @if (!string.IsNullOrEmpty(thongBaoLoi))
        {
            <div class="alert alert-danger py-2 small d-flex align-items-center gap-2 mb-3">
                <RadzenIcon Icon="error" Style="font-size: 1.1rem;" />
                <div>@thongBaoLoi</div>
            </div>
        }

        <div class="mb-3">
            <label class="form-label small fw-bold text-secondary mb-1">Tên đăng nhập</label>
            <div class="input-group">
                <span class="input-group-text bg-light text-muted">
                    <RadzenIcon Icon="person" Style="font-size: 1rem;" />
                </span>
                <input type="text" class="form-control" @bind="tenDangNhap" @bind:event="oninput" placeholder="Nhập tên đăng nhập..." />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label small fw-bold text-secondary mb-1">Mật khẩu</label>
            <div class="input-group">
                <span class="input-group-text bg-light text-muted">
                    <RadzenIcon Icon="lock" Style="font-size: 1rem;" />
                </span>
                <input type="password" class="form-control" @bind="matKhau" @bind:event="oninput" @onkeydown="NhanEnter" placeholder="Nhập mật khẩu..." />
            </div>
        </div>

        <button class="btn btn-primary-action w-100 py-2 justify-content-center" @onclick="DangNhap" disabled="@dangXuLy">
            @if (dangXuLy)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                <span>Đang xác thực...</span>
            }
            else
            {
                <RadzenIcon Icon="login" Style="vertical-align: middle; margin-right: 6px;" />
                <span>Đăng nhập hệ thống</span>
            }
        </button>

        <div class="login-hint">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="fw-bold" style="font-size: 0.75rem;">CHỌN NHANH TÀI KHOẢN MẪU:</span>
                <span class="text-muted" style="font-size: 0.7rem;">Mật khẩu: 123</span>
            </div>
            <div class="login-quick-roles">
                <button type="button" class="login-role-chip" @onclick='() => ChonNhanhTaiKhoan("canbo")'>
                    👮 Cán bộ
                </button>
                <button type="button" class="login-role-chip" @onclick='() => ChonNhanhTaiKhoan("lanhdao")'>
                    ⭐ Lãnh đạo
                </button>
                <button type="button" class="login-role-chip" @onclick='() => ChonNhanhTaiKhoan("doixe")'>
                    🚗 Đội xe
                </button>
                <button type="button" class="login-role-chip" @onclick='() => ChonNhanhTaiKhoan("admin")'>
                    🛡️ Quản trị viên
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    string tenDangNhap = "";
    string matKhau = "";
    string thongBaoLoi = "";
    bool dangXuLy = false;

    protected override void OnInitialized()
    {
        // Nếu đã đăng nhập rồi thì chuyển thẳng vào trang chủ.
        if (authService.DaDangNhap)
        {
            nav.NavigateTo("/");
        }
    }

    private void ChonNhanhTaiKhoan(string user)
    {
        tenDangNhap = user;
        matKhau = "123";
        thongBaoLoi = "";
    }

    private async Task NhanEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await DangNhap();
        }
    }

    private async Task DangNhap()
    {
        thongBaoLoi = "";

        if (string.IsNullOrWhiteSpace(tenDangNhap))
        {
            thongBaoLoi = "Vui lòng nhập tên đăng nhập.";
            return;
        }

        if (string.IsNullOrWhiteSpace(matKhau))
        {
            thongBaoLoi = "Vui lòng nhập mật khẩu.";
            return;
        }

        dangXuLy = true;

        // Tạm dừng ngắn để tránh cảm giác bấm không có phản hồi.
        await Task.Delay(200);

        string loi = authService.DangNhap(tenDangNhap, matKhau);

        if (!string.IsNullOrEmpty(loi))
        {
            thongBaoLoi = loi;
            dangXuLy = false;
            return;
        }

        nav.NavigateTo("/");
    }
}
