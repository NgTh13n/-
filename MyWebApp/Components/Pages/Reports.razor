@page "/reports"
@rendermode InteractiveServer

@using MyWebApp.Models
@using MyWebApp.Models.Enums
@using MyWebApp.Helpers
@using System.Text

@inject MockDataService mockDataService
@inject AuthService authService
@inject IJSRuntime js
@inject NotificationService notificationService

<PageTitle>Báo cáo & Thống kê Nghiệp vụ CAND</PageTitle>

@if (!authService.DaDangNhap)
{
    <div class="alert alert-warning">
        Vui lòng đăng nhập để xem báo cáo thống kê.
    </div>
}
else
{
    <div class="page-header-box">
        <div>
            <h1 class="page-header-title">
                <RadzenIcon Icon="bar_chart" Style="color: var(--brand-navy);" />
                Báo cáo & Thống kê phương tiện công vụ
            </h1>
            <p class="page-header-desc">Tổng hợp hiệu suất sử dụng, định mức nhiên liệu, biểu mẫu hành chính A4 và xuất dữ liệu</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-secondary-action" @onclick="XuatFileCsv">
                <RadzenIcon Icon="file_download" Style="vertical-align: middle; margin-right: 4px;" />
                Xuất file Excel / CSV
            </button>
            <button class="btn btn-primary-action" @onclick="XuatBaoCaoWord">
                <RadzenIcon Icon="description" Style="vertical-align: middle; margin-right: 4px;" />
                Xuất file Word Báo cáo (Chuẩn A4)
            </button>
        </div>
    </div>

    @* 4 THẺ CHỈ SỐ NHANH (PHẲNG, GỌN, CHÍNH QUY) *@
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-sm-6">
            <div class="kpi-card">
                <div>
                    <div class="kpi-label">Tổng số chuyến phục vụ</div>
                    <div class="kpi-value text-primary">@danhSachChuyenDaLoc.Count</div>
                    <div class="kpi-subtext">Quyết toán: @danhSachChuyenDaLoc.Count(t => t.IsSettled) chuyến</div>
                </div>
                <div class="kpi-icon-wrapper text-primary" style="background-color: #eff6ff;">
                    <RadzenIcon Icon="commute" Style="font-size: 1.5rem;" />
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="kpi-card">
                <div>
                    <div class="kpi-label">Tổng km hành trình</div>
                    <div class="kpi-value text-success">@tongQuangDuong.ToString("N0")</div>
                    <div class="kpi-subtext">Đã hoàn thành nghiệm thu</div>
                </div>
                <div class="kpi-icon-wrapper text-success" style="background-color: #ecfdf5;">
                    <RadzenIcon Icon="navigation" Style="font-size: 1.5rem;" />
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="kpi-card">
                <div>
                    <div class="kpi-label">Nhiên liệu tiêu thụ</div>
                    <div class="kpi-value text-warning">@tongNhienLieu.ToString("N1") L</div>
                    <div class="kpi-subtext">Mức TB: @(tongQuangDuong > 0 ? (tongNhienLieu / tongQuangDuong * 100).ToString("N1") : "0") L/100km</div>
                </div>
                <div class="kpi-icon-wrapper text-warning" style="background-color: #fffbeb;">
                    <RadzenIcon Icon="local_gas_station" Style="font-size: 1.5rem;" />
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="kpi-card">
                <div>
                    <div class="kpi-label">Tỷ lệ cán bộ tự lái</div>
                    <div class="kpi-value text-info">@($"{((double)danhSachChuyenDaLoc.Count(t => t.DriverMode == DriverMode.SelfDrive) / Math.Max(1, danhSachChuyenDaLoc.Count) * 100):N0}%")</div>
                    <div class="kpi-subtext">An toàn tác chiến 100%</div>
                </div>
                <div class="kpi-icon-wrapper">
                    <RadzenIcon Icon="person" Style="font-size: 1.5rem;" />
                </div>
            </div>
        </div>
    </div>

    @* TABS BÁO CÁO ĐẦU RA *@
    <RadzenTabs TabPosition="TabPosition.Top" Class="shadow-sm border rounded bg-white">
        <Tabs>
            @* TAB 1: HIỆU SUẤT TỪNG PHƯƠNG TIỆN *@
            <RadzenTabsItem Text="Báo cáo Tần suất & Hiệu suất Phương tiện">
                <div class="p-3">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold text-secondary mb-0">Bảng theo dõi định mức và hoạt động của 8 phương tiện CAND</h5>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover table-bordered align-middle">
                            <thead class="table-light small text-center">
                                <tr>
                                    <th>STT</th>
                                    <th>Biển số xe</th>
                                    <th>Chủng loại & Model</th>
                                    <th>Số chỗ / Tải trọng</th>
                                    <th>Odometer hiện tại</th>
                                    <th>Số chuyến phục vụ</th>
                                    <th>Tổng km vận hành</th>
                                    <th>Nhiên liệu tiêu thụ</th>
                                    <th>Định mức bình quân</th>
                                    <th>Hiện trạng</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int stt = 1; }
                                @foreach (var xe in mockDataService.Vehicles)
                                {
                                    var chuyenCuaXe = mockDataService.Trips.Where(t => t.VehicleId == xe.Id).ToList();
                                    double kmChay = chuyenCuaXe.Where(t => t.IsSettled).Sum(t => Math.Max(0, t.EndKm - t.StartKm));
                                    double xangTieuThu = chuyenCuaXe.Where(t => t.IsSettled).Sum(t => t.FuelUsed);
                                    double dinhMuc = kmChay > 0 ? (xangTieuThu / kmChay * 100) : 0;

                                    <tr>
                                        <td class="text-center">@(stt++)</td>
                                        <td class="text-center fw-bold">@xe.LicensePlate</td>
                                        <td>@xe.Brand @xe.Model (@EnumHelper.TenVehicleType(xe.VehicleType))</td>
                                        <td class="text-center">@xe.Seats chỗ</td>
                                        <td class="text-end fw-bold">@xe.CurrentKm.ToString("N0") km</td>
                                        <td class="text-center"><span class="badge bg-primary">@chuyenCuaXe.Count</span></td>
                                        <td class="text-end text-success fw-bold">@kmChay.ToString("N0") km</td>
                                        <td class="text-end text-warning fw-bold">@xangTieuThu.ToString("N1") L</td>
                                        <td class="text-end">@(dinhMuc > 0 ? $"{dinhMuc:N1} L/100km" : "Chưa có")</td>
                                        <td class="text-center">
                                            <span class="badge-status @xe.Status.BadgeClass()">
                                                @xe.Status.Ten()
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </RadzenTabsItem>

            @* TAB 2: SỔ NHẬT TRÌNH CÁC CHUYẾN ĐI *@
            <RadzenTabsItem Text="Sổ Nhật trình Điều động Phương tiện">
                <div class="p-3">
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Lọc theo phương tiện</label>
                            <select class="form-select form-select-sm" @bind="xeLocId">
                                <option value="0">-- Tất cả 8 phương tiện --</option>
                                @foreach (var x in mockDataService.Vehicles)
                                {
                                    <option value="@x.Id">@x.LicensePlate - @x.Brand @x.Model</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Phương án lái xe</label>
                            <select class="form-select form-select-sm" @bind="phuongAnLaiLoc">
                                <option value="-1">-- Tất cả phương án --</option>
                                <option value="@((int)DriverMode.AssignedDriver)">Lái xe đơn vị bố trí</option>
                                <option value="@((int)DriverMode.SelfDrive)">Cán bộ tự lái</option>
                            </select>
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <RadzenButton Text="Đặt lại bộ lọc" Icon="refresh" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="DatLaiLoc" />
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover table-bordered align-middle">
                            <thead class="table-light small text-center">
                                <tr>
                                    <th>Mã lệnh LĐĐ</th>
                                    <th>Biển số</th>
                                    <th>Phương án & Người lái</th>
                                    <th>Điểm đến / Nhiệm vụ</th>
                                    <th>Thời gian xuất &rarr; về</th>
                                    <th>Km đi &rarr; về</th>
                                    <th>Quãng đường</th>
                                    <th>Nhiên liệu</th>
                                    <th>Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (danhSachChuyenDaLoc.Count == 0)
                                {
                                    <tr>
                                        <td colspan="9" class="text-center text-muted p-4">
                                            Không tìm thấy chuyến công tác nào theo bộ lọc này.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var t in danhSachChuyenDaLoc)
                                    {
                                        var xe = mockDataService.Vehicles.FirstOrDefault(v => v.Id == t.VehicleId);
                                        var don = mockDataService.Bookings.FirstOrDefault(b => b.Id == t.BookingId);
                                        var lx = mockDataService.Drivers.FirstOrDefault(d => d.Id == t.DriverId);
                                        double qd = Math.Max(0, t.EndKm - t.StartKm);

                                        <tr>
                                            <td class="text-center fw-bold">@t.DispatchCode</td>
                                            <td class="text-center">
                                                <span class="badge bg-dark">@(xe?.LicensePlate ?? t.VehiclePlateSnapshot)</span>
                                            </td>
                                            <td>
                                                @if (t.DriverMode == DriverMode.SelfDrive)
                                                {
                                                    <span class="badge bg-info text-dark">Tự lái</span>
                                                    <span class="ms-1 small">@(string.IsNullOrEmpty(t.DriverNameSnapshot) ? "Cán bộ tự lái" : t.DriverNameSnapshot)</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Tài xế</span>
                                                    <span class="ms-1 small">@(lx?.FullName ?? (string.IsNullOrEmpty(t.DriverNameSnapshot) ? "Lái xe đơn vị" : t.DriverNameSnapshot))</span>
                                                }
                                            </td>
                                            <td>
                                                <strong>@don?.Destination</strong>
                                                <div class="small text-muted">@don?.WorkType</div>
                                            </td>
                                            <td class="small text-center">
                                                @(t.ActualDeparture?.ToString("dd/MM HH:mm") ?? t.ScheduledStartAt.ToString("dd/MM HH:mm"))
                                                <br />&darr;<br />
                                                @(t.ActualReturn?.ToString("dd/MM HH:mm") ?? t.ScheduledEndAt.ToString("dd/MM HH:mm"))
                                            </td>
                                            <td class="small text-end">
                                                @t.StartKm.ToString("N0") &rarr; @(t.EndKm > 0 ? t.EndKm.ToString("N0") : "...") km
                                            </td>
                                            <td class="text-end fw-bold text-success">
                                                @(qd > 0 ? $"{qd:N0} km" : "-")
                                            </td>
                                            <td class="text-end text-warning fw-bold">
                                                @(t.FuelUsed > 0 ? $"{t.FuelUsed:N1} L" : "-")
                                            </td>
                                            <td class="text-center">
                                                @if (t.IsSettled)
                                                {
                                                    <span class="badge bg-success">Đã quyết toán</span>
                                                }
                                                else if (t.Status == TripStatus.InTransit)
                                                {
                                                    <span class="badge bg-primary">Đang di chuyển</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-info text-dark">@EnumHelper.TenTripStatus(t.Status)</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </RadzenTabsItem>

            @* TAB 3: THỐNG KÊ THEO ĐƠN VỊ SỬ DỤNG *@
            <RadzenTabsItem Text="Thống kê theo Đơn vị / Phòng ban">
                <div class="p-3">
                    <h5 class="fw-bold text-secondary mb-3">Tần suất và khối lượng công tác của các đơn vị trực thuộc Học viện</h5>
                    <div class="table-responsive">
                        <table class="table table-hover table-bordered align-middle">
                            <thead class="table-light small text-center">
                                <tr>
                                    <th>STT</th>
                                    <th>Đơn vị / Phòng ban</th>
                                    <th>Số lượt đăng ký</th>
                                    <th>Số chuyến hoàn thành</th>
                                    <th>Tổng km phục vụ</th>
                                    <th>Tổng nhiên liệu (lít)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int sttDv = 1;
                                    var danhSachPhongBan = mockDataService.Officers.Select(o => o.Department).Distinct().ToList();
                                }
                                @foreach (var dv in danhSachPhongBan)
                                {
                                    var officerIds = mockDataService.Officers.Where(o => o.Department == dv).Select(o => o.Id).ToList();
                                    var bookingsCuaDv = mockDataService.Bookings.Where(b => officerIds.Contains(b.RequesterId)).ToList();
                                    var bookingIds = bookingsCuaDv.Select(b => b.Id).ToList();
                                    var tripsCuaDv = mockDataService.Trips.Where(t => bookingIds.Contains(t.BookingId)).ToList();
                                    double kmDv = tripsCuaDv.Where(t => t.IsSettled).Sum(t => Math.Max(0, t.EndKm - t.StartKm));
                                    double nhienLieuDv = tripsCuaDv.Where(t => t.IsSettled).Sum(t => t.FuelUsed);

                                    <tr>
                                        <td class="text-center">@(sttDv++)</td>
                                        <td><strong>@dv</strong></td>
                                        <td class="text-center"><span class="badge bg-primary">@bookingsCuaDv.Count</span></td>
                                        <td class="text-center"><span class="badge bg-success">@tripsCuaDv.Count(t => t.Status == TripStatus.Completed || t.Status == TripStatus.Returned || t.IsSettled)</span></td>
                                        <td class="text-end fw-bold text-success">@kmDv.ToString("N0") km</td>
                                        <td class="text-end fw-bold text-warning">@nhienLieuDv.ToString("N1") L</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
}

@code {
    int xeLocId = 0;
    int phuongAnLaiLoc = -1;

    private List<Trip> danhSachChuyenDaLoc
    {
        get
        {
            var res = mockDataService.Trips.AsEnumerable();

            if (xeLocId > 0)
            {
                res = res.Where(t => t.VehicleId == xeLocId);
            }

            if (phuongAnLaiLoc != -1)
            {
                DriverMode dm = (DriverMode)phuongAnLaiLoc;
                res = res.Where(t => t.DriverMode == dm);
            }

            return res.OrderByDescending(t => t.Id).ToList();
        }
    }

    private double tongQuangDuong
    {
        get => danhSachChuyenDaLoc.Where(t => t.IsSettled).Sum(t => Math.Max(0, t.EndKm - t.StartKm));
    }

    private double tongNhienLieu
    {
        get => danhSachChuyenDaLoc.Where(t => t.IsSettled).Sum(t => t.FuelUsed);
    }

    private void DatLaiLoc()
    {
        xeLocId = 0;
        phuongAnLaiLoc = -1;
    }

    private async Task XuatBaoCaoWord()
    {
        try
        {
            var sb = new StringBuilder();
            sb.AppendLine("<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>");
            sb.AppendLine("<head>");
            sb.AppendLine("<meta charset='utf-8'>");
            sb.AppendLine("<title>Báo cáo CAND</title>");
            sb.AppendLine("<!--[if gte mso 9]>");
            sb.AppendLine("<xml>");
            sb.AppendLine("<w:WordDocument>");
            sb.AppendLine("<w:View>Print</w:View>");
            sb.AppendLine("<w:Zoom>100</w:Zoom>");
            sb.AppendLine("<w:DoNotOptimizeForBrowser/>");
            sb.AppendLine("</w:WordDocument>");
            sb.AppendLine("</xml>");
            sb.AppendLine("<![endif]-->");
            sb.AppendLine("<style>");
            sb.AppendLine("@page Section1 { size: 21.0cm 29.7cm; margin: 2.0cm 2.0cm 2.0cm 2.5cm; mso-header-margin: 36.0pt; mso-footer-margin: 36.0pt; mso-paper-source: 0; }");
            sb.AppendLine("div.Section1 { page: Section1; }");
            sb.AppendLine("body { font-family: 'Times New Roman', serif; font-size: 13pt; line-height: 1.35; color: #000000; }");
            sb.AppendLine("table { border-collapse: collapse; width: 100%; }");
            sb.AppendLine("th, td { border: 1px solid #000; padding: 6px; font-size: 12pt; }");
            sb.AppendLine(".table-borderless, .table-borderless th, .table-borderless td { border: none !important; }");
            sb.AppendLine(".text-center { text-align: center; }");
            sb.AppendLine(".text-right { text-align: right; }");
            sb.AppendLine(".text-justify { text-align: justify; }");
            sb.AppendLine(".fw-bold { font-weight: bold; }");
            sb.AppendLine(".fst-italic { font-style: italic; }");
            sb.AppendLine(".text-uppercase { text-transform: uppercase; }");
            sb.AppendLine("</style>");
            sb.AppendLine("</head>");
            sb.AppendLine("<body>");
            sb.AppendLine("<div class='Section1'>");

            // Quốc hiệu tiêu ngữ
            sb.AppendLine("<table class='table-borderless' style='width: 100%; margin-bottom: 25px;'>");
            sb.AppendLine("<tr>");
            sb.AppendLine("<td style='width: 45%; text-align: center; vertical-align: top;'>");
            sb.AppendLine("<div style='font-size: 12pt; font-weight: bold;'>BỘ CÔNG AN</div>");
            sb.AppendLine("<div style='font-size: 12pt; font-weight: bold; text-decoration: underline;'>HỌC VIỆN AN NINH NHÂN DÂN</div>");
            sb.AppendLine("<div style='font-size: 11pt; margin-top: 4px;'>Số: 86/BC-HVANND-HC</div>");
            sb.AppendLine("</td>");
            sb.AppendLine("<td style='width: 55%; text-align: center; vertical-align: top;'>");
            sb.AppendLine("<div style='font-size: 12pt; font-weight: bold;'>CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</div>");
            sb.AppendLine("<div style='font-size: 12pt; font-weight: bold; text-decoration: underline;'>Độc lập - Tự do - Hạnh phúc</div>");
            sb.AppendLine($"<div style='font-size: 11pt; font-style: italic; margin-top: 4px;'>Hà Nội, ngày {DateTime.Today.Day} tháng {DateTime.Today.Month} năm {DateTime.Today.Year}</div>");
            sb.AppendLine("</td>");
            sb.AppendLine("</tr>");
            sb.AppendLine("</table>");

            // Tiêu đề
            sb.AppendLine("<div style='text-align: center; margin-bottom: 25px;'>");
            sb.AppendLine("<h2 style='font-size: 15pt; font-weight: bold; margin-bottom: 6px; text-transform: uppercase;'>BÁO CÁO TỔNG HỢP</h2>");
            sb.AppendLine("<h3 style='font-size: 13pt; font-weight: bold; margin-bottom: 6px;'>TÌNH HÌNH QUẢN LÝ, ĐIỀU ĐỘNG VÀ SỬ DỤNG PHƯƠNG TIỆN CÔNG VỤ</h3>");
            sb.AppendLine("<div style='font-size: 11pt; font-style: italic;'>(Phục vụ công tác thường xuyên và nghiệp vụ đột xuất của Học viện)</div>");
            sb.AppendLine("</div>");

            // Phần I
            sb.AppendLine("<p><strong>I. TÌNH HÌNH QUÂN SỐ VÀ PHƯƠNG TIỆN BIÊN CHẾ:</strong></p>");
            sb.AppendLine("<ul>");
            sb.AppendLine($"<li>Tổng số phương tiện quản lý: <strong>{mockDataService.Vehicles.Count} xe</strong> (bao gồm ô tô con chuyên chở chỉ huy, xe bán tải nghiệp vụ, mô tô đặc chủng).</li>");
            sb.AppendLine($"<li>Tổng số cán bộ lái xe biên chế: <strong>{mockDataService.Drivers.Count} đồng chí</strong>.</li>");
            sb.AppendLine($"<li>Tình trạng kỹ thuật: <strong>{mockDataService.Vehicles.Count(x => x.Status == VehicleStatus.SanSang)} xe</strong> sẵn sàng tác chiến, <strong>{mockDataService.Vehicles.Count(x => x.Status == VehicleStatus.DangBaoDuong)} xe</strong> đang bảo dưỡng xưởng định kỳ.</li>");
            sb.AppendLine("</ul>");

            // Phần II
            sb.AppendLine("<p><strong>II. KẾT QUẢ ĐIỀU ĐỘNG CÔNG TÁC TRONG KỲ:</strong></p>");
            sb.AppendLine("<table style='width: 100%; border: 1px solid #000; text-align: center; margin-bottom: 15px;'>");
            sb.AppendLine("<thead>");
            sb.AppendLine("<tr style='background-color: #f2f2f2;'>");
            sb.AppendLine("<th>Tổng số chuyến</th>");
            sb.AppendLine("<th>Tổng km vận hành</th>");
            sb.AppendLine("<th>Nhiên liệu tiêu thụ</th>");
            sb.AppendLine("<th>Tỷ lệ cán bộ tự lái</th>");
            sb.AppendLine("<th>Tỷ lệ an toàn</th>");
            sb.AppendLine("</tr>");
            sb.AppendLine("</thead>");
            sb.AppendLine("<tbody>");
            sb.AppendLine("<tr>");
            sb.AppendLine($"<td style='font-weight: bold;'>{mockDataService.Trips.Count}</td>");
            sb.AppendLine($"<td style='font-weight: bold;'>{tongQuangDuong:N0} km</td>");
            sb.AppendLine($"<td style='font-weight: bold;'>{tongNhienLieu:N1} lít</td>");
            sb.AppendLine($"<td style='font-weight: bold;'>{(mockDataService.Trips.Count > 0 ? (double)mockDataService.Trips.Count(t => t.DriverMode == DriverMode.SelfDrive) / mockDataService.Trips.Count * 100 : 0):N0}%</td>");
            sb.AppendLine("<td style='font-weight: bold; color: #15803d;'>100%</td>");
            sb.AppendLine("</tr>");
            sb.AppendLine("</tbody>");
            sb.AppendLine("</table>");

