            sb.AppendLine("<thead>");
            sb.AppendLine("<tr style='background-color: #f2f2f2; text-align: center;'>");
            sb.AppendLine("<th style='width: 40px;'>STT</th>");
            sb.AppendLine("<th style='width: 95px;'>Mã lệnh</th>");
            sb.AppendLine("<th style='width: 90px;'>Phương tiện</th>");
            sb.AppendLine("<th>Người điều khiển</th>");
            sb.AppendLine("<th>Điểm đến / Mục đích</th>");
            sb.AppendLine("<th style='width: 75px;'>Quãng đường</th>");
            sb.AppendLine("<th style='width: 70px;'>Nhiên liệu</th>");
            sb.AppendLine("<th style='width: 90px;'>Trạng thái</th>");
            sb.AppendLine("</tr>");
            sb.AppendLine("</thead>");
            sb.AppendLine("<tbody>");
            int sttTrip = 1;
            foreach (var t in danhSachChuyenDaLoc)
            {
                var xe = mockDataService.Vehicles.FirstOrDefault(v => v.Id == t.VehicleId);
                var don = mockDataService.Bookings.FirstOrDefault(b => b.Id == t.BookingId);
                var lx = mockDataService.Drivers.FirstOrDefault(d => d.Id == t.DriverId);
                string nguoiLai = t.DriverMode == DriverMode.SelfDrive
                    ? (string.IsNullOrEmpty(t.DriverNameSnapshot) ? "Cán bộ tự lái" : t.DriverNameSnapshot)
                    : (lx?.FullName ?? (string.IsNullOrEmpty(t.DriverNameSnapshot) ? "Lái xe ĐV" : t.DriverNameSnapshot));
                double qd = Math.Max(0, t.EndKm - t.StartKm);

                sb.AppendLine("<tr>");
                sb.AppendLine($"<td style='text-align: center;'>{sttTrip++}</td>");
                sb.AppendLine($"<td style='font-weight: bold; text-align: center;'>{t.DispatchCode}</td>");
                sb.AppendLine($"<td style='text-align: center;'>{xe?.LicensePlate ?? t.VehiclePlateSnapshot}</td>");
                sb.AppendLine($"<td>{nguoiLai}</td>");
                sb.AppendLine($"<td>{don?.Destination} ({don?.Purpose})</td>");
                sb.AppendLine($"<td style='text-align: right; font-weight: bold;'>{(qd > 0 ? $"{qd:N0} km" : "-")}</td>");
                sb.AppendLine($"<td style='text-align: right;'>{(t.FuelUsed > 0 ? $"{t.FuelUsed:N1} L" : "-")}</td>");
                sb.AppendLine($"<td style='text-align: center;'>{(t.IsSettled ? "Đã quyết toán" : EnumHelper.TenTripStatus(t.Status))}</td>");
                sb.AppendLine("</tr>");
            }
            sb.AppendLine("</tbody>");
            sb.AppendLine("</table>");

            // Phần III
            sb.AppendLine("<p><strong>III. ĐÁNH GIÁ CHẤP HÀNH KỶ LUẬT VÀ AN NINH AN TOÀN:</strong></p>");
            sb.AppendLine("<p style='text-align: justify; text-indent: 1.27cm;'>");
            sb.AppendLine("100% các chuyến công tác đều có kế hoạch được Lãnh đạo đơn vị phê duyệt và thực hiện thủ tục bàn giao, nghiệm thu theo đúng quy trình của Bộ Công an. ");
            sb.AppendLine("Hệ thống đã kiểm soát chặt chẽ điều kiện người lái (kiểm tra hạn GPLX, phân quyền cán bộ tự lái) và ngăn chặn hoàn toàn các trường hợp vi phạm an toàn kỹ thuật.");
            sb.AppendLine("</p>");

            // Phần IV
            sb.AppendLine("<p><strong>IV. KIẾN NGHỊ VÀ ĐỀ XUẤT:</strong></p>");
            sb.AppendLine("<p style='text-align: justify; text-indent: 1.27cm;'>");
            sb.AppendLine("Tiếp tục duy trì nghiêm chế độ bảo dưỡng định kỳ theo số km vận hành của phương tiện; tăng cường công tác kiểm tra kỹ thuật an toàn trước khi xuất bãi; tổ chức tập huấn nâng cao nghiệp vụ lái xe an toàn cho cán bộ, chiến sĩ trong tình huống tác chiến đặc thù.");
            sb.AppendLine("</p>");

            // Chữ ký
            sb.AppendLine("<table class='table-borderless' style='width: 100%; margin-top: 40px; text-align: center;'>");
            sb.AppendLine("<tr>");
            sb.AppendLine("<td style='width: 33%; vertical-align: top;'>");
            sb.AppendLine("<div style='font-weight: bold;'>NGƯỜI LẬP BIỂU</div>");
            sb.AppendLine("<div style='font-style: italic; font-size: 11pt;'>(Ký, ghi rõ họ tên)</div>");
            sb.AppendLine("<div style='height: 75px;'></div>");
            sb.AppendLine($"<div style='font-weight: bold;'>{authService.CurrentUser?.FullName ?? "Cán bộ quản lý"}</div>");
            sb.AppendLine("</td>");
            sb.AppendLine("<td style='width: 33%; vertical-align: top;'>");
            sb.AppendLine("<div style='font-weight: bold;'>ĐỘI TRƯỞNG ĐỘI XE</div>");
            sb.AppendLine("<div style='font-style: italic; font-size: 11pt;'>(Ký, ghi rõ họ tên)</div>");
            sb.AppendLine("<div style='height: 75px;'></div>");
            sb.AppendLine("<div style='font-weight: bold;'>Trung tá Trần Văn Bình</div>");
            sb.AppendLine("</td>");
            sb.AppendLine("<td style='width: 34%; vertical-align: top;'>");
            sb.AppendLine("<div style='font-weight: bold;'>GIÁM ĐỐC HỌC VIỆN</div>");
            sb.AppendLine("<div style='font-style: italic; font-size: 11pt;'>(Ký, đóng dấu)</div>");
            sb.AppendLine("<div style='height: 75px;'></div>");
            sb.AppendLine("<div style='font-weight: bold;'>Thiếu tướng GS.TS Nguyễn Văn An</div>");
            sb.AppendLine("</td>");
            sb.AppendLine("</tr>");
            sb.AppendLine("</table>");

            sb.AppendLine("</div>");
            sb.AppendLine("</body>");
            sb.AppendLine("</html>");

            string filename = $"BaoCao_HanhChinh_CAND_{DateTime.Now:yyyyMMdd_HHmm}.doc";
            await js.InvokeVoidAsync("downloadWordFile", filename, sb.ToString());

            notificationService.Notify(NotificationSeverity.Success, "Xuất file Word thành công", $"Đã tạo và tải về văn bản {filename} theo đúng thể thức hành chính CAND!", 4500);
        }
        catch (Exception ex)
        {
            notificationService.Notify(NotificationSeverity.Error, "Lỗi xuất file Word", ex.Message, 4000);
        }
    }

    private async Task XuatFileCsv()
    {
        try
        {
            var sb = new StringBuilder();
            sb.AppendLine("Mã lệnh điều động,Biển số xe,Loại xe,Phương án lái,Người lái xe,Điểm đến,Thời gian xuất phát,Thời gian hoàn thành,Km xuất phát,Km kết thúc,Quãng đường (km),Nhiên liệu tiêu thụ (lít),Trạng thái quyết toán");

            foreach (var t in danhSachChuyenDaLoc)
            {
                var xe = mockDataService.Vehicles.FirstOrDefault(v => v.Id == t.VehicleId);
                var don = mockDataService.Bookings.FirstOrDefault(b => b.Id == t.BookingId);
                var lx = mockDataService.Drivers.FirstOrDefault(d => d.Id == t.DriverId);

                string nguoiLai = t.DriverMode == DriverMode.SelfDrive
                    ? (string.IsNullOrEmpty(t.DriverNameSnapshot) ? "Cán bộ tự lái" : t.DriverNameSnapshot)
                    : (lx?.FullName ?? (string.IsNullOrEmpty(t.DriverNameSnapshot) ? "Lái xe đơn vị" : t.DriverNameSnapshot));

                string phuongAn = t.DriverMode == DriverMode.SelfDrive ? "Cán bộ tự lái" : "Lái xe đơn vị";
                double qd = Math.Max(0, t.EndKm - t.StartKm);

                sb.AppendLine($"\"{t.DispatchCode}\",\"{xe?.LicensePlate ?? t.VehiclePlateSnapshot}\",\"{xe?.Brand} {xe?.Model}\",\"{phuongAn}\",\"{nguoiLai}\",\"{don?.Destination}\",\"{t.ActualDeparture:dd/MM/yyyy HH:mm}\",\"{t.ActualReturn:dd/MM/yyyy HH:mm}\",{t.StartKm},{t.EndKm},{qd},{t.FuelUsed},\"{(t.IsSettled ? "Đã quyết toán" : "Chưa")}\"");
            }

            string filename = $"BaoCao_DieuDongXe_HVANND_{DateTime.Now:yyyyMMdd_HHmm}.csv";
            await js.InvokeVoidAsync("downloadCsvFile", filename, sb.ToString());

            notificationService.Notify(NotificationSeverity.Success, "Xuất báo cáo thành công", $"Đã tải về tệp {filename} định dạng UTF-8 CSV tương thích Excel!", 4000);
        }
        catch (Exception ex)
        {
            notificationService.Notify(NotificationSeverity.Error, "Lỗi xuất file", ex.Message, 4000);
        }
    }
