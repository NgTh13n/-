@using MyWebApp.Services.Models.CanBo
@inject DialogService dialog
<div class="row">
    <div class="col-3">
        <RadzenFormField Text="Họ và tên">
            <RadzenTextBox @bind-Value="@hocVien.HoTen" Style="width:100%" />
        </RadzenFormField>
    </div>
    <div class="col-3">
        <RadzenFormField Text="Ngày sinh">
            <RadzenDatePicker @bind-Value="@hocVien.NgaySinh"
                              ShowCalendarWeek="true" Style="width:100%" />
        </RadzenFormField>
    </div>
    <div class="col-3">
        <RadzenFormField Text="Lớp">
            <RadzenTextBox @bind-Value="@hocVien.Lop" Style="width:100%" />
        </RadzenFormField>
    </div>
    <div class="col-3">

        <RadzenFormField Text="Địa chỉ">
            <RadzenTextBox @bind-Value="@hocVien.DiaChiHienTai" Style="width:100%" />
        </RadzenFormField>
    </div>
</div>
<RadzenButton Shade="Shade.Light"
              Click=@(args => CloseAndSave())
              Text="Lưu dữ liệu"
              Icon="save"
              ButtonStyle="ButtonStyle.Primary"
              Style="margin-top:10px"/>
@code {
    [Parameter]
    public tbHocVien hocVien { get; set; }

    [Parameter]
    public EventCallback<tbHocVien> HocVienChanged{ get; set; }

    private async Task CloseAndSave()
    {
        await HocVienChanged.InvokeAsync(hocVien);

        dialog.Close(hocVien);
    }

}
