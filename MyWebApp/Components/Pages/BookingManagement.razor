@page "/bookings"
@rendermode InteractiveServer
@implements IDisposable

@using MyWebApp.Models
@using MyWebApp.Models.Enums
@using MyWebApp.Helpers
@using MyWebApp.Data

@inject BookingService bookingService
@inject DialogService dialog
@inject AuthService authService
@inject MockDataService mockDataService
@inject IJSRuntime js

<PageTitle>Đăng ký phương tiện</PageTitle>

@if (!authService.DaDangNhap)
{
    <div class="alert alert-warning shadow-sm">
        <RadzenIcon Icon="lock" Class="me-2" />
        Vui lòng đăng nhập để sử dụng chức năng đăng ký phương tiện công tác.
    </div>
}
else
{
    <div class="page-header-box">
        <div>
            <h1 class="page-header-title">
                <RadzenIcon Icon="assignment" Style="color: var(--brand-navy);" />
                Đăng ký sử dụng phương tiện công vụ
            </h1>
            <p class="page-header-desc">
                @(authService.CurrentUser?.Role == UserRole.Officer 
                    ? "Danh sách phiếu đăng ký sử dụng phương tiện công tác của đồng chí" 
                    : "Quản lý tiếp nhận và thẩm định yêu cầu sử dụng phương tiện toàn đơn vị")
            </p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-primary-action" @onclick="ThemMoi">
                <RadzenIcon Icon="add_circle" Class="me-1 align-middle" />
                Lập yêu cầu mới
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(thongBao))
    {
        <div class="alert @(coLoi ? "alert-danger" : "alert-success") alert-dismissible fade show shadow-sm" role="alert">
            <RadzenIcon Icon="@(coLoi ? "error" : "check_circle")" Class="me-2" />
            @thongBao
            <button type="button" class="btn-close" @onclick="() => thongBao = string.Empty"></button>
        </div>
    }

    @* HỘP THOẠI CHI TIẾT YÊU CẦU & AUDIT TRAIL *@
    @if (yeuCauDangXem != null)
    {
        <div id="chi-tiet-yeu-cau" class="gov-card gov-card-accent-primary mb-4">
            <div class="gov-card-header">
                <div class="gov-card-header-title">
                    <RadzenIcon Icon="description" />
                    Hồ sơ yêu cầu: @yeuCauDangXem.BookingCode
                </div>
                <button class="btn btn-sm btn-outline-secondary" @onclick="DongChiTiet">Đóng</button>
            </div>
            <div class="gov-card-body">
                <div class="row g-3">
                    <div class="col-md-3"><strong>Mã hồ sơ:</strong> <span class="badge bg-secondary">@yeuCauDangXem.BookingCode</span></div>
                    <div class="col-md-3"><strong>Người đề nghị:</strong> @bookingService.GetRequesterName(yeuCauDangXem.RequesterId)</div>
                    <div class="col-md-3"><strong>Bộ phận / Đội:</strong> @yeuCauDangXem.DepartmentSnapshot</div>
                    <div class="col-md-3">
                        <strong>Trạng thái:</strong> 
                        <span class="badge-status @yeuCauDangXem.Status.BadgeClass()">
                            @yeuCauDangXem.Status.Ten()
                        </span>
                    </div>

                    <div class="col-md-4"><strong>Mục đích:</strong> @yeuCauDangXem.Purpose</div>
                    <div class="col-md-4"><strong>Phân loại công tác:</strong> @yeuCauDangXem.WorkType</div>
                    <div class="col-md-4">
                        <strong>Phương án lái xe:</strong> 
                        <span class="badge @(yeuCauDangXem.PreferredDriverMode == DriverMode.SelfDrive ? "bg-info text-dark" : "bg-primary")">
                            <RadzenIcon Icon="@(yeuCauDangXem.PreferredDriverMode == DriverMode.SelfDrive ? "person" : "drive_eta")" Class="me-1" />
                            @EnumHelper.TenDriverMode(yeuCauDangXem.PreferredDriverMode)
                        </span>
                    </div>

                    @if (!string.IsNullOrEmpty(yeuCauDangXem.TaskDescription))
                    {
                        <div class="col-12">
                            <strong>Nội dung nhiệm vụ cụ thể:</strong>
                            <div class="p-2 bg-light rounded mt-1 border">@yeuCauDangXem.TaskDescription</div>
                        </div>
                    }

                    <div class="col-md-6"><strong>Nơi xuất phát:</strong> @yeuCauDangXem.Departure</div>
                    <div class="col-md-6"><strong>Nơi đến / Tuyến công tác:</strong> @yeuCauDangXem.Destination</div>

                    <div class="col-md-4"><strong>Khởi hành dự kiến:</strong> @yeuCauDangXem.DepartureTime.ToString("dd/MM/yyyy HH:mm")</div>
                    <div class="col-md-4"><strong>Trở về dự kiến:</strong> @yeuCauDangXem.ReturnTime.ToString("dd/MM/yyyy HH:mm")</div>
                    <div class="col-md-4"><strong>Số lượng người:</strong> @yeuCauDangXem.PassengerCount người (Loại xe: @yeuCauDangXem.RequestedVehicleType)</div>
                </div>

                @* Ý kiến chỉ đạo của Lãnh đạo *@
                @if (yeuCauDangXem.Status == BookingStatus.NeedAdjustment && !string.IsNullOrEmpty(yeuCauDangXem.NeedAdjustmentReason))
                {
                    <div class="alert alert-warning mt-3 mb-2 border-warning">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <RadzenIcon Icon="warning" Class="text-warning" />
                            <strong>Ý kiến chỉ đạo của Lãnh đạo (Yêu cầu bổ sung thông tin):</strong>
                        </div>
                        <div class="ps-4">@yeuCauDangXem.NeedAdjustmentReason</div>
                    </div>
                }

                @if (yeuCauDangXem.Status == BookingStatus.Rejected && !string.IsNullOrEmpty(yeuCauDangXem.RejectionReason))
                {
                    <div class="alert alert-danger mt-3 mb-2 border-danger">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <RadzenIcon Icon="cancel" Class="text-danger" />
                            <strong>Lý do Lãnh đạo từ chối phê duyệt:</strong>
                        </div>
                        <div class="ps-4">@yeuCauDangXem.RejectionReason</div>
                    </div>
                }

                @if (yeuCauDangXem.Status == BookingStatus.Approved && !string.IsNullOrEmpty(yeuCauDangXem.ApprovalComment))
                {
                    <div class="alert alert-info mt-3 mb-2 border-info">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <RadzenIcon Icon="check_circle" Class="text-info" />
                            <strong>Ý kiến chỉ đạo khi phê duyệt:</strong>
                        </div>
                        <div class="ps-4">@yeuCauDangXem.ApprovalComment</div>
                    </div>
                }

                @* Audit Trail: Lịch sử chuyển tiếp trạng thái *@
                <div class="mt-3 pt-2 border-top">
                    <h6 class="text-secondary mb-2"><RadzenIcon Icon="history" Class="me-1" /> Tiến trình xử lý (Audit Trail):</h6>
                    @{
                        var histories = mockDataService.StatusHistories
                            .Where(h => h.EntityType == "VehicleRequest" && h.EntityId == yeuCauDangXem.Id)
                            .OrderBy(h => h.ChangedAt)
                            .ToList();
                    }
                    @if (histories.Count > 0)
                    {
                        <ul class="list-group list-group-flush small">
                            @foreach (var h in histories)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-1">
                                    <div>
                                        <span class="text-muted me-2">@h.ChangedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                        <strong>@h.ChangedByFullName:</strong> @h.Comment
                                    </div>
                                    <span class="badge bg-light text-dark border">@h.ToStatus</span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <span class="text-muted small">Chưa có lịch sử chuyển tiếp cho yêu cầu này.</span>
                    }
                </div>
            </div>
        </div>
    }

    @* FORM LẬP / CHỈNH SỬA PHIẾU ĐĂNG KÝ *@
    <div id="form-dang-ky" class="gov-card mb-4">
        <div class="gov-card-header">
            <h2 class="gov-card-header-title">
                <RadzenIcon Icon="@(dangSua ? "edit" : "post_add")" Style="color: var(--brand-navy);" />
                @(dangSua ? $"Chỉnh sửa yêu cầu {yeuCau.BookingCode}" : "Lập phiếu đăng ký sử dụng phương tiện")
            </h2>
            @if (dangSua)
            {
                <button class="btn btn-sm btn-outline-secondary" @onclick="ThemMoi">Hủy sửa / Tạo mới</button>
            }
        </div>
        <div class="gov-card-body">
            @if (dangSua && yeuCau.Status == BookingStatus.NeedAdjustment && !string.IsNullOrEmpty(yeuCau.NeedAdjustmentReason))
            {
                <div class="alert alert-warning mb-3">
                    <strong><RadzenIcon Icon="priority_high" Class="me-1" /> Lưu ý chỉ đạo của Lãnh đạo:</strong>
                    <p class="mb-0 mt-1">@yeuCau.NeedAdjustmentReason</p>
                </div>
            }

            <EditForm Model="yeuCau" OnValidSubmit="XuLyLuu">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger mb-3" />

                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Phân loại công tác <span class="text-danger">*</span></label>
                        <InputSelect class="form-select" @bind-Value="yeuCau.WorkType">
                            <option value="Công tác địa bàn">Công tác địa bàn</option>
                            <option value="Tuần tra kiểm soát">Tuần tra kiểm soát</option>
                            <option value="Phối hợp phá án">Phối hợp phá án</option>
                            <option value="Áp giải đối tượng">Áp giải đối tượng</option>
                            <option value="Họp nghiệp vụ">Họp nghiệp vụ</option>
                            <option value="Đón tiếp đoàn">Đón tiếp đoàn</option>
                            <option value="Công tác đột xuất">Công tác đột xuất khác</option>
                        </InputSelect>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-bold">Phương án lái xe <span class="text-danger">*</span></label>
                        <InputSelect class="form-select" @bind-Value="yeuCau.PreferredDriverMode">
                            <option value="@DriverMode.AssignedDriver">Phân công Lái xe đơn vị</option>
                            <option value="@DriverMode.SelfDrive">Cán bộ trực tiếp tự lái</option>
                        </InputSelect>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-bold">Loại xe đề xuất <span class="text-danger">*</span></label>
                        <InputSelect class="form-select" @bind-Value="yeuCau.RequestedVehicleType">
                            <option value="Ô tô">Ô tô con (4 - 7 chỗ)</option>
                            <option value="Xe tải">Xe bán tải / Chuyên dụng</option>
                            <option value="Xe máy">Xe mô tô công vụ</option>
                        </InputSelect>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-bold">Số lượng người tham gia <span class="text-danger">*</span></label>
                        <InputNumber class="form-control" @bind-Value="yeuCau.PassengerCount" min="1" max="50" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Mục đích sử dụng phương tiện <span class="text-danger">*</span></label>
                        <InputText class="form-control" @bind-Value="yeuCau.Purpose" placeholder="Ví dụ: Tuần tra kiểm soát địa bàn trọng điểm phức tạp ANTT..." />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Nội dung / Nhiệm vụ công tác cụ thể</label>
                        <InputText class="form-control" @bind-Value="yeuCau.TaskDescription" placeholder="Tóm tắt nhiệm vụ, số QĐ hoặc thành phần phối hợp..." />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Địa điểm xuất phát <span class="text-danger">*</span></label>
                        <InputText class="form-control" @bind-Value="yeuCau.Departure" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Địa điểm đến / Lộ trình <span class="text-danger">*</span></label>
                        <InputText class="form-control" @bind-Value="yeuCau.Destination" placeholder="Ví dụ: Phường Minh Khai, TAND TP Hà Nội..." />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Thời gian khởi hành dự kiến <span class="text-danger">*</span></label>
                        <RadzenDatePicker @bind-Value="yeuCau.DepartureTime" 
                                          ShowTime="true" 
                                          HoursStep="1" 
                                          MinutesStep="15" 
                                          DateFormat="dd/MM/yyyy HH:mm" 
                                          Class="w-100" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Thời gian trở về dự kiến <span class="text-danger">*</span></label>
                        <RadzenDatePicker @bind-Value="yeuCau.ReturnTime" 
                                          ShowTime="true" 
                                          HoursStep="1" 
                                          MinutesStep="15" 
                                          DateFormat="dd/MM/yyyy HH:mm" 
                                          Class="w-100" />
                    </div>

                    <div class="col-12 d-flex justify-content-end gap-2 pt-2 border-top">
                        <RadzenButton ButtonType="ButtonType.Submit" 
                                      Text="@(dangSua ? "Lưu thay đổi nháp" : "Lưu bản nháp")" 
                                      Icon="save" 
                                      ButtonStyle="ButtonStyle.Secondary" 
                                      Click="@(() => hanhDongGuiDuyet = false)" />

                        <RadzenButton ButtonType="ButtonType.Submit" 
                                      Text="@(dangSua && yeuCau.Status == BookingStatus.NeedAdjustment ? "Bổ sung & Gửi duyệt lại" : "Gửi phê duyệt ngay")" 
                                      Icon="send" 
                                      ButtonStyle="ButtonStyle.Primary" 
                                      Click="@(() => hanhDongGuiDuyet = true)" />
                    </div>
                </div>
            </EditForm>
        </div>
    </div>

    @* BẢNG DANH SÁCH YÊU CẦU *@
    <div class="gov-card">
        <div class="gov-card-header bg-white py-3">
            <div class="row g-2 align-items-center w-100">
                <div class="col-md-4">
                    <RadzenTextBox @bind-Value="tuKhoaTimKiem" 
                                   Placeholder="Tìm mã đơn, mục đích, nơi đến..." 
                                   Class="w-100" />
                </div>
                <div class="col-md-3">
                    <RadzenDropDown @bind-Value="locTrangThai" 
                                    Data="danhSachTrangThaiLoc" 
                                    TextProperty="Ten" 
                                    ValueProperty="GiaTri" 
                                    Placeholder="-- Lọc trạng thái --" 
                                    Class="w-100" />
                </div>
                <div class="col-md-2">
                    <RadzenButton Text="Đặt lại lọc" Icon="restart_alt" ButtonStyle="ButtonStyle.Light" Click="DatLaiBoLoc" />
                </div>
                <div class="col-md-3 text-end text-muted small">
                    Tổng số: <strong>@DanhSachHienThi.Count</strong> yêu cầu
                </div>
            </div>
        </div>

        <div class="gov-card-body p-0">
            <RadzenDataGrid Data="@DanhSachHienThi" 
                            TItem="Booking" 
                            AllowPaging="true" 
                            PageSize="8" 
                            AllowSorting="true" 
                            EmptyText="Không có yêu cầu đăng ký phương tiện nào phù hợp.">
                <Columns>
                    <RadzenDataGridColumn Property="BookingCode" Title="Mã yêu cầu" Width="140px">
                        <Template Context="item">
                            <span class="fw-bold text-primary text-nowrap">@item.BookingCode</span>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Property="Purpose" Title="Mục đích / Công việc" Width="280px">
                        <Template Context="item">
                            <div class="fw-semibold">@item.Purpose</div>
                            <div class="text-muted small">
                                <span class="badge bg-light text-dark border me-1">@item.WorkType</span>
                                <span>Tới: @item.Destination</span>
                            </div>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Property="PreferredDriverMode" Title="Phương án lái" Width="140px">
                        <Template Context="item">
                            @if (item.PreferredDriverMode == DriverMode.SelfDrive)
                            {
                                <span class="badge-status badge-status-info">
                                    <RadzenIcon Icon="person" Style="font-size: 0.85rem;" /> Tự lái
                                </span>
                            }
                            else
                            {
                                <span class="badge-status badge-status-neutral">
                                    <RadzenIcon Icon="drive_eta" Style="font-size: 0.85rem;" /> Lái xe ĐV
                                </span>
                            }
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Property="DepartureTime" Title="Lịch trình" Width="170px">
                        <Template Context="item">
                            <div class="small fw-medium"><RadzenIcon Icon="arrow_forward" Style="font-size: 0.8rem; vertical-align: middle;" Class="me-1 text-success" />@item.DepartureTime.ToString("dd/MM HH:mm")</div>
                            <div class="text-muted small"><RadzenIcon Icon="arrow_back" Style="font-size: 0.8rem; vertical-align: middle;" Class="me-1 text-danger" />@item.ReturnTime.ToString("dd/MM HH:mm")</div>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Property="Status" Title="Trạng thái" Width="150px">
                        <Template Context="item">
                            <span class="badge-status @item.Status.BadgeClass()">
                                @item.Status.Ten()
                            </span>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Title="Thao tác" Sortable="false" Filterable="false" Width="180px">
                        <Template Context="item">
                            <div class="d-flex gap-1">
                                <RadzenButton Icon="visibility" 
                                              ButtonStyle="ButtonStyle.Light" 
                                              Size="ButtonSize.Small" 
                                              Title="Xem chi tiết" 
                                              Click="@(() => XemChiTiet(item))" />

                                @* Nếu là đơn nháp hoặc yêu cầu bổ sung -> Cho phép chỉnh sửa & gửi duyệt *@
                                @if (item.Status == BookingStatus.Draft || item.Status == BookingStatus.NeedAdjustment)
                                {
                                    <RadzenButton Icon="edit" 
                                                  ButtonStyle="@(item.Status == BookingStatus.NeedAdjustment ? ButtonStyle.Warning : ButtonStyle.Secondary)" 
                                                  Size="ButtonSize.Small" 
                                                  Title="@(item.Status == BookingStatus.NeedAdjustment ? "Bổ sung thông tin" : "Sửa nháp")" 
                                                  Click="@(() => ChonSua(item))" />

                                    <RadzenButton Icon="send" 
                                                  ButtonStyle="ButtonStyle.Success" 
                                                  Size="ButtonSize.Small" 
                                                  Title="Gửi phê duyệt" 
                                                  Click="@(() => GuiPheDuyet(item))" />
                                }

                                @* Đơn chờ duyệt: Cho phép sửa hoặc hủy *@
                                @if (item.Status == BookingStatus.PendingApproval)
                                {
                                    <RadzenButton Icon="edit" 
                                                  ButtonStyle="ButtonStyle.Light" 
                                                  Size="ButtonSize.Small" 
                                                  Title="Chỉnh sửa" 
                                                  Click="@(() => ChonSua(item))" />

                                    <RadzenButton Icon="close" 
                                                  ButtonStyle="ButtonStyle.Danger" 
                                                  Size="ButtonSize.Small" 
                                                  Title="Rút / Hủy yêu cầu" 
                                                  Click="@(() => HuyYeuCau(item))" />
                                }

                                @* Đơn nháp hoặc yêu cầu bổ sung: Cho phép hủy *@
                                @if (item.Status == BookingStatus.Draft || item.Status == BookingStatus.NeedAdjustment)
                                {
                                    <RadzenButton Icon="delete" 
                                                  ButtonStyle="ButtonStyle.Danger" 
                                                  Size="ButtonSize.Small" 
                                                  Title="Hủy yêu cầu" 
                                                  Click="@(() => HuyYeuCau(item))" />
                                }
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </div>
    </div>
}

@code {
    List<Booking> danhSachYeuCau = new();
    Booking yeuCau = new();
    Booking? yeuCauDangXem;

    bool dangSua = false;
    bool hanhDongGuiDuyet = false;
    string thongBao = "";
    bool coLoi = false;

    string tuKhoaTimKiem = "";
    int locTrangThai = -1;

    class ItemLoc
    {
        public int GiaTri { get; set; }
        public string Ten { get; set; } = "";
    }

    List<ItemLoc> danhSachTrangThaiLoc = new()
    {
        new ItemLoc { GiaTri = -1, Ten = "-- Tất cả trạng thái --" },
        new ItemLoc { GiaTri = (int)BookingStatus.Draft, Ten = "Bản nháp" },
        new ItemLoc { GiaTri = (int)BookingStatus.PendingApproval, Ten = "Chờ phê duyệt" },
        new ItemLoc { GiaTri = (int)BookingStatus.NeedAdjustment, Ten = "Yêu cầu bổ sung" },
        new ItemLoc { GiaTri = (int)BookingStatus.Approved, Ten = "Đã duyệt" },
        new ItemLoc { GiaTri = (int)BookingStatus.Dispatched, Ten = "Đã điều phối" },
        new ItemLoc { GiaTri = (int)BookingStatus.InUse, Ten = "Đang sử dụng" },
        new ItemLoc { GiaTri = (int)BookingStatus.Completed, Ten = "Hoàn thành" },
        new ItemLoc { GiaTri = (int)BookingStatus.Rejected, Ten = "Bị từ chối" },
        new ItemLoc { GiaTri = (int)BookingStatus.Cancelled, Ten = "Đã hủy" }
    };

    List<Booking> DanhSachHienThi
    {
        get
        {
            var ds = danhSachYeuCau.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(tuKhoaTimKiem))
            {
                string tk = tuKhoaTimKiem.Trim().ToLower();
                ds = ds.Where(x => 
                    x.BookingCode.ToLower().Contains(tk) ||
                    x.Purpose.ToLower().Contains(tk) ||
                    x.Destination.ToLower().Contains(tk) ||
                    x.TaskDescription.ToLower().Contains(tk));
            }

            if (locTrangThai >= 0)
            {
                ds = ds.Where(x => (int)x.Status == locTrangThai);
            }

            return ds.OrderByDescending(x => x.Id).ToList();
        }
    }

    protected override void OnInitialized()
    {
        authService.UserChanged += CapNhatTrang;
        NapDuLieu();
        LamMoiForm();
    }

    private void CapNhatTrang()
    {
        NapDuLieu();
        _ = InvokeAsync(StateHasChanged);
    }

    private void NapDuLieu()
    {
        danhSachYeuCau = bookingService.GetAll();
    }

    private async Task ThemMoi()
    {
        LamMoiForm();
        yeuCauDangXem = null;
        thongBao = "";
        await js.InvokeVoidAsync("cuonLenForm", "form-dang-ky");
    }

    private async Task XemChiTiet(Booking item)
    {
        yeuCauDangXem = item;
        await js.InvokeVoidAsync("cuonLenForm", "chi-tiet-yeu-cau");
    }

    private void DongChiTiet()
    {
        yeuCauDangXem = null;
    }

    private async Task ChonSua(Booking item)
    {
        yeuCau = new Booking
        {
            Id = item.Id,
            BookingCode = item.BookingCode,
            RequesterId = item.RequesterId,
            DepartmentId = item.DepartmentId,
            DepartmentSnapshot = item.DepartmentSnapshot,
            WorkType = item.WorkType,
            Purpose = item.Purpose,
            TaskDescription = item.TaskDescription,
            Departure = item.Departure,
            Destination = item.Destination,
            DepartureTime = item.DepartureTime,
            ReturnTime = item.ReturnTime,
            PassengerCount = item.PassengerCount,
            RequestedVehicleType = item.RequestedVehicleType,
            PreferredDriverMode = item.PreferredDriverMode,
            Status = item.Status,
            RejectionReason = item.RejectionReason,
            NeedAdjustmentReason = item.NeedAdjustmentReason,
            ApprovalOfficerId = item.ApprovalOfficerId,
            ApprovalAt = item.ApprovalAt,
            ApprovalComment = item.ApprovalComment,
            CancellationReason = item.CancellationReason,
            CreatedAt = item.CreatedAt,
            SubmittedAt = item.SubmittedAt,
            Notes = item.Notes
        };

        dangSua = true;
        thongBao = "";
        await js.InvokeVoidAsync("cuonLenForm", "form-dang-ky");
    }

    private void XuLyLuu()
    {
        string loi;
        bool thanhCong;

        if (dangSua)
        {
            thanhCong = bookingService.Update(yeuCau, hanhDongGuiDuyet, out loi);
        }
        else
        {
            thanhCong = bookingService.Create(yeuCau, hanhDongGuiDuyet, out loi);
        }

        if (!thanhCong)
        {
            thongBao = loi;
            coLoi = true;
            return;
        }

        NapDuLieu();
        thongBao = hanhDongGuiDuyet ? "Đã gửi yêu cầu phê duyệt thành công." : "Đã lưu bản nháp yêu cầu thành công.";
        coLoi = false;
        LamMoiForm();
    }

    private async Task GuiPheDuyet(Booking item)
    {
        var xacNhan = await dialog.Confirm(
            $"Đồng chí có chắc chắn muốn gửi yêu cầu {item.BookingCode} đến Lãnh đạo phê duyệt?",
            "Gửi phê duyệt yêu cầu",
            new ConfirmOptions { OkButtonText = "Gửi ngay", CancelButtonText = "Hủy" });

        if (xacNhan != true)
        {
            return;
        }

        string loi;
        bool thanhCong = bookingService.SendApproval(item.Id, out loi);

        if (!thanhCong)
        {
            thongBao = loi;
            coLoi = true;
            return;
        }

        NapDuLieu();
        thongBao = $"Đã gửi yêu cầu {item.BookingCode} đến Lãnh đạo phê duyệt thành công.";
        coLoi = false;
    }

    private async Task HuyYeuCau(Booking item)
    {
        var xacNhan = await dialog.Confirm(
            $"Đồng chí có chắc chắn muốn rút / hủy yêu cầu {item.BookingCode}?",
            "Xác nhận hủy yêu cầu",
            new ConfirmOptions { OkButtonText = "Xác nhận hủy", CancelButtonText = "Bỏ qua" });

        if (xacNhan != true)
        {
            return;
        }

        string loi;
        bool thanhCong = bookingService.Cancel(item.Id, "Cán bộ tự rút yêu cầu", out loi);

        if (!thanhCong)
        {
            thongBao = loi;
            coLoi = true;
            return;
        }

        NapDuLieu();
        thongBao = $"Đã hủy yêu cầu {item.BookingCode} thành công.";
        coLoi = false;

        if (yeuCauDangXem?.Id == item.Id)
        {
            DongChiTiet();
        }
    }

    private void DatLaiBoLoc()
    {
        tuKhoaTimKiem = "";
        locTrangThai = -1;
    }

    private void LamMoiForm()
    {
        DateTime thoiDiemKhoiHanh = DateTime.Now.AddHours(2);
        thoiDiemKhoiHanh = new DateTime(thoiDiemKhoiHanh.Year, thoiDiemKhoiHanh.Month, thoiDiemKhoiHanh.Day, thoiDiemKhoiHanh.Hour, 0, 0);

        yeuCau = new Booking
        {
            WorkType = "Công tác địa bàn",
            Departure = "Trụ sở Công an",
            DepartureTime = thoiDiemKhoiHanh,
            ReturnTime = thoiDiemKhoiHanh.AddHours(5),
            PassengerCount = 2,
            RequestedVehicleType = "Ô tô",
            PreferredDriverMode = DriverMode.AssignedDriver,
            Status = BookingStatus.Draft
        };

        dangSua = false;
        hanhDongGuiDuyet = false;
    }

    public void Dispose()
    {
        authService.UserChanged -= CapNhatTrang;
    }
}
