@page "/bookings"
@rendermode InteractiveServer
@implements IDisposable

@using MyWebApp.Models.Enums
@using MyWebApp.Helpers

@inject BookingService bookingService
@inject DialogService dialog
@inject AuthService authService

<PageTitle>Đăng ký phương tiện</PageTitle>

@if (!authService.DaDangNhap)
{
    <div class="alert alert-warning">
        Vui lòng đăng nhập để sử dụng chức năng đăng ký phương tiện.
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1>Đăng ký phương tiện</h1>
            <p class="text-muted mb-0">
                @(authService.CurrentUser?.Role == UserRole.Officer 
                    ? "Danh sách yêu cầu sử dụng phương tiện của bạn" 
                    : "Danh sách yêu cầu đăng ký phương tiện của đơn vị")
            </p>
        </div>
        <RadzenButton Text="Tạo yêu cầu mới" Icon="add_circle" Click="ThemMoi" ButtonStyle="ButtonStyle.Success" />
    </div>

    @if (thongBao != "")
    {
        <div class="alert @(coLoi ? "alert-danger" : "alert-success")">
            @thongBao
        </div>
    }

    @if (yeuCauDangXem != null)
    {
        <div class="card mb-3 border-primary">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <strong>Chi tiết yêu cầu: @yeuCauDangXem.BookingCode</strong>
                <button class="btn btn-sm btn-outline-secondary" @onclick="DongChiTiet">Đóng</button>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3 mb-2"><strong>Mã yêu cầu:</strong> @yeuCauDangXem.BookingCode</div>
                    <div class="col-md-3 mb-2"><strong>Người đăng ký:</strong> @bookingService.GetRequesterName(yeuCauDangXem.RequesterId)</div>
                    <div class="col-md-3 mb-2"><strong>Loại công việc:</strong> @yeuCauDangXem.WorkType</div>
                    <div class="col-md-3 mb-2">
                        <strong>Trạng thái:</strong> 
                        <span class="badge @LayMauTrangThai(yeuCauDangXem.Status)">
                            @EnumHelper.TenBookingStatus(yeuCauDangXem.Status)
                        </span>
                    </div>

                    <div class="col-md-6 mb-2"><strong>Địa điểm xuất phát:</strong> @yeuCauDangXem.Departure</div>
                    <div class="col-md-6 mb-2"><strong>Địa điểm đến:</strong> @yeuCauDangXem.Destination</div>

                    <div class="col-md-6 mb-2"><strong>Thời gian khởi hành:</strong> @yeuCauDangXem.DepartureTime.ToString("dd/MM/yyyy HH:mm")</div>
                    <div class="col-md-6 mb-2"><strong>Thời gian dự kiến về:</strong> @yeuCauDangXem.ReturnTime.ToString("dd/MM/yyyy HH:mm")</div>

                    <div class="col-md-3 mb-2"><strong>Số lượng người:</strong> @yeuCauDangXem.PassengerCount người</div>
                    <div class="col-md-3 mb-2"><strong>Loại xe yêu cầu:</strong> @yeuCauDangXem.RequestedVehicleType</div>
                    <div class="col-md-6 mb-2"><strong>Mục đích:</strong> @yeuCauDangXem.Purpose</div>
                </div>

                @if (!string.IsNullOrEmpty(yeuCauDangXem.RejectionReason))
                {
                    <div class="alert alert-danger mt-2 mb-0">
                        <strong>Lý do từ chối:</strong> @yeuCauDangXem.RejectionReason
                    </div>
                }
            </div>
        </div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h5">@(dangSua ? $"Chỉnh sửa yêu cầu {yeuCau.BookingCode}" : "Lập phiếu đăng ký phương tiện mới")</h2>

            <EditForm Model="yeuCau" OnValidSubmit="XuLyLuu">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />

                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Loại công việc</label>
                        <InputSelect class="form-select" @bind-Value="yeuCau.WorkType">
                            <option value="Công tác địa bàn">Công tác địa bàn</option>
                            <option value="Họp nghiệp vụ">Họp nghiệp vụ</option>
                            <option value="Chuyển hồ sơ">Chuyển hồ sơ</option>
                            <option value="Tuần tra kiểm soát">Tuần tra kiểm soát</option>
                            <option value="Hỗ trợ khẩn cấp">Hỗ trợ khẩn cấp</option>
                            <option value="Khác">Khác</option>
                        </InputSelect>
                    </div>

                    <div class="col-md-9 mb-3">
                        <label class="form-label">Mục đích sử dụng <span class="text-danger">*</span></label>
                        <InputText class="form-control" @bind-Value="yeuCau.Purpose" placeholder="Ghi rõ mục đích công tác..." />
                        <ValidationMessage For="() => yeuCau.Purpose" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Địa điểm xuất phát <span class="text-danger">*</span></label>
                        <InputText class="form-control" @bind-Value="yeuCau.Departure" placeholder="Ví dụ: Trụ sở đơn vị..." />
                        <ValidationMessage For="() => yeuCau.Departure" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Địa điểm đến <span class="text-danger">*</span></label>
                        <InputText class="form-control" @bind-Value="yeuCau.Destination" placeholder="Ví dụ: Công an quận, Phường Minh Khai..." />
                        <ValidationMessage For="() => yeuCau.Destination" />
                    </div>

                    <div class="col-md-3 mb-3">
                        <label class="form-label">Thời gian khởi hành <span class="text-danger">*</span></label>
                        <RadzenDatePicker @bind-Value="yeuCau.DepartureTime" 
                                          ShowTime="true" 
                                          DateFormat="dd/MM/yyyy HH:mm" 
                                          Style="width: 100%" />
                    </div>

                    <div class="col-md-3 mb-3">
                        <label class="form-label">Thời gian dự kiến về <span class="text-danger">*</span></label>
                        <RadzenDatePicker @bind-Value="yeuCau.ReturnTime" 
                                          ShowTime="true" 
                                          DateFormat="dd/MM/yyyy HH:mm" 
                                          Style="width: 100%" />
                    </div>

                    <div class="col-md-3 mb-3">
                        <label class="form-label">Số người tham gia <span class="text-danger">*</span></label>
                        <InputNumber class="form-control" @bind-Value="yeuCau.PassengerCount" />
                        <ValidationMessage For="() => yeuCau.PassengerCount" />
                    </div>

                    <div class="col-md-3 mb-3">
                        <label class="form-label">Loại xe mong muốn</label>
                        <InputSelect class="form-select" @bind-Value="yeuCau.RequestedVehicleType">
                            <option value="Ô tô">Ô tô</option>
                            <option value="Xe máy">Xe máy</option>
                            <option value="Xe chuyên dụng">Xe chuyên dụng</option>
                            <option value="Xe tải">Xe tải</option>
                        </InputSelect>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <RadzenButton Text="Gửi phê duyệt ngay" 
                                  Icon="send" 
                                  ButtonType="ButtonType.Submit" 
                                  Click="@(() => hanhDongGuiDuyet = true)" 
                                  ButtonStyle="ButtonStyle.Success" />

                    <RadzenButton Text="Lưu bản nháp" 
                                  Icon="save" 
                                  ButtonType="ButtonType.Submit" 
                                  Click="@(() => hanhDongGuiDuyet = false)" 
                                  ButtonStyle="ButtonStyle.Primary" />

                    <RadzenButton Text="Làm mới" 
                                  Icon="refresh" 
                                  Click="LamMoiForm" 
                                  ButtonStyle="ButtonStyle.Light" />
                </div>
            </EditForm>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <h2 class="h5">Danh sách yêu cầu</h2>

            <div class="row mb-3">
                <div class="col-md-6 mb-2">
                    <RadzenLabel Text="Tìm kiếm theo mã, điểm đến hoặc mục đích" />
                    <RadzenTextBox @bind-Value="tuKhoaTimKiem" Style="width:100%" placeholder="Nhập từ khóa tìm kiếm..." />
                </div>

                <div class="col-md-6 mb-2">
                    <label class="form-label">Lọc theo trạng thái</label>
                    <select class="form-select" @bind="locTrangThai">
                        <option value="-1">Tất cả trạng thái</option>
                        <option value="@((int)BookingStatus.Draft)">Bản nháp</option>
                        <option value="@((int)BookingStatus.PendingApproval)">Chờ phê duyệt</option>
                        <option value="@((int)BookingStatus.PendingDispatch)">Chờ điều động</option>
                        <option value="@((int)BookingStatus.Dispatched)">Đã điều động</option>
                        <option value="@((int)BookingStatus.InProgress)">Đang thực hiện</option>
                        <option value="@((int)BookingStatus.PendingSettlement)">Chờ quyết toán</option>
                        <option value="@((int)BookingStatus.Completed)">Hoàn thành</option>
                        <option value="@((int)BookingStatus.Rejected)">Bị từ chối</option>
                        <option value="@((int)BookingStatus.Cancelled)">Đã hủy</option>
                    </select>
                </div>
            </div>

            <RadzenButton Text="Đặt lại bộ lọc" Icon="refresh" Click="DatLaiBoLoc" ButtonStyle="ButtonStyle.Light" class="mb-3" />

            <RadzenDataGrid Data="@DanhSachDaLoc" TItem="Booking" AllowPaging="true" PageSize="10" AllowSorting="true">
                <Columns>
                    <RadzenDataGridColumn TItem="Booking" Property="BookingCode" Title="Mã yêu cầu" Width="130px" />
                    <RadzenDataGridColumn TItem="Booking" Title="Người đăng ký" Width="160px">
                        <Template Context="item">
                            @bookingService.GetRequesterName(item.RequesterId)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Booking" Property="Destination" Title="Điểm đến" />
                    <RadzenDataGridColumn TItem="Booking" Title="Thời gian công tác">
                        <Template Context="item">
                            <div>@item.DepartureTime.ToString("dd/MM/yyyy HH:mm")</div>
                            <small class="text-muted">đến @item.ReturnTime.ToString("dd/MM/yyyy HH:mm")</small>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Booking" Title="Yêu cầu" Width="140px">
                        <Template Context="item">
                            @item.RequestedVehicleType (@item.PassengerCount người)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Booking" Title="Trạng thái" Width="150px">
                        <Template Context="item">
                            <span class="badge @LayMauTrangThai(item.Status)">
                                @EnumHelper.TenBookingStatus(item.Status)
                            </span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Booking" Title="Thao tác" Sortable="false" Filterable="false" Width="180px">
                        <Template Context="item">
                            <RadzenButton Icon="visibility" 
                                          ButtonStyle="ButtonStyle.Light" 
                                          Size="ButtonSize.Small" 
                                          Title="Xem chi tiết" 
                                          Click="@(() => XemChiTiet(item))" />

                            @if (CoTheSua(item))
                            {
                                <RadzenButton Icon="edit" 
                                              ButtonStyle="ButtonStyle.Info" 
                                              Size="ButtonSize.Small" 
                                              Title="Chỉnh sửa" 
                                              Click="@(() => Sua(item))" />
                            }

                            @if (item.Status == BookingStatus.Draft)
                            {
                                <RadzenButton Icon="send" 
                                              ButtonStyle="ButtonStyle.Success" 
                                              Size="ButtonSize.Small" 
                                              Title="Gửi phê duyệt" 
                                              Click="@(() => GuiPheDuyet(item))" />
                            }

                            @if (item.Status == BookingStatus.Draft || item.Status == BookingStatus.PendingApproval)
                            {
                                <RadzenButton Icon="cancel" 
                                              ButtonStyle="ButtonStyle.Danger" 
                                              Size="ButtonSize.Small" 
                                              Title="Hủy yêu cầu" 
                                              Click="@(() => HuyYeuCau(item))" />
                            }
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </div>
    </div>
}

@code {
    List<Booking> danhSachYeuCau = new List<Booking>();
    Booking yeuCau = new Booking();
    Booking? yeuCauDangXem = null;

    string tuKhoaTimKiem = "";
    int locTrangThai = -1;

    string thongBao = "";
    bool coLoi = false;
    bool dangSua = false;
    bool hanhDongGuiDuyet = false;

    protected override void OnInitialized()
    {
        authService.UserChanged += CapNhatTrang;
        NapDuLieu();
        LamMoiForm();
    }

    private void CapNhatTrang()
    {
        NapDuLieu();
        _ = InvokeAsync(StateHasChanged);
    }

    private void NapDuLieu()
    {
        danhSachYeuCau = bookingService.GetAll();
    }

    private List<Booking> DanhSachDaLoc
    {
        get
        {
            List<Booking> ketQua = danhSachYeuCau;

            if (!string.IsNullOrEmpty(tuKhoaTimKiem))
            {
                List<Booking> tam = new List<Booking>();

                foreach (Booking item in ketQua)
                {
                    if (item.BookingCode.Contains(tuKhoaTimKiem, StringComparison.OrdinalIgnoreCase) ||
                        item.Destination.Contains(tuKhoaTimKiem, StringComparison.OrdinalIgnoreCase) ||
                        item.Purpose.Contains(tuKhoaTimKiem, StringComparison.OrdinalIgnoreCase))
                    {
                        tam.Add(item);
                    }
                }

                ketQua = tam;
            }

            if (locTrangThai != -1)
            {
                BookingStatus trangThaiCanLoc = (BookingStatus)locTrangThai;
                List<Booking> tam = new List<Booking>();

                foreach (Booking item in ketQua)
                {
                    if (item.Status == trangThaiCanLoc)
                    {
                        tam.Add(item);
                    }
                }

                ketQua = tam;
            }

            return ketQua;
        }
    }

    private bool CoTheSua(Booking item)
    {
        User? nguoiDung = authService.CurrentUser;

        if (nguoiDung == null)
        {
            return false;
        }

        bool laCuaMinh = item.RequesterId == nguoiDung.Id || nguoiDung.Role == UserRole.Administrator;
        bool trangThaiHopLe = item.Status == BookingStatus.Draft || item.Status == BookingStatus.PendingApproval;

        return laCuaMinh && trangThaiHopLe;
    }

    private void ThemMoi()
    {
        LamMoiForm();
        thongBao = "";
    }

    private void XemChiTiet(Booking item)
    {
        yeuCauDangXem = item;
    }

    private void DongChiTiet()
    {
        yeuCauDangXem = null;
    }

    private void Sua(Booking item)
    {
        yeuCau = new Booking
        {
            Id = item.Id,
            BookingCode = item.BookingCode,
            RequesterId = item.RequesterId,
            DepartmentId = item.DepartmentId,
            WorkType = item.WorkType,
            Purpose = item.Purpose,
            Departure = item.Departure,
            Destination = item.Destination,
            DepartureTime = item.DepartureTime,
            ReturnTime = item.ReturnTime,
            PassengerCount = item.PassengerCount,
            RequestedVehicleType = item.RequestedVehicleType,
            Status = item.Status,
            RejectionReason = item.RejectionReason
        };

        dangSua = true;
        thongBao = "";
    }

    private void XuLyLuu()
    {
        string loi;
        bool thanhCong;

        if (dangSua)
        {
            thanhCong = bookingService.Update(yeuCau, hanhDongGuiDuyet, out loi);
        }
        else
        {
            thanhCong = bookingService.Create(yeuCau, hanhDongGuiDuyet, out loi);
        }

        if (!thanhCong)
        {
            thongBao = loi;
            coLoi = true;
            return;
        }

        NapDuLieu();
        thongBao = hanhDongGuiDuyet ? "Đã gửi yêu cầu phê duyệt thành công." : "Đã lưu bản nháp yêu cầu thành công.";
        coLoi = false;
        LamMoiForm();
    }

    private async Task GuiPheDuyet(Booking item)
    {
        var xacNhan = await dialog.Confirm(
            $"Bạn có muốn gửi yêu cầu {item.BookingCode} đến lãnh đạo phê duyệt?",
            "Gửi phê duyệt");

        if (xacNhan != true)
        {
            return;
        }

        string loi;
        bool thanhCong = bookingService.SendApproval(item.Id, out loi);

        if (!thanhCong)
        {
            thongBao = loi;
            coLoi = true;
            return;
        }

        NapDuLieu();
        thongBao = $"Đã gửi yêu cầu {item.BookingCode} đến lãnh đạo thành công.";
        coLoi = false;
    }

    private async Task HuyYeuCau(Booking item)
    {
        var xacNhan = await dialog.Confirm(
            $"Bạn có chắc chắn muốn hủy yêu cầu {item.BookingCode}?",
            "Xác nhận hủy");

        if (xacNhan != true)
        {
            return;
        }

        string loi;
        bool thanhCong = bookingService.Cancel(item.Id, out loi);

        if (!thanhCong)
        {
            thongBao = loi;
            coLoi = true;
            return;
        }

        NapDuLieu();
        thongBao = $"Đã hủy yêu cầu {item.BookingCode} thành công.";
        coLoi = false;

        if (yeuCauDangXem?.Id == item.Id)
        {
            DongChiTiet();
        }
    }

    private void DatLaiBoLoc()
    {
        tuKhoaTimKiem = "";
        locTrangThai = -1;
    }

    private void LamMoiForm()
    {
        DateTime thoiDiemKhoiHanh = DateTime.Now.AddHours(2);
        thoiDiemKhoiHanh = new DateTime(thoiDiemKhoiHanh.Year, thoiDiemKhoiHanh.Month, thoiDiemKhoiHanh.Day, thoiDiemKhoiHanh.Hour, 0, 0);

        yeuCau = new Booking
        {
            WorkType = "Công tác địa bàn",
            Departure = "Trụ sở đơn vị",
            DepartureTime = thoiDiemKhoiHanh,
            ReturnTime = thoiDiemKhoiHanh.AddHours(5),
            PassengerCount = 2,
            RequestedVehicleType = "Ô tô",
            Status = BookingStatus.Draft
        };

        dangSua = false;
        hanhDongGuiDuyet = false;
    }

    private string LayMauTrangThai(BookingStatus status)
    {
        if (status == BookingStatus.Draft)
        {
            return "bg-secondary";
        }

        if (status == BookingStatus.PendingApproval)
        {
            return "bg-warning text-dark";
        }

        if (status == BookingStatus.Approved || status == BookingStatus.PendingDispatch)
        {
            return "bg-info text-dark";
        }

        if (status == BookingStatus.Dispatched || status == BookingStatus.InProgress)
        {
            return "bg-primary";
        }

        if (status == BookingStatus.PendingSettlement)
        {
            return "bg-warning text-dark";
        }

        if (status == BookingStatus.Completed)
        {
            return "bg-success";
        }

        if (status == BookingStatus.Rejected)
        {
            return "bg-danger";
        }

        if (status == BookingStatus.Cancelled)
        {
            return "bg-dark";
        }

        return "bg-secondary";
    }

    public void Dispose()
    {
        authService.UserChanged -= CapNhatTrang;
    }
}
