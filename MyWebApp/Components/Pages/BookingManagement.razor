@page "/bookings"
@rendermode InteractiveServer
@implements IDisposable

@using MyWebApp.Models
@using MyWebApp.Models.Enums
@using MyWebApp.Helpers
@using MyWebApp.Data
@using MyWebApp.Components.Dialogs

@inject BookingService bookingService
@inject DialogService dialog
@inject AuthService authService
@inject MockDataService mockDataService
@inject IJSRuntime js

<PageTitle>Đăng ký phương tiện</PageTitle>

@if (!authService.DaDangNhap)
{
    <div class="alert alert-warning shadow-sm">
        <RadzenIcon Icon="lock" Class="me-2" />
        Vui lòng đăng nhập để sử dụng chức năng đăng ký phương tiện công tác.
    </div>
}
else
{
    <div class="page-header-box">
        <div>
            <h1 class="page-header-title">
                <RadzenIcon Icon="assignment" Style="color: var(--brand-navy);" />
                Đăng ký sử dụng phương tiện công vụ
            </h1>
            <p class="page-header-desc">
                @(authService.CurrentUser?.Role == UserRole.Officer 
                    ? "Danh sách phiếu đăng ký sử dụng phương tiện công tác của đồng chí" 
                    : "Quản lý tiếp nhận và thẩm định yêu cầu sử dụng phương tiện toàn đơn vị")
            </p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-primary-action" @onclick="ThemMoi">
                <RadzenIcon Icon="add_circle" Class="me-1 align-middle" />
                Lập yêu cầu mới
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(thongBao))
    {
        <div class="alert @(coLoi ? "alert-danger" : "alert-success") alert-dismissible fade show shadow-sm" role="alert">
            <RadzenIcon Icon="@(coLoi ? "error" : "check_circle")" Class="me-2" />
            @thongBao
            <button type="button" class="btn-close" @onclick="() => thongBao = string.Empty"></button>
        </div>
    }

    @* BẢNG DANH SÁCH YÊU CẦU *@
    <div class="gov-card">
        <div class="gov-card-header bg-white py-3">
            <div class="row g-2 align-items-center w-100">
                <div class="col-md-4">
                    <RadzenTextBox @bind-Value="tuKhoaTimKiem" 
                                   Placeholder="Tìm mã đơn, mục đích, nơi đến..." 
                                   Class="w-100" />
                </div>
                <div class="col-md-3">
                    <RadzenDropDown @bind-Value="locTrangThai" 
                                    Data="danhSachTrangThaiLoc" 
                                    TextProperty="Ten" 
                                    ValueProperty="GiaTri" 
                                    Placeholder="-- Lọc trạng thái --" 
                                    Class="w-100" />
                </div>
                <div class="col-md-2">
                    <RadzenButton Text="Đặt lại lọc" Icon="restart_alt" ButtonStyle="ButtonStyle.Light" Click="DatLaiBoLoc" />
                </div>
                <div class="col-md-3 text-end text-muted small">
                    Tổng số: <strong>@DanhSachHienThi.Count</strong> yêu cầu
                </div>
            </div>
        </div>

        <div class="gov-card-body p-0">
            <RadzenDataGrid Data="@DanhSachHienThi" 
                            TItem="Booking" 
                            AllowPaging="true" 
                            PageSize="8" 
                            AllowSorting="true" 
                            EmptyText="Không có yêu cầu đăng ký phương tiện nào phù hợp.">
                <Columns>
                    <RadzenDataGridColumn Property="BookingCode" Title="Mã yêu cầu" Width="140px">
                        <Template Context="item">
                            <span class="fw-bold text-primary text-nowrap">@item.BookingCode</span>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Property="Purpose" Title="Mục đích / Công việc" Width="280px">
                        <Template Context="item">
                            <div class="fw-semibold">@item.Purpose</div>
                            <div class="text-muted small">
                                <span class="badge bg-light text-dark border me-1">@item.WorkType</span>
                                <span>Tới: @item.Destination</span>
                            </div>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Property="PreferredDriverMode" Title="Phương án lái" Width="140px">
                        <Template Context="item">
                            @if (item.PreferredDriverMode == DriverMode.SelfDrive)
                            {
                                <span class="badge-status badge-status-info">
                                    <RadzenIcon Icon="person" Style="font-size: 0.85rem;" /> Tự lái
                                </span>
                            }
                            else
                            {
                                <span class="badge-status badge-status-neutral">
                                    <RadzenIcon Icon="drive_eta" Style="font-size: 0.85rem;" /> Lái xe ĐV
                                </span>
                            }
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Property="DepartureTime" Title="Lịch trình" Width="170px">
                        <Template Context="item">
                            <div class="small fw-medium"><RadzenIcon Icon="arrow_forward" Style="font-size: 0.8rem; vertical-align: middle;" Class="me-1 text-success" />@item.DepartureTime.ToString("dd/MM HH:mm")</div>
                            <div class="text-muted small"><RadzenIcon Icon="arrow_back" Style="font-size: 0.8rem; vertical-align: middle;" Class="me-1 text-danger" />@item.ReturnTime.ToString("dd/MM HH:mm")</div>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Property="Status" Title="Trạng thái" Width="150px">
                        <Template Context="item">
                            <span class="badge-status @item.Status.BadgeClass()">
                                @item.Status.Ten()
                            </span>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Title="Thao tác" Sortable="false" Filterable="false" Width="180px">
                        <Template Context="item">
                            <div class="d-flex gap-1">
                                <RadzenButton Icon="visibility" 
                                              ButtonStyle="ButtonStyle.Light" 
                                              Size="ButtonSize.Small" 
                                              Title="Xem chi tiết" 
                                              Click="@(() => XemChiTiet(item))" />

                                @* Nếu là đơn nháp hoặc yêu cầu bổ sung -> Cho phép chỉnh sửa & gửi duyệt *@
                                @if (item.Status == BookingStatus.Draft || item.Status == BookingStatus.NeedAdjustment)
                                {
                                    <RadzenButton Icon="edit" 
                                                  ButtonStyle="@(item.Status == BookingStatus.NeedAdjustment ? ButtonStyle.Warning : ButtonStyle.Secondary)" 
                                                  Size="ButtonSize.Small" 
                                                  Title="@(item.Status == BookingStatus.NeedAdjustment ? "Bổ sung thông tin" : "Sửa nháp")" 
                                                  Click="@(() => ChonSua(item))" />

                                    <RadzenButton Icon="send" 
                                                  ButtonStyle="ButtonStyle.Success" 
                                                  Size="ButtonSize.Small" 
                                                  Title="Gửi phê duyệt" 
                                                  Click="@(() => GuiPheDuyet(item))" />
                                }

                                @* Đơn chờ duyệt: Cho phép sửa hoặc hủy *@
                                @if (item.Status == BookingStatus.PendingApproval)
                                {
                                    <RadzenButton Icon="edit" 
                                                  ButtonStyle="ButtonStyle.Light" 
                                                  Size="ButtonSize.Small" 
                                                  Title="Chỉnh sửa" 
                                                  Click="@(() => ChonSua(item))" />

                                    <RadzenButton Icon="close" 
                                                  ButtonStyle="ButtonStyle.Danger" 
                                                  Size="ButtonSize.Small" 
                                                  Title="Rút / Hủy yêu cầu" 
                                                  Click="@(() => HuyYeuCau(item))" />
                                }

                                @* Đơn nháp hoặc yêu cầu bổ sung: Cho phép hủy *@
                                @if (item.Status == BookingStatus.Draft || item.Status == BookingStatus.NeedAdjustment)
                                {
                                    <RadzenButton Icon="delete" 
                                                  ButtonStyle="ButtonStyle.Danger" 
                                                  Size="ButtonSize.Small" 
                                                  Title="Hủy yêu cầu" 
                                                  Click="@(() => HuyYeuCau(item))" />
                                }
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </div>
    </div>
}

@code {
    List<Booking> danhSachYeuCau = new();

    string thongBao = "";
    bool coLoi = false;

    string tuKhoaTimKiem = "";
    int locTrangThai = -1;

    class ItemLoc
    {
        public int GiaTri { get; set; }
        public string Ten { get; set; } = "";
    }

    List<ItemLoc> danhSachTrangThaiLoc = new()
    {
        new ItemLoc { GiaTri = -1, Ten = "-- Tất cả trạng thái --" },
        new ItemLoc { GiaTri = (int)BookingStatus.Draft, Ten = "Bản nháp" },
        new ItemLoc { GiaTri = (int)BookingStatus.PendingApproval, Ten = "Chờ phê duyệt" },
        new ItemLoc { GiaTri = (int)BookingStatus.NeedAdjustment, Ten = "Yêu cầu bổ sung" },
        new ItemLoc { GiaTri = (int)BookingStatus.Approved, Ten = "Đã duyệt" },
        new ItemLoc { GiaTri = (int)BookingStatus.Dispatched, Ten = "Đã điều phối" },
        new ItemLoc { GiaTri = (int)BookingStatus.InUse, Ten = "Đang sử dụng" },
        new ItemLoc { GiaTri = (int)BookingStatus.Completed, Ten = "Hoàn thành" },
        new ItemLoc { GiaTri = (int)BookingStatus.Rejected, Ten = "Bị từ chối" },
        new ItemLoc { GiaTri = (int)BookingStatus.Cancelled, Ten = "Đã hủy" }
    };

    List<Booking> DanhSachHienThi
    {
        get
        {
            var ds = danhSachYeuCau.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(tuKhoaTimKiem))
            {
                string tk = tuKhoaTimKiem.Trim().ToLower();
                ds = ds.Where(x => 
                    x.BookingCode.ToLower().Contains(tk) ||
                    x.Purpose.ToLower().Contains(tk) ||
                    x.Destination.ToLower().Contains(tk) ||
                    x.TaskDescription.ToLower().Contains(tk));
            }

            if (locTrangThai >= 0)
            {
                ds = ds.Where(x => (int)x.Status == locTrangThai);
            }

            return ds.OrderByDescending(x => x.Id).ToList();
        }
    }

    protected override void OnInitialized()
    {
        authService.UserChanged += CapNhatTrang;
        NapDuLieu();
    }

    private void CapNhatTrang()
    {
        NapDuLieu();
        _ = InvokeAsync(StateHasChanged);
    }

    private void NapDuLieu()
    {
        danhSachYeuCau = bookingService.GetAll();
    }

    // --- POPUP TẠO MỚI YÊU CẦU ---
    private async Task ThemMoi()
    {
        var donMoi = TaoDonMoi();
        var res = await dialog.OpenAsync<BookingEditDialog>(
            "Lập phiếu đăng ký sử dụng phương tiện công vụ mới",
            new Dictionary<string, object?> { { "Booking", donMoi }, { "IsEditing", false } },
            new DialogOptions { Width = "900px", CloseDialogOnOverlayClick = true, CloseDialogOnEsc = true });

        if (res == true)
        {
            NapDuLieu();
            thongBao = "Đã lưu / gửi phiếu đăng ký sử dụng phương tiện thành công.";
            coLoi = false;
        }
    }

    // --- POPUP CHỈNH SỬA YÊU CẦU ---
    private async Task ChonSua(Booking item)
    {
        var clone = CloneBooking(item);
        var res = await dialog.OpenAsync<BookingEditDialog>(
            $"Chỉnh sửa yêu cầu: {item.BookingCode}",
            new Dictionary<string, object?> { { "Booking", clone }, { "IsEditing", true } },
            new DialogOptions { Width = "900px", CloseDialogOnOverlayClick = true, CloseDialogOnEsc = true });

        if (res == true)
        {
            NapDuLieu();
            thongBao = $"Đã cập nhật yêu cầu {item.BookingCode} thành công.";
            coLoi = false;
        }
    }

    private async Task XemChiTiet(Booking item)
    {
        await dialog.OpenAsync<BookingDetailDialog>(
            $"Hồ sơ yêu cầu: {item.BookingCode}",
            new Dictionary<string, object?> { { "Booking", item } },
            new DialogOptions { Width = "840px", CloseDialogOnOverlayClick = true, CloseDialogOnEsc = true });
    }

    private async Task GuiPheDuyet(Booking item)
    {
        var xacNhan = await dialog.Confirm(
            $"Đồng chí có chắc chắn muốn gửi yêu cầu {item.BookingCode} đến Lãnh đạo phê duyệt?",
            "Gửi phê duyệt yêu cầu",
            new ConfirmOptions { OkButtonText = "Gửi ngay", CancelButtonText = "Hủy" });

        if (xacNhan != true)
        {
            return;
        }

        string loi;
        bool thanhCong = bookingService.SendApproval(item.Id, out loi);

        if (!thanhCong)
        {
            thongBao = loi;
            coLoi = true;
            return;
        }

        NapDuLieu();
        thongBao = $"Đã gửi yêu cầu {item.BookingCode} đến Lãnh đạo phê duyệt thành công.";
        coLoi = false;
    }

    private async Task HuyYeuCau(Booking item)
    {
        var xacNhan = await dialog.Confirm(
            $"Đồng chí có chắc chắn muốn rút / hủy yêu cầu {item.BookingCode}?",
            "Xác nhận hủy yêu cầu",
            new ConfirmOptions { OkButtonText = "Xác nhận hủy", CancelButtonText = "Bỏ qua" });

        if (xacNhan != true)
        {
            return;
        }

        string loi;
        bool thanhCong = bookingService.Cancel(item.Id, "Cán bộ tự rút yêu cầu", out loi);

        if (!thanhCong)
        {
            thongBao = loi;
            coLoi = true;
            return;
        }

        NapDuLieu();
        thongBao = $"Đã hủy yêu cầu {item.BookingCode} thành công.";
        coLoi = false;
    }

    private void DatLaiBoLoc()
    {
        tuKhoaTimKiem = "";
        locTrangThai = -1;
    }

    private Booking TaoDonMoi()
    {
        DateTime thoiDiemKhoiHanh = DateTime.Now.AddHours(2);
        thoiDiemKhoiHanh = new DateTime(thoiDiemKhoiHanh.Year, thoiDiemKhoiHanh.Month, thoiDiemKhoiHanh.Day, thoiDiemKhoiHanh.Hour, 0, 0);

        return new Booking
        {
            WorkType = "Công tác địa bàn",
            Departure = "Trụ sở Công an",
            DepartureTime = thoiDiemKhoiHanh,
            ReturnTime = thoiDiemKhoiHanh.AddHours(5),
            PassengerCount = 2,
            RequestedVehicleType = "Ô tô",
            PreferredDriverMode = DriverMode.AssignedDriver,
            Status = BookingStatus.Draft
        };
    }

    private Booking CloneBooking(Booking item)
    {
        return new Booking
        {
            Id = item.Id,
            BookingCode = item.BookingCode,
            RequesterId = item.RequesterId,
            DepartmentId = item.DepartmentId,
            DepartmentSnapshot = item.DepartmentSnapshot,
            WorkType = item.WorkType,
            Purpose = item.Purpose,
            TaskDescription = item.TaskDescription,
            Departure = item.Departure,
            Destination = item.Destination,
            DepartureTime = item.DepartureTime,
            ReturnTime = item.ReturnTime,
            PassengerCount = item.PassengerCount,
            RequestedVehicleType = item.RequestedVehicleType,
            PreferredDriverMode = item.PreferredDriverMode,
            Status = item.Status,
            RejectionReason = item.RejectionReason,
            NeedAdjustmentReason = item.NeedAdjustmentReason,
            ApprovalOfficerId = item.ApprovalOfficerId,
            ApprovalAt = item.ApprovalAt,
            ApprovalComment = item.ApprovalComment,
            CancellationReason = item.CancellationReason,
            CreatedAt = item.CreatedAt,
            SubmittedAt = item.SubmittedAt,
            Notes = item.Notes
        };
    }

    public void Dispose()
    {
        authService.UserChanged -= CapNhatTrang;
    }
}
