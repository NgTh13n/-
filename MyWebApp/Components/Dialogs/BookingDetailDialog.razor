@using MyWebApp.Models
@using MyWebApp.Models.Enums
@using MyWebApp.Helpers
@using MyWebApp.Data
@using MyWebApp.Services

@inject BookingService bookingService
@inject MockDataService mockDataService
@inject DialogService dialog

<div class="booking-detail-dialog" tabindex="-1">
    @* THẺ THÔNG TIN TỔNG QUAN HỒ SƠ *@
    <div class="p-3 bg-light rounded-3 border mb-3">
        <div class="row g-2 align-items-center">
            <div class="col-md-3">
                <span class="text-muted small d-block">Mã hồ sơ:</span>
                <span class="badge bg-secondary fs-6">@Booking.BookingCode</span>
            </div>
            <div class="col-md-3">
                <span class="text-muted small d-block">Người đề nghị:</span>
                <strong>@bookingService.GetRequesterName(Booking.RequesterId)</strong>
            </div>
            <div class="col-md-3">
                <span class="text-muted small d-block">Đơn vị / Đội:</span>
                <span class="text-dark fw-medium">@Booking.DepartmentSnapshot</span>
            </div>
            <div class="col-md-3 text-md-end">
                <span class="text-muted small d-block mb-1">Trạng thái:</span>
                <span class="badge-status @Booking.Status.BadgeClass()">
                    @Booking.Status.Ten()
                </span>
            </div>
        </div>
    </div>

    @* NỘI DUNG NHIỆM VỤ & LỘ TRÌNH *@
    <div class="row g-3">
        <div class="col-md-7">
            <span class="text-muted small d-block">Mục đích công tác:</span>
            <div class="fw-semibold">@Booking.Purpose</div>
        </div>
        <div class="col-md-2">
            <span class="text-muted small d-block">Phân loại:</span>
            <span class="badge bg-light text-dark border">@Booking.WorkType</span>
        </div>
        <div class="col-md-3">
            <span class="text-muted small d-block">Phương án lái xe:</span>
            <span class="badge @(Booking.PreferredDriverMode == DriverMode.SelfDrive ? "bg-info text-dark" : "bg-primary")">
                <RadzenIcon Icon="@(Booking.PreferredDriverMode == DriverMode.SelfDrive ? "person" : "drive_eta")" Class="me-1 align-middle" />
                @EnumHelper.TenDriverMode(Booking.PreferredDriverMode)
            </span>
        </div>

        @if (!string.IsNullOrEmpty(Booking.TaskDescription))
        {
            <div class="col-12">
                <span class="text-muted small d-block">Nội dung nhiệm vụ cụ thể:</span>
                <div class="p-2 bg-light rounded mt-1 border text-secondary small">@Booking.TaskDescription</div>
            </div>
        }

        <div class="col-md-6">
            <span class="text-muted small d-block">Nơi xuất phát:</span>
            <div class="fw-medium"><RadzenIcon Icon="location_on" Class="text-danger me-1 small" />@Booking.Departure</div>
        </div>
        <div class="col-md-6">
            <span class="text-muted small d-block">Nơi đến / Tuyến công tác:</span>
            <div class="fw-medium"><RadzenIcon Icon="flag" Class="text-success me-1 small" />@Booking.Destination</div>
        </div>

        <div class="col-md-4">
            <span class="text-muted small d-block">Thời gian khởi hành:</span>
            <div class="small fw-semibold text-primary"><RadzenIcon Icon="schedule" Class="me-1" />@Booking.DepartureTime.ToString("dd/MM/yyyy HH:mm")</div>
        </div>
        <div class="col-md-4">
            <span class="text-muted small d-block">Thời gian trở về dự kiến:</span>
            <div class="small fw-semibold text-secondary"><RadzenIcon Icon="event_available" Class="me-1" />@Booking.ReturnTime.ToString("dd/MM/yyyy HH:mm")</div>
        </div>
        <div class="col-md-4">
            <span class="text-muted small d-block">Thành phần tham gia:</span>
            <div class="small fw-medium">@Booking.PassengerCount cán bộ (Loại xe: @Booking.RequestedVehicleType)</div>
        </div>
    </div>

    @* Ý kiến chỉ đạo của Lãnh đạo *@
    @if (Booking.Status == BookingStatus.NeedAdjustment && !string.IsNullOrEmpty(Booking.NeedAdjustmentReason))
    {
        <div class="alert alert-warning mt-3 mb-2 border-warning py-2">
            <div class="d-flex align-items-center gap-2 mb-1">
                <RadzenIcon Icon="warning" Class="text-warning" />
                <strong>Ý kiến chỉ đạo của Lãnh đạo (Yêu cầu bổ sung thông tin):</strong>
            </div>
            <div class="ps-4 small">@Booking.NeedAdjustmentReason</div>
        </div>
    }

    @if (Booking.Status == BookingStatus.Rejected && !string.IsNullOrEmpty(Booking.RejectionReason))
    {
        <div class="alert alert-danger mt-3 mb-2 border-danger py-2">
            <div class="d-flex align-items-center gap-2 mb-1">
                <RadzenIcon Icon="cancel" Class="text-danger" />
                <strong>Lý do Lãnh đạo từ chối phê duyệt:</strong>
            </div>
            <div class="ps-4 small">@Booking.RejectionReason</div>
        </div>
    }

    @if (Booking.Status == BookingStatus.Approved && !string.IsNullOrEmpty(Booking.ApprovalComment))
    {
        <div class="alert alert-info mt-3 mb-2 border-info py-2">
            <div class="d-flex align-items-center gap-2 mb-1">
                <RadzenIcon Icon="check_circle" Class="text-info" />
                <strong>Ý kiến chỉ đạo khi phê duyệt:</strong>
            </div>
            <div class="ps-4 small">@Booking.ApprovalComment</div>
        </div>
    }

    @* Audit Trail: Lịch sử chuyển tiếp trạng thái *@
    <div class="mt-3 pt-2 border-top">
        <h6 class="text-secondary small fw-bold mb-2"><RadzenIcon Icon="history" Class="me-1" /> Tiến trình xử lý (Audit Trail):</h6>
        @{
            var histories = mockDataService.StatusHistories
                .Where(h => h.EntityType == "VehicleRequest" && h.EntityId == Booking.Id)
                .OrderBy(h => h.ChangedAt)
                .ToList();
        }
        @if (histories.Count > 0)
        {
            <ul class="list-group list-group-flush small">
                @foreach (var h in histories)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-1 bg-transparent border-0">
                        <div>
                            <span class="text-muted me-2">@h.ChangedAt.ToString("dd/MM/yyyy HH:mm")</span>
                            <strong>@h.ChangedByFullName:</strong> @h.Comment
                        </div>
                        <span class="badge bg-light text-dark border">@h.ToStatus</span>
                    </li>
                }
            </ul>
        }
        else
        {
            <span class="text-muted small">Chưa có lịch sử chuyển tiếp cho yêu cầu này.</span>
        }
    </div>

    <div class="d-flex justify-content-end mt-3 pt-2 border-top">
        <button type="button" class="btn btn-secondary px-4 btn-sm" tabindex="-1" @onclick="() => dialog.Close()">Đóng</button>
    </div>
</div>

@code {
    [Parameter]
    public Booking Booking { get; set; } = new();
}
