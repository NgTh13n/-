@using MyWebApp.Models
@using MyWebApp.Models.Enums
@using MyWebApp.Helpers
@using MyWebApp.Data
@using MyWebApp.Services

@inject BookingService bookingService
@inject DialogService dialog
@inject AuthService authService

<div class="booking-edit-dialog">
    @if (!string.IsNullOrEmpty(errorMsg))
    {
        <div class="alert alert-danger py-2 mb-3 shadow-sm">
            <RadzenIcon Icon="error" Class="me-1 align-middle" /> @errorMsg
        </div>
    }

    @if (IsEditing && Booking.Status == BookingStatus.NeedAdjustment && !string.IsNullOrEmpty(Booking.NeedAdjustmentReason))
    {
        <div class="alert alert-warning mb-3 shadow-sm">
            <strong><RadzenIcon Icon="priority_high" Class="me-1" /> Lưu ý chỉ đạo của Lãnh đạo:</strong>
            <p class="mb-0 mt-1">@Booking.NeedAdjustmentReason</p>
        </div>
    }

    <EditForm Model="Booking" OnValidSubmit="XuLyLuu">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger mb-3" />

        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label fw-bold">Phân loại công tác <span class="text-danger">*</span></label>
                <InputSelect class="form-select" @bind-Value="Booking.WorkType">
                    <option value="Công tác địa bàn">Công tác địa bàn</option>
                    <option value="Tuần tra kiểm soát">Tuần tra kiểm soát</option>
                    <option value="Phối hợp phá án">Phối hợp phá án</option>
                    <option value="Áp giải đối tượng">Áp giải đối tượng</option>
                    <option value="Họp nghiệp vụ">Họp nghiệp vụ</option>
                    <option value="Đón tiếp đoàn">Đón tiếp đoàn</option>
                    <option value="Công tác đột xuất">Công tác đột xuất khác</option>
                </InputSelect>
            </div>

            <div class="col-md-3">
                <label class="form-label fw-bold">Phương án lái xe <span class="text-danger">*</span></label>
                <InputSelect class="form-select" @bind-Value="Booking.PreferredDriverMode">
                    <option value="@DriverMode.AssignedDriver">Phân công Lái xe đơn vị</option>
                    <option value="@DriverMode.SelfDrive">Cán bộ trực tiếp tự lái</option>
                </InputSelect>
            </div>

            <div class="col-md-3">
                <label class="form-label fw-bold">Loại xe đề xuất <span class="text-danger">*</span></label>
                <InputSelect class="form-select" @bind-Value="Booking.RequestedVehicleType">
                    <option value="Ô tô">Ô tô con (4 - 7 chỗ)</option>
                    <option value="Xe tải">Xe bán tải / Chuyên dụng</option>
                    <option value="Xe máy">Xe mô tô công vụ</option>
                </InputSelect>
            </div>

            <div class="col-md-3">
                <label class="form-label fw-bold">Số lượng người tham gia <span class="text-danger">*</span></label>
                <InputNumber class="form-control" @bind-Value="Booking.PassengerCount" min="1" max="50" />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold">Mục đích sử dụng phương tiện <span class="text-danger">*</span></label>
                <InputText class="form-control" @bind-Value="Booking.Purpose" placeholder="Ví dụ: Tuần tra kiểm soát địa bàn trọng điểm phức tạp ANTT..." />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold">Nội dung / Nhiệm vụ cụ thể</label>
                <InputText class="form-control" @bind-Value="Booking.TaskDescription" placeholder="Tóm tắt nhiệm vụ, số QĐ hoặc thành phần phối hợp..." />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold">Địa điểm xuất phát <span class="text-danger">*</span></label>
                <InputText class="form-control" @bind-Value="Booking.Departure" />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold">Địa điểm đến / Lộ trình <span class="text-danger">*</span></label>
                <InputText class="form-control" @bind-Value="Booking.Destination" placeholder="Ví dụ: Phường Minh Khai, TAND TP Hà Nội..." />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold">Thời gian khởi hành dự kiến <span class="text-danger">*</span></label>
                <RadzenDatePicker @bind-Value="Booking.DepartureTime" 
                                  ShowTime="true" 
                                  HoursStep="1" 
                                  MinutesStep="15" 
                                  DateFormat="dd/MM/yyyy HH:mm" 
                                  Class="w-100" />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold">Thời gian trở về dự kiến <span class="text-danger">*</span></label>
                <RadzenDatePicker @bind-Value="Booking.ReturnTime" 
                                  ShowTime="true" 
                                  HoursStep="1" 
                                  MinutesStep="15" 
                                  DateFormat="dd/MM/yyyy HH:mm" 
                                  Class="w-100" />
            </div>

            <div class="col-12 d-flex justify-content-end gap-2 pt-3 border-top mt-3">
                <RadzenButton ButtonStyle="ButtonStyle.Light" 
                              Icon="close" 
                              Text="Đóng" 
                              Click="() => dialog.Close(false)" />

                <RadzenButton ButtonType="ButtonType.Submit" 
                              Text="@(IsEditing ? "Lưu thay đổi nháp" : "Lưu bản nháp")" 
                              Icon="save" 
                              ButtonStyle="ButtonStyle.Secondary" 
                              Click="@(() => hanhDongGuiDuyet = false)" />

                <RadzenButton ButtonType="ButtonType.Submit" 
                              Text="@(IsEditing && Booking.Status == BookingStatus.NeedAdjustment ? "Bổ sung & Gửi duyệt lại" : "Gửi phê duyệt ngay")" 
                              Icon="send" 
                              ButtonStyle="ButtonStyle.Primary" 
                              Click="@(() => hanhDongGuiDuyet = true)" />
            </div>
        </div>
    </EditForm>
</div>

@code {
    [Parameter]
    public Booking Booking { get; set; } = new();

    [Parameter]
    public bool IsEditing { get; set; } = false;

    private bool hanhDongGuiDuyet = false;
    private string errorMsg = "";

    private void XuLyLuu()
    {
        string loi;
        bool thanhCong;

        if (IsEditing)
        {
            thanhCong = bookingService.Update(Booking, hanhDongGuiDuyet, out loi);
        }
        else
        {
            thanhCong = bookingService.Create(Booking, hanhDongGuiDuyet, out loi);
        }

        if (!thanhCong)
        {
            errorMsg = loi;
            return;
        }

        dialog.Close(true);
    }
}
